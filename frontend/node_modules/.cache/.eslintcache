":"187","messages":"188","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"92"},{"filePath":"189","messages":"190","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"92"},{"filePath":"191","messages":"192","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"92"},{"filePath":"193","messages":"194","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"92"},"/Users/macbook/project/alpasoft/frontend/src/index.js",[],"/Users/macbook/project/alpasoft/frontend/src/store.js",[],["195","196"],"/Users/macbook/project/alpasoft/frontend/src/App.js",["197","198","199","200","201","202"],"import Header from './components/NavigationBar'\nimport Footer from './components/Footer'\nimport { Container } from 'react-bootstrap'\n\nimport { BrowserRouter as Router, Routes, Route } from 'react-router-dom' \n\nimport LoginScreen from './screens/LoginScreen';\nimport RegisterScreen from './screens/RegisterScreen';\nimport ProfileScreen from './screens/ProfileScreen';\nimport PrivateRoute from './utils/PrivateRoute';\nimport HomeScreen from './screens/HomeScreen'\n// import BillScreen from './screens/BillScreen';\n// import UploadScreen from './screens/UploadScreen';\n// import consumptionCoefficientScreen from './screens/consumptionCoefficientScreen'\n// import demandCoefficientScreen from './screens/demandCoefficientScreen'\n// import barCoefficientScreen from './screens/barCoefficientScreen'\n// import barAverageCoefficientScreen from './screens/barAverageCoefficientScreen'\n// import barLimitCoefficientScreen from './screens/barLimitCoefficientScreen'\n// import barCompensationCoefficientScreen from './screens/barCompensationCoefficientScreen'\n// import barCompensationCoefficientActiveScreen from './screens/barCompensationCoefficientActiveScreen'\n// import MaximunDemandScreen from './screens/MaximunDemandScreen'\n// import UploadWaterScreen from './screens/UploadWaterScreen'\nimport NavigationBar from './components/NavigationBar'\nimport FormulaScreen from './screens/FormulaScreen'\nimport SunscriberScreen from './screens/SubscriberScreen';\nfunction App() {\n  return (\n    <Router>\n       <Routes>\n     \n      <Route path=\"/\" element={<LoginScreen/>} />\n            <Route path=\"/home\" element={ <><NavigationBar/><HomeScreen/></>}/> \n            <Route path=\"/subscribers\" element={ <><NavigationBar/><SunscriberScreen/></>}/>          \n         \n      <Route path=\"/formulascreen\" element={ <><NavigationBar/><FormulaScreen/></> } />\n      </Routes>\n    </Router>\n  );\n}\n\nexport default App;\n","/Users/macbook/project/alpasoft/frontend/src/reportWebVitals.js",[],"/Users/macbook/project/alpasoft/frontend/src/reducers/userReducers.js",[],"/Users/macbook/project/alpasoft/frontend/src/components/Header.js",["203","204","205","206","207"],"import React from 'react'\nimport { Navbar, Nav, Container, Row, NavDropdown ,Col} from 'react-bootstrap'\nimport { LinkContainer } from 'react-router-bootstrap'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { userLogoutAction } from '../actions/userActions'\nimport Paper from '@mui/material/Paper';\nimport Button from '@mui/material/Button';\nimport Menu from '@mui/material/Menu';\nimport MenuItem from '@mui/material/MenuItem';\nimport Fade from '@mui/material/Fade';\nimport { useHistory } from 'react-router-dom';\n\nfunction Header({ history }) {\n\n    const userLogin = useSelector(state => state.userLogin)\n    const { userInfo } = userLogin\n    const dispatch = useDispatch()\n\n    const logoutHandler = () => {\n        dispatch(userLogoutAction())\n        window.location.reload();\n\n\n    }\n    const [anchorEl, setAnchorEl] = React.useState(null);\n    const open = Boolean(anchorEl);\n    const handleClick = (event) => {\n      setAnchorEl(event.currentTarget);\n    };\n    const handleClose = () => {\n      setAnchorEl(null);\n    };\n    return (\n\n        <header >\n            \n            <Navbar  expand=\"sm\" collapseOnSelect style={{direction:'rtl', backgroundColor:'#294D61', height:60, padding:0, marginBottom:10}} >\n            <Paper sx={{ position: 'fixed',backgroundColor:'#294D61',spacing : 10,boxShadow:5,height:60, width:'100%'}} elevation={3}>\n            <Row>\n                <Col xs={6} md={6} lg={6} className='p-3'>\n                <h1>سیستم مدیریت کنترل قبوض برق آلپاسافت</h1>\n                </Col>\n                <Col xs={3} md={3} lg={3} className='p-2'>\n\n                    </Col>\n                    <Col xs={3} md={3} lg={3} className='p-3' style={{textAlign:'left'}}>\n                    <div>\n      <Button\n        id=\"fade-button\"\n        aria-controls={open ? 'fade-menu' : undefined}\n        aria-haspopup=\"true\"\n        aria-expanded={open ? 'true' : undefined}\n        onClick={handleClick}\n\n\n      >\n        <span className='titlegrid'>\n          {userInfo?\n        <b>{userInfo.name}</b>\n       :\n       null\n         } </span>\n      </Button>\n      <Menu\n        id=\"fade-menu\"\n        MenuListProps={{\n          'aria-labelledby': 'fade-button',\n        }}\n        anchorEl={anchorEl}\n        open={open}\n        onClose={handleClose}\n        TransitionComponent={Fade}\n      >\n        <MenuItem onClick={handleClose}>Profile</MenuItem>\n        <MenuItem onClick={handleClose}>My account</MenuItem>\n        <MenuItem onClick={logoutHandler}>خروج</MenuItem>\n      </Menu>\n    </div>\n                        </Col>\n                </Row>\n\n            </Paper>\n            </Navbar>\n        </header>\n    )\n}\n\nexport default Header\n",["208","209"],"/Users/macbook/project/alpasoft/frontend/src/reducers/BillReducers.js",[],"/Users/macbook/project/alpasoft/frontend/src/components/Footer.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/ProfileScreen.js",["210"],"import React, { useState, useEffect } from 'react'\nimport { Row, Col, Form, Button, Table } from 'react-bootstrap'\nimport Message from '../components/Message'\nimport Loader from '../components/Loader'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { getUserDetailsAction, updateUserProfileAction, userLogoutAction } from '../actions/userActions'\nimport { USER_UPDATE_PROFILE_RESET } from '../constants/userConstants'\n\n\nfunction ProfileScreen({ history }) {\n    const dispatch = useDispatch()\n\n    // local states\n    const [name, setName] = useState('')\n    const [email, setEmail] = useState('')\n    const [password, setPassword] = useState('')\n    const [confirmPassword, setConfirmPassword] = useState('')\n    const [message, setMessage] = useState('')\n    const [successUpdate, setSuccessUpdate] = useState('')\n\n    // handle getUserDetails\n    const userLogin = useSelector(state => state.userLogin)\n    const { userInfo } = userLogin\n\n\n    const userDetails = useSelector(state => state.userDetails)\n    const { user, error: errorUserDetails, loading: loadingUserDetails } = userDetails\n\n\n    const userUpdateProfile = useSelector(state => state.userUpdateProfile)\n    const { success, error: errorUpdateProfile, loading: loadingUpdateProfile } = userUpdateProfile\n\n\n\n\n\n    // handle loading and error\n    let loading = false\n    let error = ''\n\n    if (loadingUserDetails || loadingUpdateProfile) {\n        loading = true\n    }\n\n    if (errorUserDetails) {\n        error = errorUserDetails\n    } else if (errorUpdateProfile) {\n        error = errorUpdateProfile\n    }\n\n    const TE = \"Token is invalid or expired\"\n\n\n\n    useEffect(() => {\n        if (errorUserDetails === TE || errorUpdateProfile === TE) {\n            dispatch(userLogoutAction())\n            history.push('/login?redirect=/profile')\n        }\n        if (!userInfo) {\n            history.push('/login')\n        } else {\n            if (!user || !user.name || success) {\n                dispatch({ type: USER_UPDATE_PROFILE_RESET })\n                dispatch(getUserDetailsAction('profile'))\n            } else {\n                setEmail(user.email)\n                setName(user.name)\n            }\n        }\n    }, [history, userInfo, user, dispatch, success, errorUserDetails, errorUpdateProfile])\n\n    const submitHandler = (e) => {\n        e.preventDefault()\n        if (password !== confirmPassword) {\n            setMessage('Passwords do not match !')\n        } else {\n            dispatch(updateUserProfileAction({\n                'id': user._id,\n                'name': name,\n                'email': email,\n                'password': password\n            }))\n            setMessage('')\n            setPassword('')\n            setConfirmPassword('')\n            setSuccessUpdate('Profile successfully updated !')\n        }\n    }\n    return (\n        <Row>\n            <Col md={3}>\n                <h2>my profile</h2>\n                {\n                    loading ? <Loader />\n                        : error ? <Message variant='danger' text={error} />\n                            : message ? <Message variant='danger' text={message} />\n                                : successUpdate ? <Message variant='success' text={successUpdate} />\n                                    : <></>\n                }\n                <Form onSubmit={submitHandler}>\n                    <Form.Group controlId='name'>\n                        <Form.Label>FullName</Form.Label>\n                        <Form.Control\n                            type='text'\n                            placeholder='Enter FullName'\n                            value={name}\n                            onChange={(e) => setName(e.target.value)}\n                        ></Form.Control>\n                    </Form.Group>\n\n                    <Form.Group className='mt-4' controlId='email'>\n                        <Form.Label>Email Address</Form.Label>\n                        <Form.Control\n                            type='email'\n                            placeholder='Enter Email'\n                            value={email}\n                            onChange={(e) => setEmail(e.target.value)}\n                        ></Form.Control>\n                    </Form.Group>\n\n                    <Form.Group className='mt-4' controlId='password'>\n                        <Form.Label>Password</Form.Label>\n                        <Form.Control\n                            type='password'\n                            placeholder='Enter Password'\n                            value={password}\n                            onChange={(e) => setPassword(e.target.value)}\n                        ></Form.Control>\n                    </Form.Group>\n\n                    <Form.Group className='mt-4' controlId='confirmPassword'>\n                        <Form.Label>Confirm Password</Form.Label>\n                        <Form.Control\n                            type='password'\n                            placeholder='Enter Confirm Password'\n                            value={confirmPassword}\n                            onChange={(e) => setConfirmPassword(e.target.value)}\n                        ></Form.Control>\n                    </Form.Group>\n\n                    <Button\n                        type='submit'\n                        className='my-4 col-6'\n                        disabled={loading === true}\n                    >\n                        update\n                    </Button>\n                </Form>\n            </Col>\n           \n        </Row>\n    )\n}\n\nexport default ProfileScreen","/Users/macbook/project/alpasoft/frontend/src/screens/LoginScreen.js",["211","212","213","214"],"import React, { useState, useEffect } from 'react'\nimport { Form,  Col, Row } from 'react-bootstrap'\nimport { Link } from 'react-router-dom'\nimport { userLoginAction } from '../actions/userActions'\nimport { useDispatch, useSelector } from 'react-redux'\nimport Loader from '../components/Loader'\nimport Message from '../components/Message'\nimport Avatar from '@mui/material/Avatar';\nimport Button from '@mui/material/Button';\nimport CssBaseline from '@mui/material/CssBaseline';\nimport TextField from '@mui/material/TextField';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport Checkbox from '@mui/material/Checkbox';\nimport Grid from '@mui/material/Grid';\nimport Box from '@mui/material/Box';\nimport LockOutlinedIcon from '@mui/icons-material/LockOutlined';\nimport Typography from '@mui/material/Typography';\nimport Container from '@mui/material/Container';\nimport { createTheme, ThemeProvider } from '@mui/material/styles';\nimport { useNavigate } from 'react-router-dom';\n\nconst defaultTheme = createTheme();\n\nfunction LoginScreen({ location, history }) {\n  let navigate = useNavigate()\n\n    var redirect = '/home'\n    const tokenResult =  \"\"\n\n    const dispatch = useDispatch()\n    const userLogin = useSelector(state => state.userLogin)\n    const { error, userInfo, loading } = userLogin\n\n    const [email, setEmail] = useState('')\n    const [password, setPassword] = useState('')\n    const [activationMessage, setActivationMessage] = useState('')\n\n    const submitHandler = (e) => {\n        e.preventDefault()\n        dispatch(userLoginAction(email, password))\n    }\n\n    useEffect(() => {\n        if (userInfo) {\n          navigate(redirect)\n        } else if (!userInfo) {\n            switch (tokenResult) {\n\n                case 'success':\n                    setActivationMessage('Your account successfully activated. Now you can login')\n                    break;\n\n                case 'fail':\n                    setActivationMessage('Your activation link isn\\'t valid. Please go to register page and try again.')\n                    break;\n\n                default:\n                    setActivationMessage('')\n            }\n        }\n\n    }, [history, userInfo, redirect, tokenResult])\n\n\n    return (\n\n\n\n<ThemeProvider theme={defaultTheme}>\n{\n                loading ? <Loader />\n                    : error ? <Message variant='danger' text={error} />\n                        : tokenResult === 'success' ? <Message variant='success' text={activationMessage} />\n                            : tokenResult === 'fail' ? <Message variant='danger' text={activationMessage} />\n                                : <></>\n            }\n          \n<Container component=\"main\" maxWidth=\"xs\">\n  <CssBaseline />\n  <Box\n    sx={{\n      marginTop: 8,\n      display: 'flex',\n      flexDirection: 'column',\n      alignItems: 'center',\n    }}\n  >\n    <Avatar sx={{ m: 1, bgcolor: 'secondary.main' }}>\n      <LockOutlinedIcon />\n    </Avatar>\n    <Typography component=\"h1\" variant=\"h5\">\n      Sign in\n    </Typography>\n    <Box component=\"form\" onSubmit={submitHandler} noValidate sx={{ mt: 1 }}>\n      <TextField\n        margin=\"normal\"\n        required\n        fullWidth\n        id=\"email\"\n        label=\"Email Address\"\n        name=\"email\"\n        autoComplete=\"email\"\n \tonChange={(e) => setEmail(e.target.value)}\n        \n      />\n      <TextField\n        margin=\"normal\"\n        required\n        fullWidth\n        name=\"password\"\n        label=\"Password\"\n        type=\"password\"\n        id=\"password\"\n        autoComplete=\"current-password\"\nonChange={(e) => setPassword(e.target.value)}\n      />\n      <FormControlLabel\n        control={<Checkbox value=\"remember\" color=\"primary\" />}\n        label=\"Remember me\"\n      />\n      <Button\n        type=\"submit\"\n        fullWidth\n        variant=\"contained\"\n        sx={{ mt: 3, mb: 2 }}\n      >\n        Sign In\n      </Button>\n      <Grid container>\n        <Grid item xs>\n          <Link href=\"#\" variant=\"body2\">\n            Forgot password?\n          </Link>\n        </Grid>\n        <Grid item>\n          <Link href=\"#\" variant=\"body2\">\n            {\"Don't have an account? Sign Up\"}\n          </Link>\n        </Grid>\n      </Grid>\n    </Box>\n  </Box>\n</Container>\n</ThemeProvider>\n    )\n}\n\nexport default LoginScreen","/Users/macbook/project/alpasoft/frontend/src/screens/UploadScreen.js",["215","216","217","218"],"import React, { useState } from \"react\";  \r\nimport { read, utils, writeFile } from 'xlsx';\r\nimport { useSelector, useDispatch } from 'react-redux'\r\n\r\nimport Grid from \"@mui/material/Grid\";\r\nimport Card from \"@mui/material/Card\";\r\nimport axios from 'axios';\r\nimport { Container, Link, TextField } from \"@mui/material\";\r\nimport Button from '@mui/material/Button'; \r\nimport template from '../template.xlsx'\r\nimport InputLabel from '@mui/material/InputLabel';\r\nimport MenuItem from '@mui/material/MenuItem';\r\nimport FormControl from '@mui/material/FormControl';\r\nimport Select from '@mui/material/Select';\r\nconst HomeComponent = ({history}) => {\r\n\r\n\r\n    const [billInfo, setBillInfo] = useState([]);\r\n    const [month, setMonth] = useState('')\r\n    const [year, setYear] = useState('')\r\n    const userLogin = useSelector(state => state.userLogin)\r\n    const { userInfo } = userLogin\r\n    const handleImport = ($event) => {\r\n        const files = $event.target.files;\r\n        if (files.length) {\r\n            const file = files[0];\r\n            const reader = new FileReader();\r\n            reader.onload = (event) => {\r\n                const wb = read(event.target.result);\r\n                const sheets = wb.SheetNames;\r\n\r\n                if (sheets.length) {\r\n                    const rows = utils.sheet_to_json(wb.Sheets[sheets[0]]);\r\n                    setBillInfo(rows)\r\n\r\n                }\r\n            }\r\n            reader.readAsArrayBuffer(file);\r\n        }\r\n    }\r\n\r\n    const handleExport = () => {\r\n      sendJsonDataToBackend(billInfo);\r\n      history.push('/')\r\n\r\n    }\r\n    const sendJsonDataToBackend = async (billInfo) => {\r\n      try {\r\n        const config = {// request setting\r\n          header: {\r\n              'Content-type': 'application/json'\r\n          }\r\n      }\r\n      console.log(userInfo.id)\r\n        await axios.post('/api/v1/electbill/upload/',  { data: billInfo, month:month,year:year,state:1},config);\r\n        console.log('JSON data sent to the backend successfully.');\r\n      } catch (error) {\r\n        console.error('Error sending JSON data to the backend:', error);\r\n      }\r\n    };\r\n    const handleChangemonth = (event) => {\r\n        setMonth(event.target.value);\r\n      };\r\n      const handleChangeyear = (event) => {\r\n        setYear(event.target.value);\r\n      };\r\n    return (\r\n        <Container>\r\n          <Grid container spacing={3} style={{direction:'rtl'}}>\r\n         \r\n                <Grid item xs={12}  md={12} xl={12}>\r\n                <span className=\"linkblack\">لطفا قبل از بارگذاری فایل، فایل نمونه را دانلود و اطلاعات را در آن کپی و سپس بارگذاری نمایید.</span>  \r\n\r\n\r\n                <a\r\n                href={template}\r\n                download=\"Example-PDF-document\"\r\n                target=\"_blank\"\r\n                rel=\"noopener noreferrer\"\r\n              > <Button variant=\"outlined\"><span className=\"linkblack\">دانلود اکسل نمونه</span></Button>\r\n              </a>\r\n\r\n\r\n \r\n                <Card style={{alignItems:'right', textAlign:'right',marginTop:2, padding:4}}>\r\n                   \r\n                <span className=\"linkblack\">انتخاب فایل: </span>  \r\n                <input type=\"file\" name=\"file\" className=\"custom-file-input\" id=\"inputGroupFile\" required onChange={handleImport}\r\n                        accept=\".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel\" sx={{border:2}}/>\r\n               <br/>\r\n    \r\n     <FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\r\n     <InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب ماه</span></InputLabel>\r\n     <Select\r\n       labelId=\"demo-select-small-label\"\r\n       id=\"demo-select-small\"\r\n       value={month}\r\n       label=\"ماه\"\r\n       onChange={handleChangemonth}\r\n     >\r\n       <MenuItem value=\"\">\r\n         <em>None</em>\r\n       </MenuItem>\r\n       <MenuItem value={1}><span className='normaltxt'>فروردین</span></MenuItem>\r\n       <MenuItem value={2}><span className='normaltxt'>اردیبهشت</span></MenuItem>\r\n       <MenuItem value={3}><span className='normaltxt'>خرداد</span></MenuItem>\r\n       <MenuItem value={4}><span className='normaltxt'>تیر</span></MenuItem>\r\n       <MenuItem value={5}><span className='normaltxt'>مرداد</span></MenuItem>\r\n       <MenuItem value={6}><span className='normaltxt'>شهریور</span></MenuItem>\r\n       <MenuItem value={7}><span className='normaltxt'>مهر</span></MenuItem>\r\n       <MenuItem value={8}><span className='normaltxt'>آبان</span></MenuItem>\r\n       <MenuItem value={9}><span className='normaltxt'>آذر</span></MenuItem>\r\n       <MenuItem value={10}><span className='normaltxt'>دی</span></MenuItem>\r\n       <MenuItem value={11}><span className='normaltxt'>بهمن</span></MenuItem>\r\n       <MenuItem value={12}><span className='normaltxt'>اسفند</span></MenuItem>\r\n     </Select>\r\n   </FormControl>\r\n        \r\n      &nbsp;&nbsp;\r\n      <FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\r\n     <InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب سال</span> </InputLabel>\r\n     <Select\r\n       labelId=\"demo-select-small-label\"\r\n       id=\"demo-select-small\"\r\n       value={year}\r\n       label=\"<span className='titlegrid'>سال</span>\"\r\n       onChange={handleChangeyear}\r\n     >\r\n       <MenuItem value=\"\">\r\n         <em>None</em>\r\n       </MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1401</span></MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1402</span></MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1403</span></MenuItem>\r\n\r\n     </Select>\r\n   </FormControl>\r\n\r\n                <hr/>\r\n                <span className=\"linkblack\">در صورت تایید اطلاعات، به پایگاه داده منتقل نمایید\r\n</span>\r\n                <Button onClick={handleExport} variant=\"contained\"><span className='linkwhite'>ارسال فایل <i className=\"fa fa-download\"></i></span> \r\n                            </Button>\r\n            </Card>\r\n                </Grid>\r\n                <Grid item xs={12}  md={12} xl={12}>\r\n                <Card style={{alignItems:'center', textAlign:'center',marginTop:2}}>\r\n            <div className=\"row\">\r\n                <div className=\"col-sm-6 offset-3\">\r\n                    <table className=\"table\">\r\n                        <thead>\r\n                            <tr>\r\n\r\n                           <th scope=\"col\"><span className='titlegrid'>تعداد روز</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>پرباری</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>میان باری</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>کم باری</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>کل مصرف </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>مبلغ انرژی </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>دیماند مصرفی  </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>دیماند محاسباتی  </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>کل مصرف راکتیو   </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>مبلغ کل     </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>شماره اشتراک    </span></th>\r\n   \r\n\r\n\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody> \r\n                                {\r\n                                    billInfo.length\r\n                                    ?\r\n                                    billInfo.map((movie, index) => (\r\n                                        <tr key={index}>\r\n                                            <td><span className='normaltxt'>{movie.dayNum}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.medium}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.low}</span></td>             \r\n                                            <td><span className='normaltxt'>{movie.high}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.activeTotalConsumption}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.activeTotalAmount}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.consumptionDemand}</span></td>             \r\n                                            <td><span className='normaltxt'>{movie.calculationlDemand}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.ractiveTotalConsumption}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.totalAmount}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.subscribeNum}</span></td>\r\n                                        </tr> \r\n                                    ))\r\n                                    :\r\n                                    <tr>\r\n                                        <td colSpan=\"5\" className=\"text-center\"><span className=\"normaltxt\">در حال حاظر قبضی بارگذاری نشده است</span></td>\r\n                                    </tr> \r\n                                }\r\n                        </tbody>\r\n                    </table>\r\n                </div>\r\n                </div>\r\n                </Card>\r\n                </Grid>\r\n                </Grid>\r\n            </Container>\r\n\r\n    );\r\n};\r\n\r\nexport default HomeComponent;\r\n",["219","220"],"/Users/macbook/project/alpasoft/frontend/src/screens/BillScreen.js",["221","222","223","224","225","226","227","228","229","230","231","232","233","234","235","236","237"],"import React, { useState, useEffect } from 'react'\r\nimport { useDispatch, useSelector } from 'react-redux'\r\nimport { Link } from 'react-router-dom'\r\nimport { Row, Col, Image, ListGroup, Button, Form,Container } from 'react-bootstrap'\r\nimport { fetchbillDetails } from '../actions/billActions'\r\nimport Loader from '../components/Loader'\r\nimport Message from '../components/Message'\r\nimport Chart from '../components/Chart';\r\nimport ReactSpeedometer from \"react-d3-speedometer\";\r\nimport Card from '@mui/material/Card';\r\nimport { styled } from '@mui/material/styles';\r\nimport Box from '@mui/material/Box';\r\nimport Paper from '@mui/material/Paper';\r\nimport Grid from '@mui/material/Grid';\r\n\r\nconst Item = styled(Paper)(({ theme }) => ({\r\n  backgroundColor: theme.palette.mode === 'dark' ? '#1A2027' : '#fff',\r\n  ...theme.typography.body2,\r\n  padding: theme.spacing(1),\r\n  textAlign: 'center',\r\n  color: theme.palette.text.secondary,\r\n}));\r\n\r\nfunction BillScreen({ match, history }) {\r\n    const dispatch = useDispatch()\r\n    const [consumptionCoefficientvalue, setconsumptionCoefficientvalue] = React.useState('');\r\n    const BillDetails = useSelector(state => state.BillDetails)\r\n    const { error, loading, bill } = BillDetails\r\n    const consumptionCoefficient=bill.consumptionDemand/bill.calculationlDemand\r\n    const demandCoefficient=((bill.calculationlDemand*10)/9)/bill.consumptionDemand\r\n    const barCoefficient=(bill.activeTotalConsumption/(bill.dayNum*24))/bill.consumptionDemand\r\n    const resultconsumptionCoefficient=(consumptionCoefficient/0.6)*200\r\n    const resultdemandCoefficient=900\r\n\r\n     \r\n    useEffect(() => {\r\n        dispatch(fetchbillDetails(match.params.id))\r\n    }, [dispatch, match])\r\n\r\n\r\n\r\n    return (\r\n          \r\n          <Box sx={{ flexGrow: 1, margin:3 }}>\r\n      \r\n            <h4>{bill.name}</h4>\r\n            <span className='normaltxt'> از تاریخ : {bill.start_date} تا تاریخ: {bill.end_date}</span>\r\n        <hr/>\r\n        <Grid container spacing={1}>\r\n\r\n        <Grid item xs={4} md={4}>\r\n          <Item>\r\n          <span className='titlegrid'>  ضریب مصرف :{consumptionCoefficient.toFixed(3)}</span>\r\n          <ReactSpeedometer\r\n        width={350}\r\n        needleHeightRatio={0.7}\r\n        value={resultconsumptionCoefficient}\r\n        currentValueText=\"ضریب مصرف\"\r\n        customSegmentLabels={[\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'قابل قبول',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n        ]}\r\n        segmentColors={['#bf616a', '#ebcb8b', '#a3be8c','#ebcb8b', '#bf616a']}\r\n        ringWidth={47}\r\n        needleTransitionDuration={3333}\r\n        needleTransition=\"easeElastic\"\r\n        needleColor={'#90f2ff'}\r\n        textColor={'#d8dee9'}\r\n      />\r\n          </Item>\r\n        </Grid>\r\n        <Grid item xs={4} md={4}>\r\n          <Item>\r\n          <span className='titlegrid'> ضریب دیماند :{demandCoefficient.toFixed(3)}</span> \r\n          <ReactSpeedometer\r\n        width={350}\r\n        needleHeightRatio={0.7}\r\n        value={resultdemandCoefficient}\r\n        currentValueText=\"ضریب دیماند\"\r\n        customSegmentLabels={[\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'قابل قبول',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n        ]}\r\n        segmentColors={['tomato', '#ffe400', 'green','#ffe400', 'tomato']}\r\n        ringWidth={47}\r\n        needleTransitionDuration={3333}\r\n        needleTransition=\"easeElastic\"\r\n        needleColor={'#90f2ff'}\r\n        textColor={'#d8dee9'}\r\n      />\r\n          </Item>\r\n        </Grid>\r\n        <Grid item xs={4} md={4}>\r\n          <Item>\r\n          <span className='titlegrid'> ضریب بار :{barCoefficient.toFixed(3)}</span>\r\n          <ReactSpeedometer\r\n        width={350}\r\n        needleHeightRatio={0.7}\r\n        value={barCoefficient}\r\n        currentValueText=\"ضریب بار\"\r\n        customSegmentLabels={[\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'قابل قبول',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n        ]}\r\n        segmentColors={['tomato', '#ffe400', 'green','#ffe400', 'tomato']}\r\n        ringWidth={47}\r\n        needleTransitionDuration={3333}\r\n        needleTransition=\"easeElastic\"\r\n        needleColor={'#90f2ff'}\r\n        textColor={'#d8dee9'}\r\n      />\r\n          </Item>\r\n        </Grid>\r\n      </Grid>\r\n    </Box>\r\n\r\n    )\r\n}\r\n\r\nexport default BillScreen\r\n","/Users/macbook/project/alpasoft/frontend/src/utils/PrivateRoute.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/RegisterScreen.js",["238"],"import React, { useState, useEffect } from 'react'\nimport { Form, Col, Row, Button } from 'react-bootstrap'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { userRegisterAction } from '../actions/userActions'\nimport { Link } from 'react-router-dom'\nimport Message from '../components/Message'\nimport Loader from '../components/Loader'\n\n \nfunction RegisterScreen({ location, history }) {\n\n    // redirect path\n    const redirect = location.search ? location.search.split('=')[1] : '/'\n    // local states\n    const [name, setName] = useState('')\n    const [email, setEmail] = useState('')\n    const [password, setPassword] = useState('')\n    const [confirmPassword, setConfirmPassword] = useState('')\n    const [message, setMessage] = useState('')\n    const [emailMessage, setEmailMessage] = useState('')\n\n    // handle registe user\n    const dispatch = useDispatch()\n    const userRegister = useSelector(state => state.userRegister)\n    const { userInfo, error, loading } = userRegister\n    const submitHandler = (e) => {\n        e.preventDefault()\n        if (password != confirmPassword) {\n            setMessage('Password and confirm password do not match !')\n        } else {\n            dispatch(userRegisterAction(name, email, password))\n            setName('')\n            setEmail('')\n            setPassword('')\n            setConfirmPassword('')\n            setMessage('')\n        }\n    }\n\n    useEffect(() => {\n        if (userInfo && userInfo.detail) {\n            setEmailMessage(userInfo.detail)\n        }\n    }, [history, redirect, userInfo])\n\n    return (\n        <>\n            <h1>sign up</h1>\n            {\n                loading ? <Loader />\n                    : error ? <Message variant='danger' text={error} />\n                        : emailMessage ? <Message variant='warning' text={emailMessage} />\n                            : message ? <Message variant='danger' text={message} />\n                                : <></>\n            }\n            <Form onSubmit={submitHandler}>\n                <Form.Group controlId='name'>\n                    <Form.Label>FullName</Form.Label>\n                    <Form.Control\n                        type='text'\n                        placeholder='Enter FullName'\n                        value={name}\n                        onChange={(e) => setName(e.target.value)}\n                    ></Form.Control>\n                </Form.Group>\n\n                <Form.Group className='mt-4' controlId='email'>\n                    <Form.Label>Email Address</Form.Label>\n                    <Form.Control\n                        type='email'\n                        placeholder='Enter Email'\n                        value={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                    ></Form.Control>\n                </Form.Group>\n\n                <Form.Group className='mt-4' controlId='password'>\n                    <Form.Label>Password</Form.Label>\n                    <Form.Control\n                        type='password'\n                        placeholder='Enter Password'\n                        value={password}\n                        onChange={(e) => setPassword(e.target.value)}\n                    ></Form.Control>\n                </Form.Group>\n\n                <Form.Group className='mt-4' controlId='confirmPassword'>\n                    <Form.Label>Confirm Password</Form.Label>\n                    <Form.Control\n                        type='password'\n                        placeholder='Enter Confirm Password'\n                        value={confirmPassword}\n                        onChange={(e) => setConfirmPassword(e.target.value)}\n                    ></Form.Control>\n                </Form.Group>\n\n                <Button\n                    type='submit'\n                    className='my-4 col-4'\n                >\n                    register\n                </Button>\n            </Form>\n\n            <Row className=\"my-4\">\n                <Col>\n                    Have an Account ?\n\n                    <Link to={redirect ? `/login?redirect=${redirect}` : `/login`}>\n                        Login\n                    </Link>\n                </Col>\n            </Row>\n        </>\n    )\n}\n\nexport default RegisterScreen","/Users/macbook/project/alpasoft/frontend/src/screens/HomeScreen.js",["239","240","241","242","243","244","245","246","247","248","249","250"],"import React, { useState, useEffect } from 'react'\nimport { useDispatch, useSelector } from 'react-redux';\nimport { styled, createTheme, ThemeProvider } from '@mui/material/styles';\nimport MuiDrawer from '@mui/material/Drawer';\nimport Box from '@mui/material/Box';\nimport MuiAppBar from '@mui/material/AppBar';\nimport Toolbar from '@mui/material/Toolbar';\nimport List from '@mui/material/List';\nimport Typography from '@mui/material/Typography';\nimport Divider from '@mui/material/Divider';\nimport IconButton from '@mui/material/IconButton';\nimport Container from '@mui/material/Container';\nimport Grid from '@mui/material/Grid';\nimport Paper from '@mui/material/Paper';\nimport { Link } from 'react-router-dom'\nimport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\nimport { mainListItems  } from '../components/listItems';\nimport Chart from '../components/Chart';\nimport Orders from '../components/Orders';\n\n\nfunction Copyright(props) {\n  return (\n    <Typography variant=\"body2\" color=\"text.secondary\" align=\"center\" {...props}>\n      {'Copyright © '}\n      <Link color=\"inherit\" href=\"https://mui.com/\">\n        Your Website\n      </Link>{' '}\n      {new Date().getFullYear()}\n      {'.'}\n    </Typography>\n  );\n}\n\nconst drawerWidth = 300;\n\nconst AppBar = styled(MuiAppBar, {\n  shouldForwardProp: (prop) => prop !== 'open',\n})(({ theme, open }) => ({\n  zIndex: theme.zIndex.drawer + 1,\n  transition: theme.transitions.create(['width', 'margin'], {\n    easing: theme.transitions.easing.sharp,\n    duration: theme.transitions.duration.leavingScreen,\n  }),\n  ...(open && {\n    marginLeft: drawerWidth,\n    width: `calc(100% - ${drawerWidth}px)`,\n    transition: theme.transitions.create(['width', 'margin'], {\n      easing: theme.transitions.easing.sharp,\n      duration: theme.transitions.duration.enteringScreen,\n    }),\n  }),\n}));\n\nconst Drawer = styled(MuiDrawer, { shouldForwardProp: (prop) => prop !== 'open' })(\n  ({ theme, open }) => ({\n    '& .MuiDrawer-paper': {\n      position: 'relative',\n      whiteSpace: 'nowrap',\n      width: drawerWidth,\n      transition: theme.transitions.create('width', {\n        easing: theme.transitions.easing.sharp,\n        duration: theme.transitions.duration.enteringScreen,\n      }),\n      boxSizing: 'border-box',\n      ...(!open && {\n        overflowX: 'hidden',\n        transition: theme.transitions.create('width', {\n          easing: theme.transitions.easing.sharp,\n          duration: theme.transitions.duration.leavingScreen,\n        }),\n        width: theme.spacing(7),\n        [theme.breakpoints.up('sm')]: {\n          width: theme.spacing(9),\n        },\n      }),\n    },\n  }),\n);\n\n// TODO remove, this demo shouldn't need to reset the theme.\nconst defaultTheme = createTheme();\n\nexport default function HomeScreen({history}) {\n    const dispatch = useDispatch()\n\n\n\n    const userLogin = useSelector(state => state.userLogin)\n    const { userInfo } = userLogin\n \n    useEffect(() => {\n        if (!userInfo) {\n          history.push('/login')\n        }\n    \n    }, [history, userInfo,dispatch])\n    const [open, setOpen] = React.useState(true);\n  const toggleDrawer = () => {\n    setOpen(!open);\n  };\n\n  return (\n    <ThemeProvider theme={defaultTheme}>\n\n\n      <Box sx={{ display: 'flex' }}>\n   \n    \n          <Container maxWidth=\"lg\" sx={{ mt: 4, mb: 4 }}>\n            <Grid container spacing={2}>\n              {/* Chart */}\n              <Grid item xs={12} md={12} lg={12}>\n                <Paper\n                  sx={{\n                    p: 2,\n                    display: 'flex',\n                    flexDirection: 'column',\n                    height: 350,\n                  }}\n                >\n                  <Chart />\n\n                </Paper>\n              </Grid>\n              {/* Recent Deposits */}\n            \n              {/* Recent Orders */}\n              <Grid item xs={12} md={12} lg={12}>\n                <Paper sx={{ p: 2, display: 'flex', flexDirection: 'column' }}>\n                </Paper>\n              </Grid>\n            </Grid>\n          </Container>\n      </Box>\n    </ThemeProvider>\n  );\n}","/Users/macbook/project/alpasoft/frontend/src/components/Loader.js",[],"/Users/macbook/project/alpasoft/frontend/src/components/Chart.js",["251","252"],"import React from 'react';\nimport ReactSpeedometer from \"react-d3-speedometer\";\nimport { Row, Col, Container } from 'react-bootstrap'\nimport { BarPlot,BarChart  } from '@mui/x-charts/BarChart';\nimport { LinePlot } from '@mui/x-charts/LineChart';\nimport { ChartContainer } from '@mui/x-charts/ChartContainer';\n\nimport { ChartsXAxis } from '@mui/x-charts/ChartsXAxis';\nimport { ChartsYAxis } from '@mui/x-charts/ChartsYAxis';\n\nconst series = [\n  {\n    type: 'bar',\n    stack: '',\n    yAxisKey: 'eco',\n    data: [2, 5, 3, 4, 1],\n  },\n  {\n    type: 'bar',\n    stack: '',\n    yAxisKey: 'eco',\n    data: [5, 6, 2, 8, 9],\n  },\n  {\n    type: 'line',\n    yAxisKey: 'pib',\n    color: 'red',\n    data: [1000, 1500, 3000, 5000, 10000],\n  },\n];\nconst GaugeChart = () => {\n   \n        const textColor = '#AAA'\n\n        return (\n            <Container>\n          <Row\n     \n        >\n          <Col style={{textAlign:'center',alignItems:'center'}} xs={6} sm={6} md={6} lg={6} xl={6}>\n          <ChartContainer\n      series={series}\n      width={500}\n      height={300}\n      xAxis={[\n        {\n          id: 'years',\n          data: [2010, 2011, 2012, 2013, 2014],\n          scaleType: 'band',\n          valueFormatter: (value) => value.toString(),\n        },\n      ]}\n      yAxis={[\n        {\n          id: 'eco',\n          scaleType: 'linear',\n        },\n        {\n          id: 'pib',\n          scaleType: 'log',\n        },\n      ]}\n    >\n      <BarPlot />\n      <LinePlot />\n      <ChartsXAxis label=\"Years\" position=\"bottom\" axisId=\"years\" />\n      <ChartsYAxis label=\"Results\" position=\"left\" axisId=\"eco\" />\n      <ChartsYAxis label=\"PIB\" position=\"right\" axisId=\"pib\" />\n    </ChartContainer>\n          </Col>\n          \n          \n          <Col  style={{textAlign:'center',alignItems:'center'}}  xs={6} sm={6} md={6} lg={6} xl={6}>\n          <BarChart\n      xAxis={[{ scaleType: 'band', data: ['group A', 'group B', 'group C'] }]}\n      series={[{ data: [4, 3, 5] }, { data: [1, 6, 3] }, { data: [2, 5, 6] }]}\n      width={500}\n      height={300}\n    />\n        </Col>\n        </Row></Container>\n        );\n};\n\nexport default GaugeChart;","/Users/macbook/project/alpasoft/frontend/src/components/Message.js",[],"/Users/macbook/project/alpasoft/frontend/src/components/listItems.js",["253","254","255","256","257"],"import * as React from 'react';\nimport ListItemButton from '@mui/material/ListItemButton';\nimport ListItemIcon from '@mui/material/ListItemIcon';\nimport ListItemText from '@mui/material/ListItemText';\nimport ListSubheader from '@mui/material/ListSubheader';\nimport DashboardIcon from '@mui/icons-material/Dashboard';\nimport ShoppingCartIcon from '@mui/icons-material/ShoppingCart';\nimport PeopleIcon from '@mui/icons-material/People';\nimport BarChartIcon from '@mui/icons-material/BarChart';\nimport LayersIcon from '@mui/icons-material/Layers';\nimport AssignmentIcon from '@mui/icons-material/Assignment';\nimport { Button } from 'react-bootstrap';\nimport { Link } from 'react-router-dom'\nimport Box from '@mui/material/Box';\n\nexport const mainListItems = (\n  <Box sx={{boxShadow:4, backgroundColor:'#0C7075', borderRadius:5}} >\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <DashboardIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/\"> داشبورد</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <PeopleIcon /> \n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/upload\"> بارگذاری قبوض</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <PeopleIcon /> \n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/uploadwater\"> تولید آب </Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <BarChartIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/consumptionCoefficient\">ضریب مصرف</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/demandCoefficient\">ضریب دیماند</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <PeopleIcon /> \n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/barCoefficient\"> ضریب بار</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <BarChartIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/baraverageCoefficient\">  ضریب بار متوسط</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/barLimitCoefficient\"> ضریب بار حدی</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <PeopleIcon /> \n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/barCompensationCoefficient\"> ضریب جبران بار راکتیو</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <BarChartIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/barCompensationCoefficientActive\"> ضریب جبران بار راکتیو فعال</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> ساعت کارکرد دیماند ماکزیمم</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> درصد استفاده در پیک بار</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> درصد استفاده در میان باری </Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> درصد استفاده در کم باری </Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> سهم هزینه برق مصرفی</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> سهم هزینه انرژی مصرفی</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> میانگین هزینه برق</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> میانگین هزینه انرژی</Link>\n    </ListItemButton>\n  </Box>\n);\n\n","/Users/macbook/project/alpasoft/frontend/src/constants/BillConstatns.js",[],"/Users/macbook/project/alpasoft/frontend/src/constants/userConstants.js",[],"/Users/macbook/project/alpasoft/frontend/src/actions/billActions.js",[],"/Users/macbook/project/alpasoft/frontend/src/actions/userActions.js",[],"/Users/macbook/project/alpasoft/frontend/src/utils/axiosInstance.js",[],"/Users/macbook/project/alpasoft/frontend/src/components/Orders.js",["258","259","260","261","262"],"import React, { useState, useEffect } from 'react'\nimport { useDispatch, useSelector } from 'react-redux';\nimport { Link } from 'react-router-dom'\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport Title from './Title';\nimport { fetchbills } from '../actions/billActions'\n\n// Generate Order Data\nfunction createData(id, date, name, shipTo, paymentMethod, amount) {\n  return { id, date, name, shipTo, paymentMethod, amount };\n}\n\nconst rows = [\n  createData(\n    0,\n    '16 Mar, 2019',\n    'Elvis Presley',\n    'Tupelo, MS',\n    'VISA ⠀•••• 3719',\n    312.44,\n  ),\n  createData(\n    1,\n    '16 Mar, 2019',\n    'Paul McCartney',\n    'London, UK',\n    'VISA ⠀•••• 2574',\n    866.99,\n  ),\n  createData(2, '16 Mar, 2019', 'Tom Scholz', 'Boston, MA', 'MC ⠀•••• 1253', 100.81),\n  createData(\n    3,\n    '16 Mar, 2019',\n    'Michael Jackson',\n    'Gary, IN',\n    'AMEX ⠀•••• 2000',\n    654.39,\n  ),\n  createData(\n    4,\n    '15 Mar, 2019',\n    'Bruce Springsteen',\n    'Long Branch, NJ',\n    'VISA ⠀•••• 5919',\n    212.79,\n  ),\n];\n\nfunction preventDefault(event) {\n  event.preventDefault();\n}\n\nexport default function Orders({history}) {\n  const dispatch = useDispatch()\n\n  const listBills = useSelector(state => state.listBill)\n  const { error, loading, bills } = listBills\n\n  const userLogin = useSelector(state => state.userLogin)\n  const { userInfo } = userLogin\n  useEffect(() => {\n    dispatch(fetchbills())\n\n}, [ dispatch])\n  return (\n    <React.Fragment>\n      <Title><h4>آخرین قبوض</h4></Title>\n      <Table   size=\"small\">\n        <TableHead  style={{textAlign:'right'}}>\n          <TableRow className='titlegrid'>\n            <TableCell ><span className='titlegrid'>نام مشترک</span></TableCell>\n            <TableCell><span className='titlegrid'>تعداد روز</span></TableCell>\n            <TableCell><span className='titlegrid'>پرباری</span></TableCell>\n            <TableCell><span className='titlegrid'>میان باری</span></TableCell>\n            <TableCell><span className='titlegrid'>کم باری</span></TableCell>\n            <TableCell><span className='titlegrid'>دیماند مصرفی  </span></TableCell>\n            <TableCell><span className='titlegrid'>دیماند محاسباتی  </span></TableCell>\n            <TableCell><span className='titlegrid'>مبلغ کل     </span></TableCell>\n            <TableCell><span className='titlegrid'>رمز رایانه   </span></TableCell>\n\n\n          </TableRow>\n        </TableHead>\n        <TableBody>\n          {bills?.map((row) => (\n            <TableRow key={row._id}>\n              <TableCell><Link to={`/bill/${row._id}`}><span className='normaltxt'>{row.name}</span></Link></TableCell>\n              <TableCell><span className='normaltxt'>{row.dayNum}</span></TableCell>\n              <TableCell><span className='normaltxt'>{row.medium}</span></TableCell>\n              <TableCell><span className='normaltxt'>{row.low}</span></TableCell>             \n              <TableCell><span className='normaltxt'>{row.high}</span></TableCell>\n              <TableCell><span className='normaltxt'>{row.consumptionDemand}</span></TableCell>             \n              <TableCell><span className='normaltxt'>{row.calculationlDemand}</span></TableCell>\n              <TableCell><span className='normaltxt'>{row.totalAmount}</span></TableCell>\n              <TableCell><span className='normaltxt'>{row.passCom}</span></TableCell>\n            </TableRow>\n          ))}\n        </TableBody>\n      </Table>\n      <Link color=\"primary\" href=\"#\" onClick={preventDefault} sx={{ mt: 3 }}>\n       نمایش بیشتر\n      </Link>\n    </React.Fragment>\n  );\n}\n","/Users/macbook/project/alpasoft/frontend/src/components/Title.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/UploadWaterScreen.js",["263","264","265","266"],"import React, { useState } from \"react\";  \r\nimport { read, utils, writeFile } from 'xlsx';\r\nimport { useSelector, useDispatch } from 'react-redux'\r\n\r\nimport Grid from \"@mui/material/Grid\";\r\nimport Card from \"@mui/material/Card\";\r\nimport axios from 'axios';\r\nimport { Container, Link, TextField } from \"@mui/material\";\r\nimport Button from '@mui/material/Button'; \r\nimport template from '../templatewater.xlsx'\r\nimport InputLabel from '@mui/material/InputLabel';\r\nimport MenuItem from '@mui/material/MenuItem';\r\nimport FormControl from '@mui/material/FormControl';\r\nimport Select from '@mui/material/Select';\r\nconst HomeComponent = ({history}) => {\r\n    const [billInfo, setBillInfo] = useState([]);\r\n    const [month, setMonth] = useState('')\r\n    const [year, setYear] = useState('')\r\n    const userLogin = useSelector(state => state.userLogin)\r\n    const { userInfo } = userLogin\r\n    const handleImport = ($event) => {\r\n        const files = $event.target.files;\r\n        if (files.length) {\r\n            const file = files[0];\r\n            const reader = new FileReader();\r\n            reader.onload = (event) => {\r\n                const wb = read(event.target.result);\r\n                const sheets = wb.SheetNames;\r\n\r\n                if (sheets.length) {\r\n                    const rows = utils.sheet_to_json(wb.Sheets[sheets[0]]);\r\n                    setBillInfo(rows)\r\n\r\n                }\r\n            }\r\n            reader.readAsArrayBuffer(file);\r\n        }\r\n    }\r\n\r\n    const handleExport = () => {\r\n      sendJsonDataToBackend(billInfo);\r\n      history.push('/')\r\n\r\n    }\r\n    const sendJsonDataToBackend = async (billInfo) => {\r\n      try {\r\n        const config = {// request setting\r\n          header: {\r\n              'Content-type': 'application/json'\r\n          }\r\n      }\r\n      console.log(userInfo.id)\r\n        await axios.post('/api/v1/waterbill/upload/',  { data: billInfo, month:month,year:year,state:1},config);\r\n        console.log('JSON data sent to the backend successfully.');\r\n      } catch (error) {\r\n        console.error('Error sending JSON data to the backend:', error);\r\n      }\r\n    };\r\n    const handleChangemonth = (event) => {\r\n        setMonth(event.target.value);\r\n      };\r\n      const handleChangeyear = (event) => {\r\n        setYear(event.target.value);\r\n      };\r\n    return (\r\n        <Container>\r\n          <Grid container spacing={3} style={{direction:'rtl'}}>\r\n         \r\n                <Grid item xs={12}  md={12} xl={12}>\r\n                <span className=\"linkblack\">لطفا قبل از بارگذاری فایل، فایل نمونه را دانلود و اطلاعات را در آن کپی و سپس بارگذاری نمایید.</span>  \r\n\r\n                <a\r\n  href={template}\r\n  download=\"Example-PDF-document\"\r\n  target=\"_blank\"\r\n  rel=\"noopener noreferrer\"\r\n>\r\n  <Button variant=\"outlined\"><span className=\"linkblack\">دانلود اکسل نمونه</span></Button>\r\n</a>\r\n                <Card style={{alignItems:'right', textAlign:'right',marginTop:2, padding:4}}>\r\n                   \r\n                <span className=\"linkblack\">انتخاب فایل: </span>  \r\n                <input type=\"file\" name=\"file\" className=\"custom-file-input\" id=\"inputGroupFile\" required onChange={handleImport}\r\n                        accept=\".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel\" sx={{border:2}}/>\r\n               <br/>\r\n    \r\n     <FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\r\n     <InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب ماه</span></InputLabel>\r\n     <Select\r\n       labelId=\"demo-select-small-label\"\r\n       id=\"demo-select-small\"\r\n       value={month}\r\n       label=\"ماه\"\r\n       onChange={handleChangemonth}\r\n     >\r\n       <MenuItem value=\"\">\r\n         <em>None</em>\r\n       </MenuItem>\r\n       <MenuItem value={1}><span className='normaltxt'>فروردین</span></MenuItem>\r\n       <MenuItem value={2}><span className='normaltxt'>اردیبهشت</span></MenuItem>\r\n       <MenuItem value={3}><span className='normaltxt'>خرداد</span></MenuItem>\r\n       <MenuItem value={4}><span className='normaltxt'>تیر</span></MenuItem>\r\n       <MenuItem value={5}><span className='normaltxt'>مرداد</span></MenuItem>\r\n       <MenuItem value={6}><span className='normaltxt'>شهریور</span></MenuItem>\r\n       <MenuItem value={7}><span className='normaltxt'>مهر</span></MenuItem>\r\n       <MenuItem value={8}><span className='normaltxt'>آبان</span></MenuItem>\r\n       <MenuItem value={9}><span className='normaltxt'>آذر</span></MenuItem>\r\n       <MenuItem value={10}><span className='normaltxt'>دی</span></MenuItem>\r\n       <MenuItem value={11}><span className='normaltxt'>بهمن</span></MenuItem>\r\n       <MenuItem value={12}><span className='normaltxt'>اسفند</span></MenuItem>\r\n     </Select>\r\n   </FormControl>\r\n        \r\n      &nbsp;&nbsp;\r\n      <FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\r\n     <InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب سال</span> </InputLabel>\r\n     <Select\r\n       labelId=\"demo-select-small-label\"\r\n       id=\"demo-select-small\"\r\n       value={year}\r\n       label=\"<span className='titlegrid'>سال</span>\"\r\n       onChange={handleChangeyear}\r\n     >\r\n       <MenuItem value=\"\">\r\n         <em>None</em>\r\n       </MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1401</span></MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1402</span></MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1403</span></MenuItem>\r\n\r\n     </Select>\r\n   </FormControl>\r\n\r\n                <hr/>\r\n                <span className=\"linkblack\">در صورت تایید اطلاعات، به پایگاه داده منتقل نمایید\r\n</span>\r\n                <Button onClick={handleExport} variant=\"contained\"><span className='linkwhite'>ارسال فایل <i className=\"fa fa-download\"></i></span> \r\n                            </Button>\r\n            </Card>\r\n                </Grid>\r\n                <Grid item xs={12}  md={12} xl={12}>\r\n                <Card style={{alignItems:'center', textAlign:'center',marginTop:2}}>\r\n            <div className=\"row\">\r\n                <div className=\"col-lg-12 offset-3\">\r\n                    <table className=\"table\">\r\n                        <thead>\r\n                            <tr>\r\n                            <th scope=\"col\"><span className='titlegrid'>ردیف </span></th>\r\n\r\n                           <th scope=\"col\"><span className='titlegrid'>نام مشترک</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>جمع تولید آب</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>جمع ساعت</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>شماره اشتراک    </span></th>\r\n   \r\n\r\n\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody> \r\n                                {\r\n                                    billInfo.length\r\n                                    ?\r\n                                    billInfo.map((movie, index) => (\r\n                                        <tr key={index}>\r\n                                            <th scope=\"row\">{ index + 1 }</th>\r\n                                            <td><span className='normaltxt'>{movie.name}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.totalProduction}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.totalHours}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.passCom}</span></td>\r\n                                        </tr> \r\n                                    ))\r\n                                    :\r\n                                    <tr>\r\n                                        <td colSpan=\"5\" className=\"text-center\"><span className=\"normaltxt\">در حال حاظر قبضی بارگذاری نشده است</span></td>\r\n                                    </tr> \r\n                                }\r\n                        </tbody>\r\n                    </table>\r\n                </div>\r\n                </div>\r\n                </Card>\r\n                </Grid>\r\n                </Grid>\r\n            </Container>\r\n\r\n    );\r\n};\r\n\r\nexport default HomeComponent;\r\n","/Users/macbook/project/alpasoft/frontend/src/components/NavigationBar.js",["267","268","269","270"],"import { useState, useEffect } from 'react'\nimport React from 'react'\nimport { Navbar, Nav, Container, Row, NavDropdown, Col } from 'react-bootstrap'\nimport { LinkContainer } from 'react-router-bootstrap'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { userLogoutAction } from '../actions/userActions'\nimport { NavLink, Button } from 'react-bootstrap';\nimport { useNavigate } from 'react-router-dom'\nimport UploadElectBill from './UploadElectBill'\n\nfunction NavigationBar(props) {\n    let navigate = useNavigate()\n\n    const userLogin = useSelector(state => state.userLogin)\n    const { userInfo } = userLogin\n    const dispatch = useDispatch()\n\n    const logoutHandler = () => {\n        dispatch(userLogoutAction())\n        navigate(\"/\")\n\n\n    }\n    const [showuploadelectbillmodal, setShowuploadelectbillmodal] = useState(false);\n    const uploadelectbillhandle =()=>{\n        setShowuploadelectbillmodal(true)\n    }\n\n    return (\n        <>\n            <Navbar bg=\"dark\" variant=\"light\" data-bs-theme=\"dark\" style={{ direction: 'rtl', height: \"60px\", }}>\n                <Container fluid>\n                    <Nav className=\"ml-auto\">\n                        <LinkContainer to=\"/\" style={{ marginLeft: '50px' }}>\n                            <Navbar.Brand className=\"nav-item\">\n                                <h1 className='py-2'>سیستم مدیریت کنترل قبوض آلپاسافت\n                                   ( {userInfo ? userInfo.name : null}) \n                                </h1>\n                            </Navbar.Brand>\n                        </LinkContainer>\n\n                        <LinkContainer to=\"/subscribers\" style={{borderLeft:'1px solid white'}}>\n                            <NavLink className='navlink'>مشترکین</NavLink>\n                        </LinkContainer>\n                        <LinkContainer to=\"/formulascreen\" style={{borderLeft:'1px solid white'}}>\n                            <NavLink className='navlink'>شاخص های عملکرد انرژی</NavLink>\n                        </LinkContainer>\n                        <NavDropdown style={{borderLeft:'1px solid white'}}\n                            title={<span className='navlink'>بارگذاری قبوض</span>}\n\n                        >\n                            <NavDropdown.Item >\n                                <NavLink className='navitem' onClick={uploadelectbillhandle}>قبض برق</NavLink>\n                            </NavDropdown.Item>\n                            <NavDropdown.Item>\n                                <NavLink className='navitem'>قبض آب</NavLink>\n                            </NavDropdown.Item>\n                        </NavDropdown>\n\n                    </Nav>\n\n                    <Nav >\n                        {userInfo &&\n                            <>\n                                <NavDropdown style={{ paddingLeft: '60px' }}\n                                    className='navlink'\n                                    title={<span className='navlink'>تنظیمات </span>}\n\n                                >\n                                    <NavDropdown.Item>\n                                        <NavLink onClick={logoutHandler} className='navitem'>خروج</NavLink>\n                                    </NavDropdown.Item>\n                                </NavDropdown>\n                            </>\n                        }\n\n                        {!userInfo &&\n                            <LinkContainer to=\"/login\">\n                                <NavLink>Login</NavLink>\n                            </LinkContainer>\n                        }\n                    </Nav>\n                </Container>\n            </Navbar>\n            {showuploadelectbillmodal &&\n                <UploadElectBill showuploadelectbillmodal={showuploadelectbillmodal} setShowuploadelectbillmodal={setShowuploadelectbillmodal} />\n            }\n        </>\n    )\n\n}\n\nexport default NavigationBar;\n","/Users/macbook/project/alpasoft/frontend/src/screens/FormulaScreen.js",["271","272","273","274","275"],"import Nav from 'react-bootstrap/Nav';\nimport Tab from 'react-bootstrap/Tab';\nimport { Row, Col, Image, ListGroup, Button, Container } from 'react-bootstrap'\nimport Form from 'react-bootstrap/Form';\nimport { useEffect, useState } from 'react';\nimport axios from 'axios'\nimport ConsumptionCoefficient from './ConsumptionCoefficient'\nimport DemandCoefficient from './DemandCoefficient';\nimport BarAverageCoefficient from './BarAverageCoefficient';\nimport BarCoefficient from './BarCoefficient';\nimport BarLimitCoefficient from './BarLimitCoefficient';\nimport BarCompensationCoefficient from './BarCompensationCoefficient'; \nimport BarCompensationCoefficientActive from './BarCompensationCoefficientActive';\nimport MaximunDemand from './MaximunDemand';\nimport UseInPeakLoad from './UseInPeakLoad';\nimport UseInMediumLoad from './UseInMediumLoad';\nimport UseInLowLoad from './UseInLowLoad';\nexport default function FormulaScreen(props) {\n  const [dataList, setDataList] = useState([]);\n  const [far, setFar] = useState(false);\n  const [ord, setOrd] = useState(true);\n  const [kho, setKho] = useState(false);\n  const [tir, setTir] = useState(false);\n  const [mor, setMor] = useState(false);\n  const [sha, setSha] = useState(false);\n  const [meh, setMeh] = useState(false);\n  const [aba, setAba] = useState(false);\n  const [aza, setAza] = useState(false);\n  const [dey, setDey] = useState(false);\n  const [bah, setBah] = useState(false);\n  const [esf, setEsf] = useState(false);\n\n  const [year01, setYear01] = useState(false);\n  const [year02, setYear02] = useState(false);\n  const [year03, setYear03] = useState(false);\n  useEffect(() => {\n    axios.get('/api/v1/electbill/').then(res => {\n      console.log(res)\n      setDataList(res['data'])\n      console.log(dataList[0])\n    })\n\n  }, [])\n  return (\n    <Container style={{maxWidth:'90%'}}>\n      <div style={{ direction: 'rtl', marginTop: '50px' }}>\n\n\n\n        <Tab.Container id=\"left-tabs-example\" defaultActiveKey=\"consumptioncoefficient\">\n\n          <Row>\n            <Col sm={3}>\n              <Nav className=\"nav-links flex-column\" style={{ maxWidth: '300px' }}>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"consumptioncoefficient\" className=\"nav-links\">ضریب مصرف</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"demandcoefficient\" className=\"nav-links\">ضریب دیماند</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"barcoefficient\" className=\"nav-links\">ضریب بار</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"baraveragecoefficient\" className=\"nav-links\">ضریب بار متوسط</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"barlimitcoefficient\" className=\"nav-links\">ضریب بار حدی</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"barcompensationcoefficient\" className=\"nav-links\">ضریب جبران بار اکتیو</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"barcompensationcoefficientactive\" className=\"nav-links\">ضریب جبران باراکتیو فعال</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"maximundemand\" className=\"nav-links\"> کارکرد دیماند ماکزیمم </Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"useinpeakload\" className=\"nav-links\"> درصد استفاده در پیک بار</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"useinmediumload\" className=\"nav-links\"> درصد استفاده در میان باری</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"useinlowload\" className=\"nav-links\"> درصد استفاده در کم باری</Nav.Link>\n                </Nav.Item>\n              </Nav>\n              <div style={{ maxWidth: '110px', paddingRight: '30px', direction: 'ltr' }} className=\"mb-3\">\n                <Form.Check  label={<span className='text'>فروردین</span>} inline type=\"checkbox\" onChange={() => setFar(!far)} />\n                <Form.Check label={<span className='text'>اردیبهشت</span>} inline type=\"checkbox\" onChange={() => setOrd(!ord)} />\n                <Form.Check label={<span className='text'>خرداد</span>} inline type=\"checkbox\" onChange={() => setKho(!kho)} />\n                <Form.Check  label={<span className='text'>تیر</span>} inline type=\"checkbox\" onChange={() => setTir(!tir)} />\n                <Form.Check label={<span className='text'>مرداد</span>} inline type=\"checkbox\" onChange={() => setMor(!mor)} />\n                <Form.Check label={<span className='text'>شهریور</span>} inline type=\"checkbox\" onChange={() => setSha(!sha)} />\n                <Form.Check  label={<span className='text'>مهر</span>} inline type=\"checkbox\" onChange={() => setMeh(!meh)} />\n                <Form.Check label={<span className='text'>آبان</span>} inline type=\"checkbox\" onChange={() => setAba(!aba)} />\n                <Form.Check label={<span className='text'>آذر</span>} inline type=\"checkbox\" onChange={() => setAza(!aza)} />\n                <Form.Check  label={<span className='text'>دی</span>} inline type=\"checkbox\" onChange={() => setDey(!dey)} />\n                <Form.Check label={<span className='text'>بهمن</span>} inline type=\"checkbox\" onChange={() => setBah(!bah)} />\n                <Form.Check label={<span className='text'>اسفند</span>} inline type=\"checkbox\" onChange={() => setEsf(!esf)} />\n                <hr />\n                <Form.Check label={<span className='text'>1401</span>} inline type=\"checkbox\" onChange={() => setYear01(!year01)} />\n                <Form.Check label={<span className='text'>1402</span>} inline type=\"checkbox\" onChange={() => setYear03(!year02)} />\n                <Form.Check label={<span className='text'>1403</span>} inline type=\"checkbox\" onChange={() => setYear03(!year03)} />\n\n\n              </div>\n            </Col>\n            <Col sm={9}>\n              <Tab.Content>\n                <Tab.Pane eventKey=\"consumptioncoefficient\">\n                  <ConsumptionCoefficient BillList={dataList} />\n                </Tab.Pane>\n\n                <Tab.Pane eventKey=\"demandcoefficient\">\n                  <DemandCoefficient BillList={dataList} />\n                </Tab.Pane>\n\n                <Tab.Pane eventKey=\"barcoefficient\">\n                  <BarCoefficient BillList={dataList} />\n                </Tab.Pane>\n\n                <Tab.Pane eventKey=\"baraveragecoefficient\">\n                  <BarAverageCoefficient BillList={dataList} />\n                </Tab.Pane>\n\n                <Tab.Pane eventKey=\"barlimitcoefficient\">\n                  <BarLimitCoefficient BillList={dataList} />\n                </Tab.Pane>\n\n              <Tab.Pane eventKey=\"barcompensationcoefficient\">\n                  <BarCompensationCoefficient BillList={dataList} />\n                </Tab.Pane>\n\n              <Tab.Pane eventKey=\"barcompensationcoefficientactive\">\n                  <BarCompensationCoefficientActive BillList={dataList} />\n                </Tab.Pane>\n\n                <Tab.Pane eventKey=\"maximundemand\">\n                  <MaximunDemand BillList={dataList} />\n                </Tab.Pane>\n\n                <Tab.Pane eventKey=\"useinpeakload\">\n                  <UseInPeakLoad BillList={dataList} />\n                </Tab.Pane>\n\n                <Tab.Pane eventKey=\"useinmediumload\">\n                  <UseInMediumLoad BillList={dataList} />\n                </Tab.Pane>\n\n                <Tab.Pane eventKey=\"useinlowload\">\n                  <UseInLowLoad BillList={dataList} />\n                </Tab.Pane>\n                \n              </Tab.Content>\n            </Col>\n          </Row>\n        </Tab.Container>\n      </div></Container>\n  )\n}","/Users/macbook/project/alpasoft/frontend/src/screens/ConsumptionCoefficient.js",["276"],"\r\nimport React, { useEffect, useState } from \"react\";\r\nimport Form from 'react-bootstrap/Form';\r\nimport Button from 'react-bootstrap/Button';\r\nimport ChartData from '../components/ChartData'\r\nimport Row from 'react-bootstrap/Row';\r\nimport Col from 'react-bootstrap/Col';\r\nimport Table from 'react-bootstrap/Table';\r\nimport { Container } from \"react-bootstrap\";\r\n\r\nimport { Chart as ChartJS, ArcElement, Tooltip, Legend } from 'chart.js';\r\nimport { Doughnut } from 'react-chartjs-2';\r\nChartJS.register(ArcElement, Tooltip, Legend);\r\n\r\nexport const data = {\r\n    labels: ['بزرگتر از 1.6', 'از 1 تا 1.6', 'از 0.99 تا 1'],\r\n    datasets: [\r\n        {\r\n            label: '# of Votes',\r\n            data: [12, 19, 3],\r\n            backgroundColor: [\r\n                'rgba(255, 99, 132, 0.2)',\r\n                'rgba(255, 206, 86, 0.2)',\r\n                'rgba(75, 192, 192, 0.2)',\r\n\r\n            ],\r\n            borderColor: [\r\n                'rgba(255, 99, 132, 1)',\r\n                'rgba(255, 206, 86, 1)',\r\n                'rgba(75, 192, 192, 1)',\r\n\r\n            ],\r\n            borderWidth: 1,\r\n        },\r\n    ],\r\n};\r\nexport default function ComsumptionCoefficient(props) {\r\n    const BillList = props.BillList\r\n    console.log(BillList)\r\n\r\n\r\n    const [selectedNames, setSelectedNames] = useState([]);\r\n    const [average, setAverage] = useState(0);\r\n\r\n    const [totalValue, setTotalValue] = useState(0);\r\n    const [sohwmodalchart, setShowmodalchart] = useState(false)\r\n    const handleCheckboxChange = (name, value) => {\r\n        setSelectedNames((prevSelectedNames) =>\r\n            prevSelectedNames.includes(name)\r\n                ? prevSelectedNames.filter((n) => n !== name)\r\n                : [...prevSelectedNames, name]\r\n        );\r\n        setTotalValue((prevTotal) =>\r\n            selectedNames.includes(name) ? prevTotal - Number(value) : prevTotal + value\r\n        );\r\n    };\r\n\r\n    const averageValue =\r\n        selectedNames.length > 0 ? totalValue / selectedNames.length : 0;\r\n    const HandleComparison = () => {\r\n        setShowmodalchart(true)\r\n\r\n    }\r\n    useEffect(() => {\r\n        let consumption = BillList.reduce((acc, item) => acc + (item.consumptionDemand / BillList.length), 0).toFixed(2)\r\n\r\n        let calculation = BillList.reduce((acc, item) => acc + (item.calculationlDemand / BillList.length), 0).toFixed(2)\r\n        setAverage(consumption / calculation)\r\n\r\n    }, [BillList])\r\n    return (\r\n        <Container >\r\n            <Row className=\"m-2\" >\r\n                <Col xs={6} sm={6} md={6} lg={6} xl={6}  >\r\n                    <h2>ضریب مصرف</h2>\r\n                    <p className=\"text\">ضریب مصرف = قدرت مصرفی / قدرت دیماند محاسباتی</p>\r\n\r\n                </Col>\r\n                <Col xs={6} sm={6} md={6} lg={6} xl={6} style={{ textAlign: 'left', alignItems: 'left' }}>\r\n                    <Doughnut style={{ maxHeight: '300px', maxWidth: '300px', fontSize: '15px' }} className=\"text\" data={data} />\r\n\r\n\r\n                </Col>\r\n            </Row>\r\n            <hr />\r\n            <Row className=\"mx-5\">\r\n                <Col xs={4} sm={4} md={4} lg={4} xl={4}>\r\n\r\n                </Col>\r\n\r\n                <Col xs={4} sm={4} md={4} lg={4} xl={4} style={{ textAlign: 'left' }}>\r\n                    <Button size=\"sm\" variant=\"outline-primary\" onClick={HandleComparison}><span className=\"text\">مقایسه</span></Button>\r\n                </Col>\r\n                <Col xs={4} sm={4} md={4} lg={4} xl={4}>\r\n                    <Form.Control size=\"sm\" type=\"email\" placeholder=\"جستجو\" />\r\n                </Col>\r\n                <Col xs={12} sm={12} md={12} lg={12} xl={12}>\r\n                    <Table responsive=\"md\" style={{ margin: '0' }}>\r\n                        <thead>\r\n                            <tr>\r\n                                <th>#</th>\r\n                                <th className='text'>انتخاب</th>\r\n                                <th className='text'>نام مشترک</th>\r\n                                <th className='text'>قدرت مصرفی</th>\r\n                                <th className='text'>قدرت دیماند محاسبه</th>\r\n                                <th className='text'>ضریب مصرف</th>\r\n\r\n\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody>\r\n                            {BillList?.map((item, idx) =>\r\n                                <tr>\r\n\r\n                                    <td className='text'>{idx + 1}</td>\r\n                                    <td>\r\n                                        <input\r\n                                            type=\"checkbox\"\r\n                                            checked={selectedNames.includes(item.subscriber.name)}\r\n                                            onChange={() => handleCheckboxChange(item.subscriber.name, Number((item.calculationlDemand / item.consumptionDemand).toFixed(2)))}\r\n                                        />\r\n                                    </td>\r\n                                    <td className='text'>{item.subscriber.name}</td>\r\n                                    <td className='text'>{item.consumptionDemand}</td>\r\n                                    <td className='text'>{item.calculationlDemand}</td>\r\n                                    <td className='text'>{(item.consumptionDemand / item.calculationlDemand).toFixed(2)}</td>\r\n\r\n\r\n                                </tr>\r\n                            )}\r\n                        </tbody>\r\n                    </Table>\r\n                    {totalValue}{averageValue}\r\n\r\n                </Col>\r\n            </Row>\r\n\r\n\r\n            {sohwmodalchart &&\r\n                <ChartData sohwmodalchart={sohwmodalchart} setShowmodalchart={setShowmodalchart} averageValue={averageValue} />\r\n            }\r\n        </Container>\r\n    )\r\n}\r\n\r\n","/Users/macbook/project/alpasoft/frontend/src/screens/DemandCoefficient.js",[],"/Users/macbook/project/alpasoft/frontend/src/components/UploadElectBill.js",["277","278","279","280","281"],"import Modal from 'react-bootstrap/Modal';\nimport { Button } from 'react-bootstrap';\nimport { read, utils, writeFile } from 'xlsx';\nimport { useSelector, useDispatch } from 'react-redux'\nimport React, { useState } from \"react\";  \n\nimport Grid from \"@mui/material/Grid\";\nimport Card from \"@mui/material/Card\";\nimport axios from 'axios';\nimport { Container, Link, TextField } from \"@mui/material\";\nimport template from '../template.xlsx'\nimport InputLabel from '@mui/material/InputLabel';\nimport MenuItem from '@mui/material/MenuItem';\nimport FormControl from '@mui/material/FormControl';\nimport Select from '@mui/material/Select';\nexport default function UploadElectBill(props){\n    const showuploadelectbillmodal=props.showuploadelectbillmodal\n    const setShowuploadelectbillmodal=props.setShowuploadelectbillmodal\n    const handleClose=()=>{\n        setShowuploadelectbillmodal(false)\n    }\n    const [billInfo, setBillInfo] = useState([]);\n    const [month, setMonth] = useState('')\n    const [year, setYear] = useState('')\n    const userLogin = useSelector(state => state.userLogin)\n    const { userInfo } = userLogin\n    const handleImport = ($event) => {\n        const files = $event.target.files;\n        if (files.length) {\n            const file = files[0];\n            const reader = new FileReader();\n            reader.onload = (event) => {\n                const wb = read(event.target.result);\n                const sheets = wb.SheetNames;\n\n                if (sheets.length) {\n                    const rows = utils.sheet_to_json(wb.Sheets[sheets[0]]);\n                    setBillInfo(rows)\n\n                }\n            }\n            reader.readAsArrayBuffer(file);\n        }\n    }\n\n    const handleExport = () => {\n      sendJsonDataToBackend(billInfo);\n      setShowuploadelectbillmodal(false)\n\n    }\n    const sendJsonDataToBackend = async (billInfo) => {\n      try {\n        const config = {// request setting\n          header: {\n              'Content-type': 'application/json'\n          }\n      }\n      console.log(userInfo.id)\n        await axios.post('/api/v1/electbill/upload/',  { data: billInfo, month:month,year:year,state:1},config);\n        console.log('JSON data sent to the backend successfully.');\n      } catch (error) {\n        console.error('Error sending JSON data to the backend:', error);\n      }\n    };\n    const handleChangemonth = (event) => {\n        setMonth(event.target.value);\n      };\n      const handleChangeyear = (event) => {\n        setYear(event.target.value);\n      };\n    return(\n\n    <Modal size=\"lg\" show={showuploadelectbillmodal} onHide={e => setShowuploadelectbillmodal(false)}>\n    <Modal.Header closeButton>\n      <Modal.Title><span className='text'>آپلود قبض برق</span></Modal.Title>\n    </Modal.Header>\n    <Modal.Body>\n    <Grid container spacing={3} style={{direction:'rtl'}}>\n         \n         <Grid item xs={12}  md={12} xl={12}>\n         <span className=\"linkblack\">لطفا قبل از بارگذاری فایل، فایل نمونه را دانلود و اطلاعات را در آن کپی و سپس بارگذاری نمایید.</span>  \n\n\n         <a\n         href={template}\n         download=\"Example-PDF-document\"\n         target=\"_blank\"\n         rel=\"noopener noreferrer\"\n       > <Button variant=\"outlined\"><span className=\"linkblack\">دانلود اکسل نمونه</span></Button>\n       </a>\n\n\n\n         <Card style={{alignItems:'right', textAlign:'right',marginTop:2, padding:4}}>\n            \n         <span className=\"linkblack\">انتخاب فایل: </span>  \n         <input type=\"file\" name=\"file\" className=\"custom-file-input\" id=\"inputGroupFile\" required onChange={handleImport}\n                 accept=\".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel\" sx={{border:2}}/>\n        <br/>\n\n<FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\n<InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب ماه</span></InputLabel>\n<Select\nlabelId=\"demo-select-small-label\"\nid=\"demo-select-small\"\nvalue={month}\nlabel=\"ماه\"\nonChange={handleChangemonth}\n>\n<MenuItem value=\"\">\n  <em>None</em>\n</MenuItem>\n<MenuItem value={1}><span className='normaltxt'>فروردین</span></MenuItem>\n<MenuItem value={2}><span className='normaltxt'>اردیبهشت</span></MenuItem>\n<MenuItem value={3}><span className='normaltxt'>خرداد</span></MenuItem>\n<MenuItem value={4}><span className='normaltxt'>تیر</span></MenuItem>\n<MenuItem value={5}><span className='normaltxt'>مرداد</span></MenuItem>\n<MenuItem value={6}><span className='normaltxt'>شهریور</span></MenuItem>\n<MenuItem value={7}><span className='normaltxt'>مهر</span></MenuItem>\n<MenuItem value={8}><span className='normaltxt'>آبان</span></MenuItem>\n<MenuItem value={9}><span className='normaltxt'>آذر</span></MenuItem>\n<MenuItem value={10}><span className='normaltxt'>دی</span></MenuItem>\n<MenuItem value={11}><span className='normaltxt'>بهمن</span></MenuItem>\n<MenuItem value={12}><span className='normaltxt'>اسفند</span></MenuItem>\n</Select>\n</FormControl>\n \n&nbsp;&nbsp;\n<FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\n<InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب سال</span> </InputLabel>\n<Select\nlabelId=\"demo-select-small-label\"\nid=\"demo-select-small\"\nvalue={year}\nlabel=\"<span className='titlegrid'>سال</span>\"\nonChange={handleChangeyear}\n>\n<MenuItem value=\"\">\n  <em>None</em>\n</MenuItem>\n<MenuItem value={1401}><span className='normaltxt'>1401</span></MenuItem>\n<MenuItem value={1401}><span className='normaltxt'>1402</span></MenuItem>\n<MenuItem value={1401}><span className='normaltxt'>1403</span></MenuItem>\n\n</Select>\n</FormControl>\n\n         <hr/>\n         <span className=\"linkblack\">در صورت تایید اطلاعات، به پایگاه داده منتقل نمایید\n</span>\n         <Button onClick={handleExport} variant=\"contained\"><span className='linkwhite'>ارسال فایل <i className=\"fa fa-download\"></i></span> \n                     </Button>\n     </Card>\n         </Grid>\n\n         </Grid>\n    </Modal.Body>\n    <Modal.Footer>\n      <Button variant=\"secondary\" onClick={handleClose}>\n        <span className='text'>بستن</span>\n      </Button>\n      <Button variant=\"primary\"  onClick={handleExport}>\n       <span className='text'>آپلود</span>\n      </Button>\n    </Modal.Footer>\n  </Modal>\n    )\n}","/Users/macbook/project/alpasoft/frontend/src/components/ChartData.js",["282","283","284","285","286","287","288","289"],"import Modal from 'react-bootstrap/Modal';\nimport { Button } from 'react-bootstrap';\nimport { read, utils, writeFile } from 'xlsx';\nimport { useSelector, useDispatch } from 'react-redux'\nimport React, { useState } from \"react\";  \nimport GaugeChart from 'react-gauge-chart'\n\nimport { Chart as ChartJS, ArcElement, Tooltip, Legend } from 'chart.js';\nimport { Doughnut } from 'react-chartjs-2';\nChartJS.register(ArcElement, Tooltip, Legend);\n\nexport const data = {\n    labels: ['Red', 'Blue', 'Yellow', 'Green', 'Purple', 'Orange'],\n    datasets: [\n      {\n        label: '# of Votes',\n        data: [12, 19, 3, 5, 2, 3],\n        backgroundColor: [\n          'rgba(255, 99, 132, 0.2)',\n          'rgba(54, 162, 235, 0.2)',\n          'rgba(255, 206, 86, 0.2)',\n          'rgba(75, 192, 192, 0.2)',\n          'rgba(153, 102, 255, 0.2)',\n          'rgba(255, 159, 64, 0.2)',\n        ],\n        borderColor: [\n          'rgba(255, 99, 132, 1)',\n          'rgba(54, 162, 235, 1)',\n          'rgba(255, 206, 86, 1)',\n          'rgba(75, 192, 192, 1)',\n          'rgba(153, 102, 255, 1)',\n          'rgba(255, 159, 64, 1)',\n        ],\n        borderWidth: 1,\n      },\n    ],\n  };\n\nexport default function ChartData(props){\n    const sohwmodalchart=props.sohwmodalchart\n    const setShowmodalchart=props.setShowmodalchart\n    const averageValue=props.averageValue\n    const handleClose=()=>{\n        setShowmodalchart(false)\n    }\n    return(   \n \n    <Modal  show={sohwmodalchart} onHide={e => setShowmodalchart(false)}>\n    <Modal.Header closeButton>\n      <Modal.Title><span className='text'> ضریب مصرف </span></Modal.Title>\n    </Modal.Header>\n    <Modal.Body>\n        <div style={{backgroundColor:'#000'}}>\n    <GaugeChart id=\"gauge-chart4\" \n    \n  nrOfLevels={10} \n  arcPadding={0.1} \n  cornerRadius={3} \n  percent={0.6} \n/>\n</div>\n\n    </Modal.Body>\n    <Modal.Footer>\n      <Button variant=\"secondary\" onClick={handleClose}>\n        <span className='text'>بستن</span>\n      </Button>\n  \n    </Modal.Footer>\n  </Modal>\n    )\n}","/Users/macbook/project/alpasoft/frontend/src/screens/SubscriberScreen.js",["290","291"],"import React from \"react\";\nimport axios from \"axios\";\nimport { useEffect, useState } from 'react';\nimport { useSelector, useDispatch } from 'react-redux'\nimport { Container } from \"react-bootstrap\";\nimport Row from 'react-bootstrap/Row';\nimport Col from 'react-bootstrap/Col';\nimport Table from 'react-bootstrap/Table';\nexport default function SunscriberScreen() {\n    const userLogin = useSelector(state => state.userLogin)\n    const { userInfo } = userLogin\n    const [dataList, setDataList] = useState([]);\n\n    useEffect(() => {\n        try{\n            const config = {\n                header: {\n                    'Content-type': 'application/json'\n                }\n            }\n            if (userInfo){\n            const state=1\n            console.log(userInfo)\n            axios.post('/api/v1/subscribers/',  { state:state},config).then(res => {\n                console.log(res)\n                setDataList(res['data'])\n                console.log(dataList[0])\n              })\n            \n            }\n        } catch (error) {\n        console.error('Error sending JSON data to the backend:', error);\n        }\n    }, [])\n    \n    return(\n\n        <Container style={{direction:'rtl'}}>\n            <Row>\n            <Col xs={12} sm={12} md={12} lg={12} xl={12}>\n                    <Table responsive=\"md\">\n                        <thead>\n                            <tr>\n                                <th>#</th>\n                                <th className='text'>انتخاب</th>\n                                <th className='text'>شماره اشتراک </th>\n                                <th className='text'>شهر  </th>\n\n\n                            </tr>\n                        </thead>\n                        <tbody>\n                            {dataList?.map((item, idx) =>\n                                <tr>\n\n                                    <td className='text'>{idx + 1}</td>\n   \n                                    <td className='text'>{item.name}</td>\n                                    <td className='text'>{item.subscribeNum}</td>\n                                    <td className='text'></td>\n\n\n                                </tr>\n                            )}\n                        </tbody>\n                    </Table>\n                    </Col>\n            </Row>\n        </Container>\n\n\n    )}\n","/Users/macbook/project/alpasoft/frontend/src/screens/BarAverageCoefficient.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/BarCoefficient.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/BarLimitCoefficient.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/BarCompensationCoefficient.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/BarCompensationCoefficientActive.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/MaximunDemand.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/UseInPeakLoad.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/UseInMediumLoad.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/UseInLowLoad.js",[],{"ruleId":"292","replacedBy":"293"},{"ruleId":"294","replaced