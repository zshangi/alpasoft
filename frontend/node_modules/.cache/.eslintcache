 overflowX: 'hidden',\r\n        transition: theme.transitions.create('width', {\r\n          easing: theme.transitions.easing.sharp,\r\n          duration: theme.transitions.duration.leavingScreen,\r\n        }),\r\n        width: theme.spacing(7),\r\n        [theme.breakpoints.up('sm')]: {\r\n          width: theme.spacing(9),\r\n        },\r\n      }),\r\n    },\r\n  }),\r\n);\r\n\r\nconst StyledTableRow = styled(TableRow)(({ theme }) => ({\r\n  '&:nth-of-type(odd)': {\r\n    backgroundColor: theme.palette.action.hover,\r\n  },\r\n  // hide last border\r\n  '&:last-child td, &:last-child th': {\r\n    border: 0,\r\n  },\r\n}));\r\nconst Item = styled(Paper)(({ theme }) => ({\r\n  backgroundColor: theme.palette.mode === 'dark' ? '#1A2027' : '#fff',\r\n  ...theme.typography.body2,\r\n  padding: theme.spacing(1),\r\n  textAlign: 'center',\r\n  color: theme.palette.text.secondary,\r\n}));\r\nconst data = [\r\n  { name: 'Group A', value: 400 },\r\n  { name: 'Group B', value: 40 },\r\n  { name: 'Group C', value: 300 },\r\n];\r\n\r\nconst COLORS = [ '#00C49F', '#FFBB28', '#FF8042'];\r\n\r\nconst RADIAN = Math.PI / 180;\r\nconst renderCustomizedLabel = ({ cx, cy, midAngle, innerRadius, outerRadius, percent, index }) => {\r\n  const radius = innerRadius + (outerRadius - innerRadius) * 0.5;\r\n  const x = cx + radius * Math.cos(-midAngle * RADIAN);\r\n  const y = cy + radius * Math.sin(-midAngle * RADIAN);\r\n\r\n  return (\r\n    <text x={x} y={y} fill=\"white\" textAnchor={x > cx ? 'start' : 'end'} dominantBaseline=\"central\">\r\n      {`${(percent * 100).toFixed(0)}%`}\r\n    </text>\r\n  );\r\n};\r\n\r\nconst style = {\r\n  top: '50%',\r\n  right: 0,\r\n  transform: 'translate(0, -50%)',\r\n  lineHeight: '14px',\r\n};\r\nfunction BillScreen({ match, history }) {\r\n  const [open, setOpen] = React.useState(true);\r\n  const toggleDrawer = () => {\r\n    setOpen(!open);\r\n  };\r\n  const dispatch = useDispatch()\r\n\r\n  const listBills = useSelector(state => state.listBill)\r\n  const { error, loading, bills } = listBills\r\n  let prebill=[]\r\n\r\n  const [far, setFar] =  React.useState(false);\r\n  const [ord, setOrd] = React.useState(true);\r\n  const [kho, setKho] = React.useState(false);\r\n  const [tir, setTir] = React.useState(false);\r\n  const [mor, setMor] = React.useState(false);\r\n  const [sha, setSha] = React.useState(false);\r\n  const [meh, setMeh] = React.useState(false);\r\n  const [aba, setAba] = React.useState(false);\r\n  const [aza, setAza] = React.useState(false);\r\n  const [dey, setDey] = React.useState(false);\r\n  const [bah, setBah] = React.useState(false);\r\n  const [esf, setEsf] = React.useState(false);\r\n\r\n  const [year01, setYear01] = React.useState(false);\r\n  const [year02, setYear02] = React.useState(false);\r\n  const [year03, setYear03] = React.useState(false);\r\n\r\n  prebill = bills?.filter((bill) => ((far? bill.month==1 : null) || (ord? bill.month==2 : null)  || (kho? bill.month==3 : null)  || (tir? bill.month==4 : null) || (mor? bill.month==5 : null)|| (sha? bill.month==6 : null)|| (meh? bill.month==7 : null)|| (aba? bill.month==8 : null)|| (aza? bill.month==9 : null)|| (dey? bill.month==10 : null) || (bah? bill.month==11 : null) || (esf? bill.month==12 : null) || (year01? bill.year==1401 : null) || (year02? bill.year==1402 : null) || (year03? bill.year==1403 : null)   ))\r\n\r\n  useEffect(() => {\r\n    dispatch(fetchbills())\r\n\r\n  }, [dispatch,far,ord,year01])\r\n\r\n\r\n  const defaultTheme = createTheme();\r\n\r\n  return (\r\n      <ThemeProvider theme={defaultTheme}>\r\n\r\n\r\n<Box sx={{ display: 'flex' }}>\r\n\r\n   <Drawer variant=\"permanent\" open={open}>\r\n     <Toolbar\r\n       sx={{\r\n         display: 'flex',\r\n         alignItems: 'center',\r\n         justifyContent: 'flex-end',\r\n         backgroundColor:'#0C7075',\r\n         px: [1],\r\n       }}\r\n     >\r\n       <IconButton  onClick={toggleDrawer}>\r\n       <span className='linkwhite'>استان  </span>  <ChevronLeftIcon />\r\n       </IconButton>\r\n     </Toolbar>\r\n     <Divider />\r\n     <List component=\"nav\">\r\n       {mainListItems}\r\n       <Divider sx={{ my: 1 }} />\r\n     </List>\r\n   </Drawer>\r\n   <Container maxWidth=\"lg\" sx={{ mt: 4, mb: 4 }}>\r\n\r\n    <Box sx={{backgroundColor:'#fff',boxShadow:5,height:350, width:'100%',padding:1,borderRadius:5}}>\r\n\r\n <Row >\r\n        <Col  xs={8} md={8}>\r\n          <item>\r\n            <h1>ضریب بار حدی</h1>\r\n            <span className='normaltxt'>فرمول: (مصرف کل/تعداد روز*24)/ قدرت قراردادی</span>\r\n\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>فروردین</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setFar(!far)}\r\n\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"2\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اردیبهشت</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setOrd(!ord)}\r\n                />\r\n                <FormControlLabel\r\n                  value=\"3\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>خرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setKho(!kho)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>تیر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setTir(!tir)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMor(!mor)}\r\n                />    \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>شهریور</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setSha(!sha)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مهر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMeh(!meh)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آبان</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAba(!aba)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آذر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAza(!aza)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>دی</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setDey(!dey)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>بهمن</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setBah(!bah)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اسفند</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setEsf(!esf)}\r\n                />       \r\n              </FormGroup>\r\n            </FormControl>\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1401\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1401</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear01(!year01)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1402\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1402</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear02(!year02)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1403\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1403</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear03(!year03)}\r\n\r\n                />\r\n              </FormGroup>\r\n            </FormControl>\r\n            <br />\r\n            <br />\r\n            <br />\r\n            <br />\r\n\r\n          </item>\r\n        </Col>\r\n        <Col item xs={4} md={4} >\r\n       \r\n          <ResponsiveContainer width=\"100%\" height=\"100%\">\r\n        <PieChart width={400} height={400}>\r\n          <Pie\r\n            data={data}\r\n            cx=\"50%\"\r\n            cy=\"50%\"\r\n            labelLine={false}\r\n            label={renderCustomizedLabel}\r\n            outerRadius={120}\r\n            fill=\"#8884d8\"\r\n            dataKey=\"value\"\r\n          >\r\n            {data.map((entry, index) => (\r\n              <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />\r\n            ))}\r\n          </Pie>\r\n        </PieChart>\r\n      </ResponsiveContainer>\r\n\r\n        </Col>\r\n        \r\n\r\n      </Row>\r\n</Box>\r\n<br/>\r\n<Box sx={{backgroundColor:'#fff' ,width:'100%',padding:1, textAlign:'center',right:0,left:0,alignItems:'center', alignContent:'center'}}>\r\n\r\n      <TableContainer style={{ width: 1000, margin: 'auto', borderRadius:15 }}  >\r\n              <Table sx={{ maxWidth: '100%'}} aria-label=\"customized table\">\r\n                <TableHead >\r\n                  <TableRow >\r\n                    <StyledTableCell style={{backgroundColor:'#0C7075'}}><span className='titlegrid'>نام مشترک</span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>قدرت قراردادی</span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>مصرف کل   </span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>ضریب بار حدی </span></StyledTableCell>\r\n\r\n\r\n\r\n\r\n                  </TableRow>\r\n                </TableHead>\r\n                <TableBody style={{ textAlign: 'right' }}>\r\n                  {prebill?.map((row) => (\r\n                    <StyledTableRow key={row._id}>\r\n                      <StyledTableCell style={{ textAlign: 'right' }}><span className='normaltxt'>{row.name}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.calculationlDemand}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.activeTotalConsumption}</span></StyledTableCell  >\r\n                      <StyledTableCell><span className='normaltxt'>{((row.activeTotalConsumption/(row.dayNum*24))/row.calculationlDemand).toFixed(2)}</span></StyledTableCell>    \r\n                      </StyledTableRow >\r\n                  ))}\r\n                </TableBody>\r\n              </Table>\r\n            </TableContainer>\r\n            </Box>\r\n</Container>\r\n            </Box>\r\n    </ThemeProvider>\r\n  )\r\n}\r\n\r\nexport default BillScreen\r\n","/Users/macbook/project/alpasoft/frontend/src/screens/UploadScreen.js",["288","289","290","291"],"import React, { useState } from \"react\";  \r\nimport { read, utils, writeFile } from 'xlsx';\r\nimport { useSelector, useDispatch } from 'react-redux'\r\n\r\nimport Grid from \"@mui/material/Grid\";\r\nimport Card from \"@mui/material/Card\";\r\nimport axios from 'axios';\r\nimport { Container, Link, TextField } from \"@mui/material\";\r\nimport Button from '@mui/material/Button'; \r\nimport template from '../template.xlsx'\r\nimport InputLabel from '@mui/material/InputLabel';\r\nimport MenuItem from '@mui/material/MenuItem';\r\nimport FormControl from '@mui/material/FormControl';\r\nimport Select from '@mui/material/Select';\r\nconst HomeComponent = ({history}) => {\r\n\r\n\r\n    const [billInfo, setBillInfo] = useState([]);\r\n    const [month, setMonth] = useState('')\r\n    const [year, setYear] = useState('')\r\n    const userLogin = useSelector(state => state.userLogin)\r\n    const { userInfo } = userLogin\r\n    const handleImport = ($event) => {\r\n        const files = $event.target.files;\r\n        if (files.length) {\r\n            const file = files[0];\r\n            const reader = new FileReader();\r\n            reader.onload = (event) => {\r\n                const wb = read(event.target.result);\r\n                const sheets = wb.SheetNames;\r\n\r\n                if (sheets.length) {\r\n                    const rows = utils.sheet_to_json(wb.Sheets[sheets[0]]);\r\n                    setBillInfo(rows)\r\n\r\n                }\r\n            }\r\n            reader.readAsArrayBuffer(file);\r\n        }\r\n    }\r\n\r\n    const handleExport = () => {\r\n      sendJsonDataToBackend(billInfo);\r\n      history.push('/')\r\n\r\n    }\r\n    const sendJsonDataToBackend = async (billInfo) => {\r\n      try {\r\n        const config = {// request setting\r\n          header: {\r\n              'Content-type': 'application/json'\r\n          }\r\n      }\r\n      console.log(userInfo.id)\r\n        await axios.post('/api/v1/electbill/upload/',  { data: billInfo, month:month,year:year,state:1},config);\r\n        console.log('JSON data sent to the backend successfully.');\r\n      } catch (error) {\r\n        console.error('Error sending JSON data to the backend:', error);\r\n      }\r\n    };\r\n    const handleChangemonth = (event) => {\r\n        setMonth(event.target.value);\r\n      };\r\n      const handleChangeyear = (event) => {\r\n        setYear(event.target.value);\r\n      };\r\n    return (\r\n        <Container>\r\n          <Grid container spacing={3} style={{direction:'rtl'}}>\r\n         \r\n                <Grid item xs={12}  md={12} xl={12}>\r\n                <span className=\"linkblack\">لطفا قبل از بارگذاری فایل، فایل نمونه را دانلود و اطلاعات را در آن کپی و سپس بارگذاری نمایید.</span>  \r\n\r\n\r\n                <a\r\n                href={template}\r\n                download=\"Example-PDF-document\"\r\n                target=\"_blank\"\r\n                rel=\"noopener noreferrer\"\r\n              > <Button variant=\"outlined\"><span className=\"linkblack\">دانلود اکسل نمونه</span></Button>\r\n              </a>\r\n\r\n\r\n \r\n                <Card style={{alignItems:'right', textAlign:'right',marginTop:2, padding:4}}>\r\n                   \r\n                <span className=\"linkblack\">انتخاب فایل: </span>  \r\n                <input type=\"file\" name=\"file\" className=\"custom-file-input\" id=\"inputGroupFile\" required onChange={handleImport}\r\n                        accept=\".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel\" sx={{border:2}}/>\r\n               <br/>\r\n    \r\n     <FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\r\n     <InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب ماه</span></InputLabel>\r\n     <Select\r\n       labelId=\"demo-select-small-label\"\r\n       id=\"demo-select-small\"\r\n       value={month}\r\n       label=\"ماه\"\r\n       onChange={handleChangemonth}\r\n     >\r\n       <MenuItem value=\"\">\r\n         <em>None</em>\r\n       </MenuItem>\r\n       <MenuItem value={1}><span className='normaltxt'>فروردین</span></MenuItem>\r\n       <MenuItem value={2}><span className='normaltxt'>اردیبهشت</span></MenuItem>\r\n       <MenuItem value={3}><span className='normaltxt'>خرداد</span></MenuItem>\r\n       <MenuItem value={4}><span className='normaltxt'>تیر</span></MenuItem>\r\n       <MenuItem value={5}><span className='normaltxt'>مرداد</span></MenuItem>\r\n       <MenuItem value={6}><span className='normaltxt'>شهریور</span></MenuItem>\r\n       <MenuItem value={7}><span className='normaltxt'>مهر</span></MenuItem>\r\n       <MenuItem value={8}><span className='normaltxt'>آبان</span></MenuItem>\r\n       <MenuItem value={9}><span className='normaltxt'>آذر</span></MenuItem>\r\n       <MenuItem value={10}><span className='normaltxt'>دی</span></MenuItem>\r\n       <MenuItem value={11}><span className='normaltxt'>بهمن</span></MenuItem>\r\n       <MenuItem value={12}><span className='normaltxt'>اسفند</span></MenuItem>\r\n     </Select>\r\n   </FormControl>\r\n        \r\n      &nbsp;&nbsp;\r\n      <FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\r\n     <InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب سال</span> </InputLabel>\r\n     <Select\r\n       labelId=\"demo-select-small-label\"\r\n       id=\"demo-select-small\"\r\n       value={year}\r\n       label=\"<span className='titlegrid'>سال</span>\"\r\n       onChange={handleChangeyear}\r\n     >\r\n       <MenuItem value=\"\">\r\n         <em>None</em>\r\n       </MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1401</span></MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1402</span></MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1403</span></MenuItem>\r\n\r\n     </Select>\r\n   </FormControl>\r\n\r\n                <hr/>\r\n                <span className=\"linkblack\">در صورت تایید اطلاعات، به پایگاه داده منتقل نمایید\r\n</span>\r\n                <Button onClick={handleExport} variant=\"contained\"><span className='linkwhite'>ارسال فایل <i className=\"fa fa-download\"></i></span> \r\n                            </Button>\r\n            </Card>\r\n                </Grid>\r\n                <Grid item xs={12}  md={12} xl={12}>\r\n                <Card style={{alignItems:'center', textAlign:'center',marginTop:2}}>\r\n            <div className=\"row\">\r\n                <div className=\"col-sm-6 offset-3\">\r\n                    <table className=\"table\">\r\n                        <thead>\r\n                            <tr>\r\n\r\n                           <th scope=\"col\"><span className='titlegrid'>تعداد روز</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>پرباری</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>میان باری</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>کم باری</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>کل مصرف </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>مبلغ انرژی </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>دیماند مصرفی  </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>دیماند محاسباتی  </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>کل مصرف راکتیو   </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>مبلغ کل     </span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>شماره اشتراک    </span></th>\r\n   \r\n\r\n\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody> \r\n                                {\r\n                                    billInfo.length\r\n                                    ?\r\n                                    billInfo.map((movie, index) => (\r\n                                        <tr key={index}>\r\n                                            <td><span className='normaltxt'>{movie.dayNum}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.medium}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.low}</span></td>             \r\n                                            <td><span className='normaltxt'>{movie.high}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.activeTotalConsumption}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.activeTotalAmount}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.consumptionDemand}</span></td>             \r\n                                            <td><span className='normaltxt'>{movie.calculationlDemand}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.ractiveTotalConsumption}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.totalAmount}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.subscribeNum}</span></td>\r\n                                        </tr> \r\n                                    ))\r\n                                    :\r\n                                    <tr>\r\n                                        <td colSpan=\"5\" className=\"text-center\"><span className=\"normaltxt\">در حال حاظر قبضی بارگذاری نشده است</span></td>\r\n                                    </tr> \r\n                                }\r\n                        </tbody>\r\n                    </table>\r\n                </div>\r\n                </div>\r\n                </Card>\r\n                </Grid>\r\n                </Grid>\r\n            </Container>\r\n\r\n    );\r\n};\r\n\r\nexport default HomeComponent;\r\n","/Users/macbook/project/alpasoft/frontend/src/screens/BillScreen.js",["292","293","294","295","296","297","298","299","300","301","302","303","304","305","306","307","308"],"import React, { useState, useEffect } from 'react'\r\nimport { useDispatch, useSelector } from 'react-redux'\r\nimport { Link } from 'react-router-dom'\r\nimport { Row, Col, Image, ListGroup, Button, Form,Container } from 'react-bootstrap'\r\nimport { fetchbillDetails } from '../actions/billActions'\r\nimport Loader from '../components/Loader'\r\nimport Message from '../components/Message'\r\nimport Chart from '../components/Chart';\r\nimport ReactSpeedometer from \"react-d3-speedometer\";\r\nimport Card from '@mui/material/Card';\r\nimport { styled } from '@mui/material/styles';\r\nimport Box from '@mui/material/Box';\r\nimport Paper from '@mui/material/Paper';\r\nimport Grid from '@mui/material/Grid';\r\n\r\nconst Item = styled(Paper)(({ theme }) => ({\r\n  backgroundColor: theme.palette.mode === 'dark' ? '#1A2027' : '#fff',\r\n  ...theme.typography.body2,\r\n  padding: theme.spacing(1),\r\n  textAlign: 'center',\r\n  color: theme.palette.text.secondary,\r\n}));\r\n\r\nfunction BillScreen({ match, history }) {\r\n    const dispatch = useDispatch()\r\n    const [consumptionCoefficientvalue, setconsumptionCoefficientvalue] = React.useState('');\r\n    const BillDetails = useSelector(state => state.BillDetails)\r\n    const { error, loading, bill } = BillDetails\r\n    const consumptionCoefficient=bill.consumptionDemand/bill.calculationlDemand\r\n    const demandCoefficient=((bill.calculationlDemand*10)/9)/bill.consumptionDemand\r\n    const barCoefficient=(bill.activeTotalConsumption/(bill.dayNum*24))/bill.consumptionDemand\r\n    const resultconsumptionCoefficient=(consumptionCoefficient/0.6)*200\r\n    const resultdemandCoefficient=900\r\n\r\n     \r\n    useEffect(() => {\r\n        dispatch(fetchbillDetails(match.params.id))\r\n    }, [dispatch, match])\r\n\r\n\r\n\r\n    return (\r\n          \r\n          <Box sx={{ flexGrow: 1, margin:3 }}>\r\n      \r\n            <h4>{bill.name}</h4>\r\n            <span className='normaltxt'> از تاریخ : {bill.start_date} تا تاریخ: {bill.end_date}</span>\r\n        <hr/>\r\n        <Grid container spacing={1}>\r\n\r\n        <Grid item xs={4} md={4}>\r\n          <Item>\r\n          <span className='titlegrid'>  ضریب مصرف :{consumptionCoefficient.toFixed(3)}</span>\r\n          <ReactSpeedometer\r\n        width={350}\r\n        needleHeightRatio={0.7}\r\n        value={resultconsumptionCoefficient}\r\n        currentValueText=\"ضریب مصرف\"\r\n        customSegmentLabels={[\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'قابل قبول',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n        ]}\r\n        segmentColors={['#bf616a', '#ebcb8b', '#a3be8c','#ebcb8b', '#bf616a']}\r\n        ringWidth={47}\r\n        needleTransitionDuration={3333}\r\n        needleTransition=\"easeElastic\"\r\n        needleColor={'#90f2ff'}\r\n        textColor={'#d8dee9'}\r\n      />\r\n          </Item>\r\n        </Grid>\r\n        <Grid item xs={4} md={4}>\r\n          <Item>\r\n          <span className='titlegrid'> ضریب دیماند :{demandCoefficient.toFixed(3)}</span> \r\n          <ReactSpeedometer\r\n        width={350}\r\n        needleHeightRatio={0.7}\r\n        value={resultdemandCoefficient}\r\n        currentValueText=\"ضریب دیماند\"\r\n        customSegmentLabels={[\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'قابل قبول',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n        ]}\r\n        segmentColors={['tomato', '#ffe400', 'green','#ffe400', 'tomato']}\r\n        ringWidth={47}\r\n        needleTransitionDuration={3333}\r\n        needleTransition=\"easeElastic\"\r\n        needleColor={'#90f2ff'}\r\n        textColor={'#d8dee9'}\r\n      />\r\n          </Item>\r\n        </Grid>\r\n        <Grid item xs={4} md={4}>\r\n          <Item>\r\n          <span className='titlegrid'> ضریب بار :{barCoefficient.toFixed(3)}</span>\r\n          <ReactSpeedometer\r\n        width={350}\r\n        needleHeightRatio={0.7}\r\n        value={barCoefficient}\r\n        currentValueText=\"ضریب بار\"\r\n        customSegmentLabels={[\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'قابل قبول',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'هشدار',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n          {\r\n            text: 'خطر',\r\n            position: 'INSIDE',\r\n            color: '#fff',\r\n          },\r\n        ]}\r\n        segmentColors={['tomato', '#ffe400', 'green','#ffe400', 'tomato']}\r\n        ringWidth={47}\r\n        needleTransitionDuration={3333}\r\n        needleTransition=\"easeElastic\"\r\n        needleColor={'#90f2ff'}\r\n        textColor={'#d8dee9'}\r\n      />\r\n          </Item>\r\n        </Grid>\r\n      </Grid>\r\n    </Box>\r\n\r\n    )\r\n}\r\n\r\nexport default BillScreen\r\n","/Users/macbook/project/alpasoft/frontend/src/screens/demandCoefficientScreen.js",["309","310","311","312","313","314","315","316","317","318","319","320","321","322","323","324","325","326","327","328","329","330","331","332","333","334","335","336","337","338","339","340","341","342","343"],"import React, { useState, useEffect, PureComponent } from 'react'\r\nimport { useDispatch, useSelector } from 'react-redux'\r\nimport { Link } from 'react-router-dom'\r\nimport { Row, Col, Image, ListGroup, Button, Form, Container } from 'react-bootstrap'\r\nimport { fetchbillDetails } from '../actions/billActions'\r\nimport Loader from '../components/Loader'\r\nimport Message from '../components/Message'\r\nimport Chart from '../components/Chart';\r\nimport ReactSpeedometer from \"react-d3-speedometer\";\r\nimport Card from '@mui/material/Card';\r\nimport Box from '@mui/material/Box';\r\nimport Paper from '@mui/material/Paper';\r\nimport Grid from '@mui/material/Grid';\r\nimport { styled } from '@mui/material/styles';\r\nimport Table from '@mui/material/Table';\r\nimport TableBody from '@mui/material/TableBody';\r\nimport TableCell, { tableCellClasses } from '@mui/material/TableCell';\r\nimport TableContainer from '@mui/material/TableContainer';\r\nimport TableHead from '@mui/material/TableHead';\r\nimport TableRow from '@mui/material/TableRow';\r\nimport { fetchbills } from '../actions/billActions'\r\nimport { PieChart, Pie, Sector, Cell, ResponsiveContainer } from 'recharts';\r\nimport Checkbox from '@mui/material/Checkbox';\r\nimport FormGroup from '@mui/material/FormGroup';\r\nimport FormControlLabel from '@mui/material/FormControlLabel';\r\nimport FormControl from '@mui/material/FormControl';\r\nimport FormLabel from '@mui/material/FormLabel';\r\nimport { mainListItems  } from '../components/listItems';\r\nimport Toolbar from '@mui/material/Toolbar';\r\nimport List from '@mui/material/List';\r\nimport Divider from '@mui/material/Divider';\r\nimport IconButton from '@mui/material/IconButton';\r\nimport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\r\nimport MuiDrawer from '@mui/material/Drawer';\r\nimport {  createTheme, ThemeProvider } from '@mui/material/styles';\r\n\r\nconst StyledTableCell = styled(TableCell)(({ theme }) => ({\r\n  [`&.${tableCellClasses.head}`]: {\r\n    backgroundColor: theme.palette.common.black,\r\n    color: theme.palette.common.white,\r\n  },\r\n  [`&.${tableCellClasses.body}`]: {\r\n    fontSize: 14,\r\n  },\r\n}));\r\nconst drawerWidth = 300;\r\n\r\nconst Drawer = styled(MuiDrawer, { shouldForwardProp: (prop) => prop !== 'open' })(\r\n  ({ theme, open }) => ({\r\n    '& .MuiDrawer-paper': {\r\n      position: 'relative',\r\n      whiteSpace: 'nowrap',\r\n      width: drawerWidth,\r\n      transition: theme.transitions.create('width', {\r\n        easing: theme.transitions.easing.sharp,\r\n        duration: theme.transitions.duration.enteringScreen,\r\n      }),\r\n      boxSizing: 'border-box',\r\n      ...(!open && {\r\n        overflowX: 'hidden',\r\n        transition: theme.transitions.create('width', {\r\n          easing: theme.transitions.easing.sharp,\r\n          duration: theme.transitions.duration.leavingScreen,\r\n        }),\r\n        width: theme.spacing(7),\r\n        [theme.breakpoints.up('sm')]: {\r\n          width: theme.spacing(9),\r\n        },\r\n      }),\r\n    },\r\n  }),\r\n);\r\n\r\nconst StyledTableRow = styled(TableRow)(({ theme }) => ({\r\n  '&:nth-of-type(odd)': {\r\n    backgroundColor: theme.palette.action.hover,\r\n  },\r\n  // hide last border\r\n  '&:last-child td, &:last-child th': {\r\n    border: 0,\r\n  },\r\n}));\r\nconst Item = styled(Paper)(({ theme }) => ({\r\n  backgroundColor: theme.palette.mode === 'dark' ? '#1A2027' : '#fff',\r\n  ...theme.typography.body2,\r\n  padding: theme.spacing(1),\r\n  textAlign: 'center',\r\n  color: theme.palette.text.secondary,\r\n}));\r\nconst data = [\r\n  { name: 'Group A', value: 400 },\r\n  { name: 'Group B', value: 300 },\r\n  { name: 'Group C', value: 300 },\r\n];\r\n\r\nconst COLORS = [ '#00C49F', '#FFBB28', '#FF8042'];\r\n\r\nconst RADIAN = Math.PI / 180;\r\nconst renderCustomizedLabel = ({ cx, cy, midAngle, innerRadius, outerRadius, percent, index }) => {\r\n  const radius = innerRadius + (outerRadius - innerRadius) * 0.5;\r\n  const x = cx + radius * Math.cos(-midAngle * RADIAN);\r\n  const y = cy + radius * Math.sin(-midAngle * RADIAN);\r\n\r\n  return (\r\n    <text x={x} y={y} fill=\"white\" textAnchor={x > cx ? 'start' : 'end'} dominantBaseline=\"central\">\r\n      {`${(percent * 100).toFixed(0)}%`}\r\n    </text>\r\n  );\r\n};\r\n\r\nconst style = {\r\n  top: '50%',\r\n  right: 0,\r\n  transform: 'translate(0, -50%)',\r\n  lineHeight: '14px',\r\n};\r\nfunction BillScreen({ match, history }) {\r\n  const [open, setOpen] = React.useState(true);\r\n  const toggleDrawer = () => {\r\n    setOpen(!open);\r\n  };\r\n  const dispatch = useDispatch()\r\n\r\n  const listBills = useSelector(state => state.listBill)\r\n  const { error, loading, bills } = listBills\r\n  let prebill=[]\r\n\r\n  const [far, setFar] =  React.useState(false);\r\n  const [ord, setOrd] = React.useState(true);\r\n  const [kho, setKho] = React.useState(false);\r\n  const [tir, setTir] = React.useState(false);\r\n  const [mor, setMor] = React.useState(false);\r\n  const [sha, setSha] = React.useState(false);\r\n  const [meh, setMeh] = React.useState(false);\r\n  const [aba, setAba] = React.useState(false);\r\n  const [aza, setAza] = React.useState(false);\r\n  const [dey, setDey] = React.useState(false);\r\n  const [bah, setBah] = React.useState(false);\r\n  const [esf, setEsf] = React.useState(false);\r\n\r\n  const [year01, setYear01] = React.useState(false);\r\n  const [year02, setYear02] = React.useState(false);\r\n  const [year03, setYear03] = React.useState(false);\r\n\r\n  prebill = bills?.filter((bill) => ((far? bill.month==1 : null) || (ord? bill.month==2 : null)  || (kho? bill.month==3 : null)  || (tir? bill.month==4 : null) || (mor? bill.month==5 : null)|| (sha? bill.month==6 : null)|| (meh? bill.month==7 : null)|| (aba? bill.month==8 : null)|| (aza? bill.month==9 : null)|| (dey? bill.month==10 : null) || (bah? bill.month==11 : null) || (esf? bill.month==12 : null) || (year01? bill.year==1401 : null) || (year02? bill.year==1402 : null) || (year03? bill.year==1403 : null)   ))\r\n\r\n  useEffect(() => {\r\n    dispatch(fetchbills())\r\n\r\n  }, [dispatch,far,ord,year01])\r\n\r\n\r\n  const defaultTheme = createTheme();\r\n\r\n  return (\r\n      <ThemeProvider theme={defaultTheme}>\r\n\r\n\r\n<Box sx={{ display: 'flex' }}>\r\n\r\n   <Drawer variant=\"permanent\" open={open}>\r\n     <Toolbar\r\n       sx={{\r\n         display: 'flex',\r\n         alignItems: 'center',\r\n         justifyContent: 'flex-end',\r\n         backgroundColor:'#0C7075',\r\n         px: [1],\r\n       }}\r\n     >\r\n       <IconButton  onClick={toggleDrawer}>\r\n       <span className='linkwhite'>استان  </span>  <ChevronLeftIcon />\r\n       </IconButton>\r\n     </Toolbar>\r\n     <Divider />\r\n     <List component=\"nav\">\r\n       {mainListItems}\r\n       <Divider sx={{ my: 1 }} />\r\n     </List>\r\n   </Drawer>\r\n   <Container maxWidth=\"lg\" sx={{ mt: 4, mb: 4 }}>\r\n\r\n    <Box sx={{backgroundColor:'#fff',boxShadow:5,height:350, width:'100%',padding:1,borderRadius:5}}>\r\n\r\n <Row >\r\n        <Col  xs={8} md={8}>\r\n          <item>\r\n          <h1>ضریب دیماند</h1>\r\n            <span className='normaltxt'>فرمول : قدرت قراردادی*(10/9)/  قدرت مصرفی</span>\r\n\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>فروردین</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setFar(!far)}\r\n\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"2\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اردیبهشت</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setOrd(!ord)}\r\n                />\r\n                <FormControlLabel\r\n                  value=\"3\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>خرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setKho(!kho)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>تیر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setTir(!tir)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMor(!mor)}\r\n                />    \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>شهریور</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setSha(!sha)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مهر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMeh(!meh)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آبان</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAba(!aba)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آذر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAza(!aza)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>دی</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setDey(!dey)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>بهمن</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setBah(!bah)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اسفند</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setEsf(!esf)}\r\n                />       \r\n              </FormGroup>\r\n            </FormControl>\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1401\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1401</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear01(!year01)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1402\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1402</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear02(!year02)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1403\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1403</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear03(!year03)}\r\n\r\n                />\r\n              </FormGroup>\r\n            </FormControl>\r\n            <br />\r\n            <br />\r\n            <br />\r\n            <br />\r\n\r\n          </item>\r\n        </Col>\r\n        <Col item xs={4} md={4} >\r\n       \r\n          <ResponsiveContainer width=\"100%\" height=\"100%\">\r\n        <PieChart width={400} height={400}>\r\n          <Pie\r\n            data={data}\r\n            cx=\"50%\"\r\n            cy=\"50%\"\r\n            labelLine={false}\r\n            label={renderCustomizedLabel}\r\n            outerRadius={120}\r\n            fill=\"#8884d8\"\r\n            dataKey=\"value\"\r\n          >\r\n            {data.map((entry, index) => (\r\n              <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />\r\n            ))}\r\n          </Pie>\r\n        </PieChart>\r\n      </ResponsiveContainer>\r\n\r\n        </Col>\r\n        \r\n\r\n      </Row>\r\n</Box>\r\n<br/>\r\n<Box sx={{backgroundColor:'#fff' ,width:'100%',padding:1, textAlign:'center',right:0,left:0,alignItems:'center', alignContent:'center'}}>\r\n\r\n      <TableContainer style={{ width: 1000, margin: 'auto', borderRadius:15 }}  >\r\n              <Table sx={{ maxWidth: '100%'}} aria-label=\"customized table\">\r\n                <TableHead >\r\n                  <TableRow >\r\n                    <StyledTableCell style={{backgroundColor:'#0C7075'}}><span className='titlegrid'>نام مشترک</span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>دیماند مصرفی  </span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>دیماند محاسباتی  </span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>ضریب دیماند</span></StyledTableCell>\r\n\r\n\r\n\r\n\r\n                  </TableRow>\r\n                </TableHead>\r\n                <TableBody style={{ textAlign: 'right' }}>\r\n                  {prebill?.map((row) => (\r\n                    <StyledTableRow key={row._id}>\r\n                      <StyledTableCell style={{ textAlign: 'right' }}><span className='normaltxt'>{row.name}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.consumptionDemand}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.calculationlDemand}</span></StyledTableCell  >\r\n                      <StyledTableCell   ><span className='normaltxt'>{((row.consumptionDemand*10/9) / row.calculationlDemand).toFixed(2)}</span></StyledTableCell  > </StyledTableRow >\r\n                  ))}\r\n                </TableBody>\r\n              </Table>\r\n            </TableContainer>\r\n            </Box>\r\n</Container>\r\n            </Box>\r\n    </ThemeProvider>\r\n  )\r\n}\r\n\r\nexport default BillScreen\r\n","/Users/macbook/project/alpasoft/frontend/src/screens/barCompensationCoefficientScreen.js",["344","345","346","347","348","349","350","351","352","353","354","355","356","357","358","359","360","361","362","363","364","365","366","367","368","369","370","371","372","373","374","375","376","377","378"],"import React, { useState, useEffect, PureComponent } from 'react'\r\nimport { useDispatch, useSelector } from 'react-redux'\r\nimport { Link } from 'react-router-dom'\r\nimport { Row, Col, Image, ListGroup, Button, Form, Container } from 'react-bootstrap'\r\nimport { fetchbillDetails } from '../actions/billActions'\r\nimport Loader from '../components/Loader'\r\nimport Message from '../components/Message'\r\nimport Chart from '../components/Chart';\r\nimport ReactSpeedometer from \"react-d3-speedometer\";\r\nimport Card from '@mui/material/Card';\r\nimport Box from '@mui/material/Box';\r\nimport Paper from '@mui/material/Paper';\r\nimport Grid from '@mui/material/Grid';\r\nimport { styled } from '@mui/material/styles';\r\nimport Table from '@mui/material/Table';\r\nimport TableBody from '@mui/material/TableBody';\r\nimport TableCell, { tableCellClasses } from '@mui/material/TableCell';\r\nimport TableContainer from '@mui/material/TableContainer';\r\nimport TableHead from '@mui/material/TableHead';\r\nimport TableRow from '@mui/material/TableRow';\r\nimport { fetchbills } from '../actions/billActions'\r\nimport { PieChart, Pie, Sector, Cell, ResponsiveContainer } from 'recharts';\r\nimport Checkbox from '@mui/material/Checkbox';\r\nimport FormGroup from '@mui/material/FormGroup';\r\nimport FormControlLabel from '@mui/material/FormControlLabel';\r\nimport FormControl from '@mui/material/FormControl';\r\nimport FormLabel from '@mui/material/FormLabel';\r\nimport { mainListItems  } from '../components/listItems';\r\nimport Toolbar from '@mui/material/Toolbar';\r\nimport List from '@mui/material/List';\r\nimport Divider from '@mui/material/Divider';\r\nimport IconButton from '@mui/material/IconButton';\r\nimport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\r\nimport MuiDrawer from '@mui/material/Drawer';\r\nimport {  createTheme, ThemeProvider } from '@mui/material/styles';\r\n\r\nconst StyledTableCell = styled(TableCell)(({ theme }) => ({\r\n  [`&.${tableCellClasses.head}`]: {\r\n    backgroundColor: theme.palette.common.black,\r\n    color: theme.palette.common.white,\r\n  },\r\n  [`&.${tableCellClasses.body}`]: {\r\n    fontSize: 14,\r\n  },\r\n}));\r\nconst drawerWidth = 300;\r\n\r\nconst Drawer = styled(MuiDrawer, { shouldForwardProp: (prop) => prop !== 'open' })(\r\n  ({ theme, open }) => ({\r\n    '& .MuiDrawer-paper': {\r\n      position: 'relative',\r\n      whiteSpace: 'nowrap',\r\n      width: drawerWidth,\r\n      transition: theme.transitions.create('width', {\r\n        easing: theme.transitions.easing.sharp,\r\n        duration: theme.transitions.duration.enteringScreen,\r\n      }),\r\n      boxSizing: 'border-box',\r\n      ...(!open && {\r\n        overflowX: 'hidden',\r\n        transition: theme.transitions.create('width', {\r\n          easing: theme.transitions.easing.sharp,\r\n          duration: theme.transitions.duration.leavingScreen,\r\n        }),\r\n        width: theme.spacing(7),\r\n        [theme.breakpoints.up('sm')]: {\r\n          width: theme.spacing(9),\r\n        },\r\n      }),\r\n    },\r\n  }),\r\n);\r\n\r\nconst StyledTableRow = styled(TableRow)(({ theme }) => ({\r\n  '&:nth-of-type(odd)': {\r\n    backgroundColor: theme.palette.action.hover,\r\n  },\r\n  // hide last border\r\n  '&:last-child td, &:last-child th': {\r\n    border: 0,\r\n  },\r\n}));\r\nconst Item = styled(Paper)(({ theme }) => ({\r\n  backgroundColor: theme.palette.mode === 'dark' ? '#1A2027' : '#fff',\r\n  ...theme.typography.body2,\r\n  padding: theme.spacing(1),\r\n  textAlign: 'center',\r\n  color: theme.palette.text.secondary,\r\n}));\r\nconst data = [\r\n  { name: 'Group A', value: 200 },\r\n  { name: 'Group B', value: 700 },\r\n  { name: 'Group C', value: 20 },\r\n];\r\n\r\nconst COLORS = [ '#00C49F', '#FFBB28', '#FF8042'];\r\n\r\nconst RADIAN = Math.PI / 180;\r\nconst renderCustomizedLabel = ({ cx, cy, midAngle, innerRadius, outerRadius, percent, index }) => {\r\n  const radius = innerRadius + (outerRadius - innerRadius) * 0.5;\r\n  const x = cx + radius * Math.cos(-midAngle * RADIAN);\r\n  const y = cy + radius * Math.sin(-midAngle * RADIAN);\r\n\r\n  return (\r\n    <text x={x} y={y} fill=\"white\" textAnchor={x > cx ? 'start' : 'end'} dominantBaseline=\"central\">\r\n      {`${(percent * 100).toFixed(0)}%`}\r\n    </text>\r\n  );\r\n};\r\n\r\nconst style = {\r\n  top: '50%',\r\n  right: 0,\r\n  transform: 'translate(0, -50%)',\r\n  lineHeight: '14px',\r\n};\r\nfunction BillScreen({ match, history }) {\r\n  const [open, setOpen] = React.useState(true);\r\n  const toggleDrawer = () => {\r\n    setOpen(!open);\r\n  };\r\n  const dispatch = useDispatch()\r\n\r\n  const listBills = useSelector(state => state.listBill)\r\n  const { error, loading, bills } = listBills\r\n  let prebill=[]\r\n\r\n  const [far, setFar] =  React.useState(false);\r\n  const [ord, setOrd] = React.useState(true);\r\n  const [kho, setKho] = React.useState(false);\r\n  const [tir, setTir] = React.useState(false);\r\n  const [mor, setMor] = React.useState(false);\r\n  const [sha, setSha] = React.useState(false);\r\n  const [meh, setMeh] = React.useState(false);\r\n  const [aba, setAba] = React.useState(false);\r\n  const [aza, setAza] = React.useState(false);\r\n  const [dey, setDey] = React.useState(false);\r\n  const [bah, setBah] = React.useState(false);\r\n  const [esf, setEsf] = React.useState(false);\r\n\r\n  const [year01, setYear01] = React.useState(false);\r\n  const [year02, setYear02] = React.useState(false);\r\n  const [year03, setYear03] = React.useState(false);\r\n\r\n  prebill = bills?.filter((bill) => ((far? bill.month==1 : null) || (ord? bill.month==2 : null)  || (kho? bill.month==3 : null)  || (tir? bill.month==4 : null) || (mor? bill.month==5 : null)|| (sha? bill.month==6 : null)|| (meh? bill.month==7 : null)|| (aba? bill.month==8 : null)|| (aza? bill.month==9 : null)|| (dey? bill.month==10 : null) || (bah? bill.month==11 : null) || (esf? bill.month==12 : null) || (year01? bill.year==1401 : null) || (year02? bill.year==1402 : null) || (year03? bill.year==1403 : null)   ))\r\n\r\n  useEffect(() => {\r\n    dispatch(fetchbills())\r\n\r\n  }, [dispatch,far,ord,year01])\r\n\r\n\r\n  const defaultTheme = createTheme();\r\n\r\n  return (\r\n      <ThemeProvider theme={defaultTheme}>\r\n\r\n\r\n<Box sx={{ display: 'flex' }}>\r\n\r\n   <Drawer variant=\"permanent\" open={open}>\r\n     <Toolbar\r\n       sx={{\r\n         display: 'flex',\r\n         alignItems: 'center',\r\n         justifyContent: 'flex-end',\r\n         backgroundColor:'#0C7075',\r\n         px: [1],\r\n       }}\r\n     >\r\n       <IconButton  onClick={toggleDrawer}>\r\n       <span className='linkwhite'>استان  </span>  <ChevronLeftIcon />\r\n       </IconButton>\r\n     </Toolbar>\r\n     <Divider />\r\n     <List component=\"nav\">\r\n       {mainListItems}\r\n       <Divider sx={{ my: 1 }} />\r\n     </List>\r\n   </Drawer>\r\n   <Container maxWidth=\"lg\" sx={{ mt: 4, mb: 4 }}>\r\n\r\n    <Box sx={{backgroundColor:'#fff',boxShadow:5,height:350, width:'100%',padding:1,borderRadius:5}}>\r\n\r\n <Row >\r\n        <Col  xs={8} md={8}>\r\n          <item>\r\n            <h1>ضریب جبران بار راکتیو </h1>\r\n            <span className='normaltxt'>فرمول: مصرف بار راکتیو/ قدرت مصرفی (قرائت شده)</span>\r\n\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>فروردین</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setFar(!far)}\r\n\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"2\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اردیبهشت</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setOrd(!ord)}\r\n                />\r\n                <FormControlLabel\r\n                  value=\"3\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>خرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setKho(!kho)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>تیر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setTir(!tir)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMor(!mor)}\r\n                />    \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>شهریور</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setSha(!sha)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مهر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMeh(!meh)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آبان</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAba(!aba)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آذر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAza(!aza)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>دی</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setDey(!dey)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>بهمن</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setBah(!bah)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اسفند</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setEsf(!esf)}\r\n                />       \r\n              </FormGroup>\r\n            </FormControl>\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1401\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1401</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear01(!year01)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1402\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1402</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear02(!year02)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1403\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1403</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear03(!year03)}\r\n\r\n                />\r\n              </FormGroup>\r\n            </FormControl>\r\n            <br />\r\n            <br />\r\n            <br />\r\n            <br />\r\n\r\n          </item>\r\n        </Col>\r\n        <Col item xs={4} md={4} >\r\n       \r\n          <ResponsiveContainer width=\"100%\" height=\"100%\">\r\n        <PieChart width={400} height={400}>\r\n          <Pie\r\n            data={data}\r\n            cx=\"50%\"\r\n            cy=\"50%\"\r\n            labelLine={false}\r\n            label={renderCustomizedLabel}\r\n            outerRadius={120}\r\n            fill=\"#8884d8\"\r\n            dataKey=\"value\"\r\n          >\r\n            {data.map((entry, index) => (\r\n              <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />\r\n            ))}\r\n          </Pie>\r\n        </PieChart>\r\n      </ResponsiveContainer>\r\n\r\n        </Col>\r\n        \r\n\r\n      </Row>\r\n</Box>\r\n<br/>\r\n<Box sx={{backgroundColor:'#fff' ,width:'100%',padding:1, textAlign:'center',right:0,left:0,alignItems:'center', alignContent:'center'}}>\r\n\r\n      <TableContainer style={{ width: 1000, margin: 'auto', borderRadius:15 }}  >\r\n              <Table sx={{ maxWidth: '100%'}} aria-label=\"customized table\">\r\n                <TableHead >\r\n                  <TableRow >\r\n                    <StyledTableCell style={{backgroundColor:'#0C7075'}}><span className='titlegrid'>نام مشترک</span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>  مصرف بار راکتیو </span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'> قدرت مصرفی(قرائت شده)   </span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>  ضریب جبرات بار راکتیو </span></StyledTableCell>\r\n\r\n\r\n\r\n\r\n                  </TableRow>\r\n                </TableHead>\r\n                <TableBody style={{ textAlign: 'right' }}>\r\n                  {prebill?.map((row) => (\r\n                    <StyledTableRow key={row._id}>\r\n                      <StyledTableCell style={{ textAlign: 'right' }}><span className='normaltxt'>{row.name}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.calculationlDemand}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.ractiveTotalConsumption}</span></StyledTableCell  >\r\n                      <StyledTableCell><span className='normaltxt'>{(row.ractiveTotalConsumption/row.calculationlDemand).toFixed(2)}</span></StyledTableCell>    \r\n                      </StyledTableRow >\r\n                  ))}\r\n                </TableBody>\r\n              </Table>\r\n            </TableContainer>\r\n            </Box>\r\n</Container>\r\n            </Box>\r\n    </ThemeProvider>\r\n  )\r\n}\r\n\r\nexport default BillScreen\r\n","/Users/macbook/project/alpasoft/frontend/src/utils/PrivateRoute.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/barCoefficientScreen.js",["379","380","381","382","383","384","385","386","387","388","389","390","391","392","393","394","395","396","397","398","399","400","401","402","403","404","405","406","407","408","409","410","411","412","413"],"import React, { useState, useEffect, PureComponent } from 'react'\r\nimport { useDispatch, useSelector } from 'react-redux'\r\nimport { Link } from 'react-router-dom'\r\nimport { Row, Col, Image, ListGroup, Button, Form, Container } from 'react-bootstrap'\r\nimport { fetchbillDetails } from '../actions/billActions'\r\nimport Loader from '../components/Loader'\r\nimport Message from '../components/Message'\r\nimport Chart from '../components/Chart';\r\nimport ReactSpeedometer from \"react-d3-speedometer\";\r\nimport Card from '@mui/material/Card';\r\nimport Box from '@mui/material/Box';\r\nimport Paper from '@mui/material/Paper';\r\nimport Grid from '@mui/material/Grid';\r\nimport { styled } from '@mui/material/styles';\r\nimport Table from '@mui/material/Table';\r\nimport TableBody from '@mui/material/TableBody';\r\nimport TableCell, { tableCellClasses } from '@mui/material/TableCell';\r\nimport TableContainer from '@mui/material/TableContainer';\r\nimport TableHead from '@mui/material/TableHead';\r\nimport TableRow from '@mui/material/TableRow';\r\nimport { fetchbills } from '../actions/billActions'\r\nimport { PieChart, Pie, Sector, Cell, ResponsiveContainer } from 'recharts';\r\nimport Checkbox from '@mui/material/Checkbox';\r\nimport FormGroup from '@mui/material/FormGroup';\r\nimport FormControlLabel from '@mui/material/FormControlLabel';\r\nimport FormControl from '@mui/material/FormControl';\r\nimport FormLabel from '@mui/material/FormLabel';\r\nimport { mainListItems  } from '../components/listItems';\r\nimport Toolbar from '@mui/material/Toolbar';\r\nimport List from '@mui/material/List';\r\nimport Divider from '@mui/material/Divider';\r\nimport IconButton from '@mui/material/IconButton';\r\nimport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\r\nimport MuiDrawer from '@mui/material/Drawer';\r\nimport {  createTheme, ThemeProvider } from '@mui/material/styles';\r\n\r\nconst StyledTableCell = styled(TableCell)(({ theme }) => ({\r\n  [`&.${tableCellClasses.head}`]: {\r\n    backgroundColor: theme.palette.common.black,\r\n    color: theme.palette.common.white,\r\n  },\r\n  [`&.${tableCellClasses.body}`]: {\r\n    fontSize: 14,\r\n  },\r\n}));\r\nconst drawerWidth = 300;\r\n\r\nconst Drawer = styled(MuiDrawer, { shouldForwardProp: (prop) => prop !== 'open' })(\r\n  ({ theme, open }) => ({\r\n    '& .MuiDrawer-paper': {\r\n      position: 'relative',\r\n      whiteSpace: 'nowrap',\r\n      width: drawerWidth,\r\n      transition: theme.transitions.create('width', {\r\n        easing: theme.transitions.easing.sharp,\r\n        duration: theme.transitions.duration.enteringScreen,\r\n      }),\r\n      boxSizing: 'border-box',\r\n      ...(!open && {\r\n        overflowX: 'hidden',\r\n        transition: theme.transitions.create('width', {\r\n          easing: theme.transitions.easing.sharp,\r\n          duration: theme.transitions.duration.leavingScreen,\r\n        }),\r\n        width: theme.spacing(7),\r\n        [theme.breakpoints.up('sm')]: {\r\n          width: theme.spacing(9),\r\n        },\r\n      }),\r\n    },\r\n  }),\r\n);\r\n\r\nconst StyledTableRow = styled(TableRow)(({ theme }) => ({\r\n  '&:nth-of-type(odd)': {\r\n    backgroundColor: theme.palette.action.hover,\r\n  },\r\n  // hide last border\r\n  '&:last-child td, &:last-child th': {\r\n    border: 0,\r\n  },\r\n}));\r\nconst Item = styled(Paper)(({ theme }) => ({\r\n  backgroundColor: theme.palette.mode === 'dark' ? '#1A2027' : '#fff',\r\n  ...theme.typography.body2,\r\n  padding: theme.spacing(1),\r\n  textAlign: 'center',\r\n  color: theme.palette.text.secondary,\r\n}));\r\nconst data = [\r\n  { name: 'Group A', value: 50 },\r\n  { name: 'Group B', value: 300 },\r\n  { name: 'Group C', value: 100 },\r\n];\r\n\r\nconst COLORS = [ '#00C49F', '#FFBB28', '#FF8042'];\r\n\r\nconst RADIAN = Math.PI / 180;\r\nconst renderCustomizedLabel = ({ cx, cy, midAngle, innerRadius, outerRadius, percent, index }) => {\r\n  const radius = innerRadius + (outerRadius - innerRadius) * 0.5;\r\n  const x = cx + radius * Math.cos(-midAngle * RADIAN);\r\n  const y = cy + radius * Math.sin(-midAngle * RADIAN);\r\n\r\n  return (\r\n    <text x={x} y={y} fill=\"white\" textAnchor={x > cx ? 'start' : 'end'} dominantBaseline=\"central\">\r\n      {`${(percent * 100).toFixed(0)}%`}\r\n    </text>\r\n  );\r\n};\r\n\r\nconst style = {\r\n  top: '50%',\r\n  right: 0,\r\n  transform: 'translate(0, -50%)',\r\n  lineHeight: '14px',\r\n};\r\nfunction BillScreen({ match, history }) {\r\n  const [open, setOpen] = React.useState(true);\r\n  const toggleDrawer = () => {\r\n    setOpen(!open);\r\n  };\r\n  const dispatch = useDispatch()\r\n\r\n  const listBills = useSelector(state => state.listBill)\r\n  const { error, loading, bills } = listBills\r\n  let prebill=[]\r\n\r\n  const [far, setFar] =  React.useState(false);\r\n  const [ord, setOrd] = React.useState(true);\r\n  const [kho, setKho] = React.useState(false);\r\n  const [tir, setTir] = React.useState(false);\r\n  const [mor, setMor] = React.useState(false);\r\n  const [sha, setSha] = React.useState(false);\r\n  const [meh, setMeh] = React.useState(false);\r\n  const [aba, setAba] = React.useState(false);\r\n  const [aza, setAza] = React.useState(false);\r\n  const [dey, setDey] = React.useState(false);\r\n  const [bah, setBah] = React.useState(false);\r\n  const [esf, setEsf] = React.useState(false);\r\n\r\n  const [year01, setYear01] = React.useState(false);\r\n  const [year02, setYear02] = React.useState(false);\r\n  const [year03, setYear03] = React.useState(false);\r\n\r\n  prebill = bills?.filter((bill) => ((far? bill.month==1 : null) || (ord? bill.month==2 : null)  || (kho? bill.month==3 : null)  || (tir? bill.month==4 : null) || (mor? bill.month==5 : null)|| (sha? bill.month==6 : null)|| (meh? bill.month==7 : null)|| (aba? bill.month==8 : null)|| (aza? bill.month==9 : null)|| (dey? bill.month==10 : null) || (bah? bill.month==11 : null) || (esf? bill.month==12 : null) || (year01? bill.year==1401 : null) || (year02? bill.year==1402 : null) || (year03? bill.year==1403 : null)   ))\r\n\r\n  useEffect(() => {\r\n    dispatch(fetchbills())\r\n\r\n  }, [dispatch,far,ord,year01])\r\n\r\n\r\n  const defaultTheme = createTheme();\r\n\r\n  return (\r\n      <ThemeProvider theme={defaultTheme}>\r\n\r\n\r\n<Box sx={{ display: 'flex' }}>\r\n\r\n   <Drawer variant=\"permanent\" open={open}>\r\n     <Toolbar\r\n       sx={{\r\n         display: 'flex',\r\n         alignItems: 'center',\r\n         justifyContent: 'flex-end',\r\n         backgroundColor:'#0C7075',\r\n         px: [1],\r\n       }}\r\n     >\r\n       <IconButton  onClick={toggleDrawer}>\r\n       <span className='linkwhite'>استان  </span>  <ChevronLeftIcon />\r\n       </IconButton>\r\n     </Toolbar>\r\n     <Divider />\r\n     <List component=\"nav\">\r\n       {mainListItems}\r\n       <Divider sx={{ my: 1 }} />\r\n     </List>\r\n   </Drawer>\r\n   <Container maxWidth=\"lg\" sx={{ mt: 4, mb: 4 }}>\r\n\r\n    <Box sx={{backgroundColor:'#fff',boxShadow:5,height:350, width:'100%',padding:1,borderRadius:5}}>\r\n\r\n <Row >\r\n        <Col  xs={8} md={8}>\r\n          <item>\r\n            <h1>ضریب بار</h1>\r\n            <span className='normaltxt'>فرمول: (مصرف کل/تعداد روز*24)/قدرت مصرفی(قرائت شده)</span>\r\n\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>فروردین</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setFar(!far)}\r\n\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"2\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اردیبهشت</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setOrd(!ord)}\r\n                />\r\n                <FormControlLabel\r\n                  value=\"3\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>خرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setKho(!kho)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>تیر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setTir(!tir)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMor(!mor)}\r\n                />    \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>شهریور</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setSha(!sha)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مهر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMeh(!meh)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آبان</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAba(!aba)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آذر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAza(!aza)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>دی</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setDey(!dey)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>بهمن</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setBah(!bah)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اسفند</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setEsf(!esf)}\r\n                />       \r\n              </FormGroup>\r\n            </FormControl>\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1401\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1401</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear01(!year01)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1402\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1402</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear02(!year02)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1403\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1403</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear03(!year03)}\r\n\r\n                />\r\n              </FormGroup>\r\n            </FormControl>\r\n            <br />\r\n            <br />\r\n            <br />\r\n            <br />\r\n\r\n          </item>\r\n        </Col>\r\n        <Col item xs={4} md={4} >\r\n       \r\n          <ResponsiveContainer width=\"100%\" height=\"100%\">\r\n        <PieChart width={400} height={400}>\r\n          <Pie\r\n            data={data}\r\n            cx=\"50%\"\r\n            cy=\"50%\"\r\n            labelLine={false}\r\n            label={renderCustomizedLabel}\r\n            outerRadius={120}\r\n            fill=\"#8884d8\"\r\n            dataKey=\"value\"\r\n          >\r\n            {data.map((entry, index) => (\r\n              <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />\r\n            ))}\r\n          </Pie>\r\n        </PieChart>\r\n      </ResponsiveContainer>\r\n\r\n        </Col>\r\n        \r\n\r\n      </Row>\r\n</Box>\r\n<br/>\r\n<Box sx={{backgroundColor:'#fff' ,width:'100%',padding:1, textAlign:'center',right:0,left:0,alignItems:'center', alignContent:'center'}}>\r\n\r\n      <TableContainer style={{ width: 1000, margin: 'auto', borderRadius:15 }}  >\r\n              <Table sx={{ maxWidth: '100%'}} aria-label=\"customized table\">\r\n                <TableHead >\r\n                  <TableRow >\r\n                    <StyledTableCell style={{backgroundColor:'#0C7075'}}><span className='titlegrid'>نام مشترک</span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>قدرت مصرفی(قرائت شده)   </span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>مصرف کل   </span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>ضریب بار</span></StyledTableCell>\r\n\r\n\r\n\r\n\r\n                  </TableRow>\r\n                </TableHead>\r\n                <TableBody style={{ textAlign: 'right' }}>\r\n                  {prebill?.map((row) => (\r\n                    <StyledTableRow key={row._id}>\r\n                      <StyledTableCell style={{ textAlign: 'right' }}><span className='normaltxt'>{row.name}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.consumptionDemand}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.activeTotalConsumption}</span></StyledTableCell  >\r\n                      <StyledTableCell><span className='normaltxt'>{((row.activeTotalConsumption/(row.dayNum*24))/row.consumptionDemand).toFixed(2)}</span></StyledTableCell>                    </StyledTableRow >\r\n                  ))}\r\n                </TableBody>\r\n              </Table>\r\n            </TableContainer>\r\n            </Box>\r\n</Container>\r\n            </Box>\r\n    </ThemeProvider>\r\n  )\r\n}\r\n\r\nexport default BillScreen\r\n","/Users/macbook/project/alpasoft/frontend/src/screens/RegisterScreen.js",["414"],"import React, { useState, useEffect } from 'react'\nimport { Form, Col, Row, Button } from 'react-bootstrap'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { userRegisterAction } from '../actions/userActions'\nimport { Link } from 'react-router-dom'\nimport Message from '../components/Message'\nimport Loader from '../components/Loader'\n\n \nfunction RegisterScreen({ location, history }) {\n\n    // redirect path\n    const redirect = location.search ? location.search.split('=')[1] : '/'\n    // local states\n    const [name, setName] = useState('')\n    const [email, setEmail] = useState('')\n    const [password, setPassword] = useState('')\n    const [confirmPassword, setConfirmPassword] = useState('')\n    const [message, setMessage] = useState('')\n    const [emailMessage, setEmailMessage] = useState('')\n\n    // handle registe user\n    const dispatch = useDispatch()\n    const userRegister = useSelector(state => state.userRegister)\n    const { userInfo, error, loading } = userRegister\n    const submitHandler = (e) => {\n        e.preventDefault()\n        if (password != confirmPassword) {\n            setMessage('Password and confirm password do not match !')\n        } else {\n            dispatch(userRegisterAction(name, email, password))\n            setName('')\n            setEmail('')\n            setPassword('')\n            setConfirmPassword('')\n            setMessage('')\n        }\n    }\n\n    useEffect(() => {\n        if (userInfo && userInfo.detail) {\n            setEmailMessage(userInfo.detail)\n        }\n    }, [history, redirect, userInfo])\n\n    return (\n        <>\n            <h1>sign up</h1>\n            {\n                loading ? <Loader />\n                    : error ? <Message variant='danger' text={error} />\n                        : emailMessage ? <Message variant='warning' text={emailMessage} />\n                            : message ? <Message variant='danger' text={message} />\n                                : <></>\n            }\n            <Form onSubmit={submitHandler}>\n                <Form.Group controlId='name'>\n                    <Form.Label>FullName</Form.Label>\n                    <Form.Control\n                        type='text'\n                        placeholder='Enter FullName'\n                        value={name}\n                        onChange={(e) => setName(e.target.value)}\n                    ></Form.Control>\n                </Form.Group>\n\n                <Form.Group className='mt-4' controlId='email'>\n                    <Form.Label>Email Address</Form.Label>\n                    <Form.Control\n                        type='email'\n                        placeholder='Enter Email'\n                        value={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                    ></Form.Control>\n                </Form.Group>\n\n                <Form.Group className='mt-4' controlId='password'>\n                    <Form.Label>Password</Form.Label>\n                    <Form.Control\n                        type='password'\n                        placeholder='Enter Password'\n                        value={password}\n                        onChange={(e) => setPassword(e.target.value)}\n                    ></Form.Control>\n                </Form.Group>\n\n                <Form.Group className='mt-4' controlId='confirmPassword'>\n                    <Form.Label>Confirm Password</Form.Label>\n                    <Form.Control\n                        type='password'\n                        placeholder='Enter Confirm Password'\n                        value={confirmPassword}\n                        onChange={(e) => setConfirmPassword(e.target.value)}\n                    ></Form.Control>\n                </Form.Group>\n\n                <Button\n                    type='submit'\n                    className='my-4 col-4'\n                >\n                    register\n                </Button>\n            </Form>\n\n            <Row className=\"my-4\">\n                <Col>\n                    Have an Account ?\n\n                    <Link to={redirect ? `/login?redirect=${redirect}` : `/login`}>\n                        Login\n                    </Link>\n                </Col>\n            </Row>\n        </>\n    )\n}\n\nexport default RegisterScreen","/Users/macbook/project/alpasoft/frontend/src/screens/barCompensationCoefficientActiveScreen.js",["415","416","417","418","419","420","421","422","423","424","425","426","427","428","429","430","431","432","433","434","435","436","437","438","439","440","441","442","443","444","445","446","447","448","449"],"import React, { useState, useEffect, PureComponent } from 'react'\r\nimport { useDispatch, useSelector } from 'react-redux'\r\nimport { Link } from 'react-router-dom'\r\nimport { Row, Col, Image, ListGroup, Button, Form, Container } from 'react-bootstrap'\r\nimport { fetchbillDetails } from '../actions/billActions'\r\nimport Loader from '../components/Loader'\r\nimport Message from '../components/Message'\r\nimport Chart from '../components/Chart';\r\nimport ReactSpeedometer from \"react-d3-speedometer\";\r\nimport Card from '@mui/material/Card';\r\nimport Box from '@mui/material/Box';\r\nimport Paper from '@mui/material/Paper';\r\nimport Grid from '@mui/material/Grid';\r\nimport { styled } from '@mui/material/styles';\r\nimport Table from '@mui/material/Table';\r\nimport TableBody from '@mui/material/TableBody';\r\nimport TableCell, { tableCellClasses } from '@mui/material/TableCell';\r\nimport TableContainer from '@mui/material/TableContainer';\r\nimport TableHead from '@mui/material/TableHead';\r\nimport TableRow from '@mui/material/TableRow';\r\nimport { fetchbills } from '../actions/billActions'\r\nimport { PieChart, Pie, Sector, Cell, ResponsiveContainer } from 'recharts';\r\nimport Checkbox from '@mui/material/Checkbox';\r\nimport FormGroup from '@mui/material/FormGroup';\r\nimport FormControlLabel from '@mui/material/FormControlLabel';\r\nimport FormControl from '@mui/material/FormControl';\r\nimport FormLabel from '@mui/material/FormLabel';\r\nimport { mainListItems  } from '../components/listItems';\r\nimport Toolbar from '@mui/material/Toolbar';\r\nimport List from '@mui/material/List';\r\nimport Divider from '@mui/material/Divider';\r\nimport IconButton from '@mui/material/IconButton';\r\nimport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\r\nimport MuiDrawer from '@mui/material/Drawer';\r\nimport {  createTheme, ThemeProvider } from '@mui/material/styles';\r\n\r\nconst StyledTableCell = styled(TableCell)(({ theme }) => ({\r\n  [`&.${tableCellClasses.head}`]: {\r\n    backgroundColor: theme.palette.common.black,\r\n    color: theme.palette.common.white,\r\n  },\r\n  [`&.${tableCellClasses.body}`]: {\r\n    fontSize: 14,\r\n  },\r\n}));\r\nconst drawerWidth = 300;\r\n\r\nconst Drawer = styled(MuiDrawer, { shouldForwardProp: (prop) => prop !== 'open' })(\r\n  ({ theme, open }) => ({\r\n    '& .MuiDrawer-paper': {\r\n      position: 'relative',\r\n      whiteSpace: 'nowrap',\r\n      width: drawerWidth,\r\n      transition: theme.transitions.create('width', {\r\n        easing: theme.transitions.easing.sharp,\r\n        duration: theme.transitions.duration.enteringScreen,\r\n      }),\r\n      boxSizing: 'border-box',\r\n      ...(!open && {\r\n        overflowX: 'hidden',\r\n        transition: theme.transitions.create('width', {\r\n          easing: theme.transitions.easing.sharp,\r\n          duration: theme.transitions.duration.leavingScreen,\r\n        }),\r\n        width: theme.spacing(7),\r\n        [theme.breakpoints.up('sm')]: {\r\n          width: theme.spacing(9),\r\n        },\r\n      }),\r\n    },\r\n  }),\r\n);\r\n\r\nconst StyledTableRow = styled(TableRow)(({ theme }) => ({\r\n  '&:nth-of-type(odd)': {\r\n    backgroundColor: theme.palette.action.hover,\r\n  },\r\n  // hide last border\r\n  '&:last-child td, &:last-child th': {\r\n    border: 0,\r\n  },\r\n}));\r\nconst Item = styled(Paper)(({ theme }) => ({\r\n  backgroundColor: theme.palette.mode === 'dark' ? '#1A2027' : '#fff',\r\n  ...theme.typography.body2,\r\n  padding: theme.spacing(1),\r\n  textAlign: 'center',\r\n  color: theme.palette.text.secondary,\r\n}));\r\nconst data = [\r\n  { name: 'Group A', value: 400 },\r\n  { name: 'Group B', value: 300 },\r\n  { name: 'Group C', value: 300 },\r\n];\r\n\r\nconst COLORS = [ '#00C49F', '#FFBB28', '#FF8042'];\r\n\r\nconst RADIAN = Math.PI / 180;\r\nconst renderCustomizedLabel = ({ cx, cy, midAngle, innerRadius, outerRadius, percent, index }) => {\r\n  const radius = innerRadius + (outerRadius - innerRadius) * 0.5;\r\n  const x = cx + radius * Math.cos(-midAngle * RADIAN);\r\n  const y = cy + radius * Math.sin(-midAngle * RADIAN);\r\n\r\n  return (\r\n    <text x={x} y={y} fill=\"white\" textAnchor={x > cx ? 'start' : 'end'} dominantBaseline=\"central\">\r\n      {`${(percent * 100).toFixed(0)}%`}\r\n    </text>\r\n  );\r\n};\r\n\r\nconst style = {\r\n  top: '50%',\r\n  right: 0,\r\n  transform: 'translate(0, -50%)',\r\n  lineHeight: '14px',\r\n};\r\nfunction BillScreen({ match, history }) {\r\n  const [open, setOpen] = React.useState(true);\r\n  const toggleDrawer = () => {\r\n    setOpen(!open);\r\n  };\r\n  const dispatch = useDispatch()\r\n\r\n  const listBills = useSelector(state => state.listBill)\r\n  const { error, loading, bills } = listBills\r\n  let prebill=[]\r\n\r\n  const [far, setFar] =  React.useState(false);\r\n  const [ord, setOrd] = React.useState(true);\r\n  const [kho, setKho] = React.useState(false);\r\n  const [tir, setTir] = React.useState(false);\r\n  const [mor, setMor] = React.useState(false);\r\n  const [sha, setSha] = React.useState(false);\r\n  const [meh, setMeh] = React.useState(false);\r\n  const [aba, setAba] = React.useState(false);\r\n  const [aza, setAza] = React.useState(false);\r\n  const [dey, setDey] = React.useState(false);\r\n  const [bah, setBah] = React.useState(false);\r\n  const [esf, setEsf] = React.useState(false);\r\n\r\n  const [year01, setYear01] = React.useState(false);\r\n  const [year02, setYear02] = React.useState(false);\r\n  const [year03, setYear03] = React.useState(false);\r\n\r\n  prebill = bills?.filter((bill) => ((far? bill.month==1 : null) || (ord? bill.month==2 : null)  || (kho? bill.month==3 : null)  || (tir? bill.month==4 : null) || (mor? bill.month==5 : null)|| (sha? bill.month==6 : null)|| (meh? bill.month==7 : null)|| (aba? bill.month==8 : null)|| (aza? bill.month==9 : null)|| (dey? bill.month==10 : null) || (bah? bill.month==11 : null) || (esf? bill.month==12 : null) || (year01? bill.year==1401 : null) || (year02? bill.year==1402 : null) || (year03? bill.year==1403 : null)   ))\r\n\r\n  useEffect(() => {\r\n    dispatch(fetchbills())\r\n\r\n  }, [dispatch,far,ord,year01])\r\n\r\n\r\n  const defaultTheme = createTheme();\r\n\r\n  return (\r\n      <ThemeProvider theme={defaultTheme}>\r\n\r\n\r\n<Box sx={{ display: 'flex' }}>\r\n\r\n   <Drawer variant=\"permanent\" open={open}>\r\n     <Toolbar\r\n       sx={{\r\n         display: 'flex',\r\n         alignItems: 'center',\r\n         justifyContent: 'flex-end',\r\n         backgroundColor:'#0C7075',\r\n         px: [1],\r\n       }}\r\n     >\r\n       <IconButton  onClick={toggleDrawer}>\r\n       <span className='linkwhite'>استان  </span>  <ChevronLeftIcon />\r\n       </IconButton>\r\n     </Toolbar>\r\n     <Divider />\r\n     <List component=\"nav\">\r\n       {mainListItems}\r\n       <Divider sx={{ my: 1 }} />\r\n     </List>\r\n   </Drawer>\r\n   <Container maxWidth=\"lg\" sx={{ mt: 4, mb: 4 }}>\r\n\r\n    <Box sx={{backgroundColor:'#fff',boxShadow:5,height:350, width:'100%',padding:1,borderRadius:5}}>\r\n\r\n <Row >\r\n        <Col  xs={8} md={8}>\r\n          <item>\r\n            <h1>ضریب جبران بار راکتیو فعال </h1>\r\n            <span className='normaltxt'>فرمول: مصرف بار راکتیو/ قدرت دیماند محاسبه شده </span>\r\n\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>فروردین</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setFar(!far)}\r\n\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"2\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اردیبهشت</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setOrd(!ord)}\r\n                />\r\n                <FormControlLabel\r\n                  value=\"3\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>خرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setKho(!kho)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>تیر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setTir(!tir)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMor(!mor)}\r\n                />    \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>شهریور</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setSha(!sha)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مهر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMeh(!meh)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آبان</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAba(!aba)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آذر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAza(!aza)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>دی</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setDey(!dey)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>بهمن</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setBah(!bah)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اسفند</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setEsf(!esf)}\r\n                />       \r\n              </FormGroup>\r\n            </FormControl>\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1401\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1401</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear01(!year01)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1402\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1402</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear02(!year02)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1403\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1403</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear03(!year03)}\r\n\r\n                />\r\n              </FormGroup>\r\n            </FormControl>\r\n            <br />\r\n            <br />\r\n            <br />\r\n            <br />\r\n\r\n          </item>\r\n        </Col>\r\n        <Col item xs={4} md={4} >\r\n       \r\n          <ResponsiveContainer width=\"100%\" height=\"100%\">\r\n        <PieChart width={400} height={400}>\r\n          <Pie\r\n            data={data}\r\n            cx=\"50%\"\r\n            cy=\"50%\"\r\n            labelLine={false}\r\n            label={renderCustomizedLabel}\r\n            outerRadius={120}\r\n            fill=\"#8884d8\"\r\n            dataKey=\"value\"\r\n          >\r\n            {data.map((entry, index) => (\r\n              <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />\r\n            ))}\r\n          </Pie>\r\n        </PieChart>\r\n      </ResponsiveContainer>\r\n\r\n        </Col>\r\n        \r\n\r\n      </Row>\r\n</Box>\r\n<br/>\r\n<Box sx={{backgroundColor:'#fff' ,width:'100%',padding:1, textAlign:'center',right:0,left:0,alignItems:'center', alignContent:'center'}}>\r\n\r\n      <TableContainer style={{ width: 1000, margin: 'auto', borderRadius:15 }}  >\r\n              <Table sx={{ maxWidth: '100%'}} aria-label=\"customized table\">\r\n                <TableHead >\r\n                  <TableRow >\r\n                    <StyledTableCell style={{backgroundColor:'#0C7075'}}><span className='titlegrid'>نام مشترک</span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>  مصرف بار راکتیو </span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'> قدرت دیماند محاسبه شده  </span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>  ضریب جبرات بار راکتیو </span></StyledTableCell>\r\n\r\n\r\n\r\n\r\n                  </TableRow>\r\n                </TableHead>\r\n                <TableBody style={{ textAlign: 'right' }}>\r\n                  {prebill?.map((row) => (\r\n                    <StyledTableRow key={row._id}>\r\n                      <StyledTableCell style={{ textAlign: 'right' }}><span className='normaltxt'>{row.name}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.consumptionDemand}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.ractiveTotalConsumption}</span></StyledTableCell  >\r\n                      <StyledTableCell><span className='normaltxt'>{(row.ractiveTotalConsumption/row.consumptionDemand).toFixed(2)}</span></StyledTableCell>    \r\n                      </StyledTableRow >\r\n                  ))}\r\n                </TableBody>\r\n              </Table>\r\n            </TableContainer>\r\n            </Box>\r\n</Container>\r\n            </Box>\r\n    </ThemeProvider>\r\n  )\r\n}\r\n\r\nexport default BillScreen\r\n","/Users/macbook/project/alpasoft/frontend/src/screens/HomeScreen.js",["450","451","452","453","454","455","456","457","458","459","460","461"],"import React, { useState, u