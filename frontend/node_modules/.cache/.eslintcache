            value=\"1\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>فروردین</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setFar(!far)}\r\n\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"2\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اردیبهشت</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setOrd(!ord)}\r\n                />\r\n                <FormControlLabel\r\n                  value=\"3\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>خرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setKho(!kho)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>تیر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setTir(!tir)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMor(!mor)}\r\n                />    \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>شهریور</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setSha(!sha)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مهر</span>}\r\n         