TableCell = styled(TableCell)(({ theme }) => ({\r\n  [`&.${tableCellClasses.head}`]: {\r\n    backgroundColor: theme.palette.common.black,\r\n    color: theme.palette.common.white,\r\n  },\r\n  [`&.${tableCellClasses.body}`]: {\r\n    fontSize: 14,\r\n  },\r\n}));\r\nconst drawerWidth = 300;\r\n\r\nconst Drawer = styled(MuiDrawer, { shouldForwardProp: (prop) => prop !== 'open' })(\r\n  ({ theme, open }) => ({\r\n    '& .MuiDrawer-paper': {\r\n      position: 'relative',\r\n      whiteSpace: 'nowrap',\r\n      width: drawerWidth,\r\n      transition: theme.transitions.create('width', {\r\n        easing: theme.transitions.easing.sharp,\r\n        duration: theme.transitions.duration.enteringScreen,\r\n      }),\r\n      boxSizing: 'border-box',\r\n      ...(!open && {\r\n        overflowX: 'hidden',\r\n        transition: theme.transitions.create('width', {\r\n          easing: theme.transitions.easing.sharp,\r\n          duration: theme.transitions.duration.leavingScreen,\r\n        }),\r\n        width: theme.spacing(7),\r\n        [theme.breakpoints.up('sm')]: {\r\n          width: theme.spacing(9),\r\n        },\r\n      }),\r\n    },\r\n  }),\r\n);\r\n\r\nconst StyledTableRow = styled(TableRow)(({ theme }) => ({\r\n  '&:nth-of-type(odd)': {\r\n    backgroundColor: theme.palette.action.hover,\r\n  },\r\n  // hide last border\r\n  '&:last-child td, &:last-child th': {\r\n    border: 0,\r\n  },\r\n}));\r\nconst Item = styled(Paper)(({ theme }) => ({\r\n  backgroundColor: theme.palette.mode === 'dark' ? '#1A2027' : '#fff',\r\n  ...theme.typography.body2,\r\n  padding: theme.spacing(1),\r\n  textAlign: 'center',\r\n  color: theme.palette.text.secondary,\r\n}));\r\nconst data = [\r\n  { name: 'Group A', value: 100 },\r\n  { name: 'Group B', value: 400 },\r\n  { name: 'Group C', value: 170 },\r\n];\r\n\r\nconst COLORS = [ '#00C49F', '#FFBB28', '#FF8042'];\r\n\r\nconst RADIAN = Math.PI / 180;\r\nconst renderCustomizedLabel = ({ cx, cy, midAngle, innerRadius, outerRadius, percent, index }) => {\r\n  const radius = innerRadius + (outerRadius - innerRadius) * 0.5;\r\n  const x = cx + radius * Math.cos(-midAngle * RADIAN);\r\n  const y = cy + radius * Math.sin(-midAngle * RADIAN);\r\n\r\n  return (\r\n    <text x={x} y={y} fill=\"white\" textAnchor={x > cx ? 'start' : 'end'} dominantBaseline=\"central\">\r\n      {`${(percent * 100).toFixed(0)}%`}\r\n    </text>\r\n  );\r\n};\r\n\r\nconst style = {\r\n  top: '50%',\r\n  right: 0,\r\n  transform: 'translate(0, -50%)',\r\n  lineHeight: '14px',\r\n};\r\nfunction BillScreen({ match, history }) {\r\n  const [open, setOpen] = React.useState(true);\r\n  const toggleDrawer = () => {\r\n    setOpen(!open);\r\n  };\r\n  const dispatch = useDispatch()\r\n\r\n  const listBills = useSelector(state => state.listBill)\r\n  const { error, loading, bills } = listBills\r\n  let prebill=[]\r\n\r\n  const [far, setFar] =  React.useState(false);\r\n  const [ord, setOrd] = React.useState(true);\r\n  const [kho, setKho] = React.useState(false);\r\n  const [tir, setTir] = React.useState(false);\r\n  const [mor, setMor] = React.useState(false);\r\n  const [sha, setSha] = React.useState(false);\r\n  const [meh, setMeh] = React.useState(false);\r\n  const [aba, setAba] = React.useState(false);\r\n  const [aza, setAza] = React.useState(false);\r\n  const [dey, setDey] = React.useState(false);\r\n  const [bah, setBah] = React.useState(false);\r\n  const [esf, setEsf] = React.useState(false);\r\n\r\n  const [year01, setYear01] = React.useState(false);\r\n  const [year02, setYear02] = React.useState(false);\r\n  const [year03, setYear03] = React.useState(false);\r\n\r\n  prebill = bills?.filter((bill) => ((far? bill.month==1 : null) || (ord? bill.month==2 : null)  || (kho? bill.month==3 : null)  || (tir? bill.month==4 : null) || (mor? bill.month==5 : null)|| (sha? bill.month==6 : null)|| (meh? bill.month==7 : null)|| (aba? bill.month==8 : null)|| (aza? bill.month==9 : null)|| (dey? bill.month==10 : null) || (bah? bill.month==11 : null) || (esf? bill.month==12 : null) || (year01? bill.year==1401 : null) || (year02? bill.year==1402 : null) || (year03? bill.year==1403 : null)   ))\r\n\r\n  useEffect(() => {\r\n    dispatch(fetchbills())\r\n\r\n  }, [dispatch,far,ord,year01])\r\n\r\n\r\n  const defaultTheme = createTheme();\r\n\r\n  return (\r\n      <ThemeProvider theme={defaultTheme}>\r\n\r\n\r\n<Box sx={{ display: 'flex' }}>\r\n\r\n   <Drawer variant=\"permanent\" open={open}>\r\n     <Toolbar\r\n       sx={{\r\n         display: 'flex',\r\n         alignItems: 'center',\r\n         justifyContent: 'flex-end',\r\n         backgroundColor:'#0C7075',\r\n         px: [1],\r\n       }}\r\n     >\r\n       <IconButton  onClick={toggleDrawer}>\r\n       <span className='linkwhite'>استان  </span>  <ChevronLeftIcon />\r\n       </IconButton>\r\n     </Toolbar>\r\n     <Divider />\r\n     <List component=\"nav\">\r\n       {mainListItems}\r\n       <Divider sx={{ my: 1 }} />\r\n     </List>\r\n   </Drawer>\r\n   <Container maxWidth=\"lg\" sx={{ mt: 4, mb: 4 }}>\r\n\r\n    <Box sx={{backgroundColor:'#fff',boxShadow:5,height:350, width:'100%',padding:1,borderRadius:5}}>\r\n\r\n <Row >\r\n        <Col  xs={8} md={8}>\r\n          <item>\r\n            <h1>  ساعت کارکرد دیماند ماکزیمم</h1>\r\n            <span className='normaltxt'>فرمودل : مصرف کل*30 / قدرت دیماند محاسبه *تعداد روز</span>\r\n\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>فروردین</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setFar(!far)}\r\n\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"2\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اردیبهشت</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setOrd(!ord)}\r\n                />\r\n                <FormControlLabel\r\n                  value=\"3\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>خرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setKho(!kho)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>تیر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setTir(!tir)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مرداد</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMor(!mor)}\r\n                />    \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>شهریور</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setSha(!sha)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>مهر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setMeh(!meh)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آبان</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAba(!aba)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>آذر</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setAza(!aza)}\r\n                />  \r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>دی</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setDey(!dey)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>بهمن</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setBah(!bah)}\r\n                />\r\n                  <FormControlLabel\r\n                  value=\"4\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>اسفند</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setEsf(!esf)}\r\n                />       \r\n              </FormGroup>\r\n            </FormControl>\r\n            <hr />\r\n            <FormControl component=\"fieldset\">\r\n              <FormGroup aria-label=\"position\" row>\r\n                <FormControlLabel\r\n                  value=\"1401\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1401</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear01(!year01)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1402\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1402</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear02(!year02)}\r\n\r\n                />\r\n                <FormControlLabel\r\n                  value=\"1403\"\r\n                  control={<Checkbox />}\r\n                  label={<span className='normaltxt'>1403</span>}\r\n                  labelPlacement=\"bottom\"\r\n                  onChange={() => setYear03(!year03)}\r\n\r\n                />\r\n              </FormGroup>\r\n            </FormControl>\r\n            <br />\r\n            <br />\r\n            <br />\r\n            <br />\r\n\r\n          </item>\r\n        </Col>\r\n        <Col item xs={4} md={4} >\r\n       \r\n          <ResponsiveContainer width=\"100%\" height=\"100%\">\r\n        <PieChart width={400} height={400}>\r\n          <Pie\r\n            data={data}\r\n            cx=\"50%\"\r\n            cy=\"50%\"\r\n            labelLine={false}\r\n            label={renderCustomizedLabel}\r\n            outerRadius={120}\r\n            fill=\"#8884d8\"\r\n            dataKey=\"value\"\r\n          >\r\n            {data.map((entry, index) => (\r\n              <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />\r\n            ))}\r\n          </Pie>\r\n        </PieChart>\r\n      </ResponsiveContainer>\r\n\r\n        </Col>\r\n        \r\n\r\n      </Row>\r\n</Box>\r\n<br/>\r\n<Box sx={{backgroundColor:'#fff' ,width:'100%',padding:1, textAlign:'center',right:0,left:0,alignItems:'center', alignContent:'center'}}>\r\n\r\n      <TableContainer style={{ width: 1000, margin: 'auto', borderRadius:15 }}  >\r\n              <Table sx={{ maxWidth: '100%'}} aria-label=\"customized table\">\r\n                <TableHead >\r\n                  <TableRow >\r\n                    <StyledTableCell style={{backgroundColor:'#0C7075'}}><span className='titlegrid'>نام مشترک</span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>قدرت دیماند محاسبه</span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>مصرف کل   </span></StyledTableCell>\r\n                    <StyledTableCell style={{ backgroundColor:'#0C7075'}}><span className='titlegrid'>  ساعت کارکرد دیماند ماکزیمم </span></StyledTableCell>\r\n\r\n\r\n\r\n\r\n                  </TableRow>\r\n                </TableHead>\r\n                <TableBody style={{ textAlign: 'right' }}>\r\n                  {prebill?.map((row) => (\r\n                    <StyledTableRow key={row._id}>\r\n                      <StyledTableCell style={{ textAlign: 'right' }}><span className='normaltxt'>{row.name}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.calculationlDemand}</span></StyledTableCell  >\r\n                      <StyledTableCell  ><span className='normaltxt'>{row.activeTotalConsumption}</span></StyledTableCell  >\r\n                      <StyledTableCell><span className='normaltxt'>{((row.activeTotalConsumption*30)/(row.calculationlDemand*row.dayNum)).toFixed(2)}</span></StyledTableCell>    \r\n                      </StyledTableRow >\r\n                  ))}\r\n                </TableBody>\r\n              </Table>\r\n            </TableContainer>\r\n            </Box>\r\n</Container>\r\n            </Box>\r\n    </ThemeProvider>\r\n  )\r\n}\r\n\r\nexport default BillScreen\r\n","/Users/macbook/project/alpasoft/frontend/src/components/Loader.js",[],"/Users/macbook/project/alpasoft/frontend/src/components/Chart.js",["532","533"],"import React from 'react';\nimport ReactSpeedometer from \"react-d3-speedometer\";\nimport { Row, Col, Container } from 'react-bootstrap'\nimport { BarPlot,BarChart  } from '@mui/x-charts/BarChart';\nimport { LinePlot } from '@mui/x-charts/LineChart';\nimport { ChartContainer } from '@mui/x-charts/ChartContainer';\n\nimport { ChartsXAxis } from '@mui/x-charts/ChartsXAxis';\nimport { ChartsYAxis } from '@mui/x-charts/ChartsYAxis';\n\nconst series = [\n  {\n    type: 'bar',\n    stack: '',\n    yAxisKey: 'eco',\n    data: [2, 5, 3, 4, 1],\n  },\n  {\n    type: 'bar',\n    stack: '',\n    yAxisKey: 'eco',\n    data: [5, 6, 2, 8, 9],\n  },\n  {\n    type: 'line',\n    yAxisKey: 'pib',\n    color: 'red',\n    data: [1000, 1500, 3000, 5000, 10000],\n  },\n];\nconst GaugeChart = () => {\n   \n        const textColor = '#AAA'\n\n        return (\n            <Container>\n          <Row\n     \n        >\n          <Col style={{textAlign:'center',alignItems:'center'}} xs={6} sm={6} md={6} lg={6} xl={6}>\n          <ChartContainer\n      series={series}\n      width={500}\n      height={300}\n      xAxis={[\n        {\n          id: 'years',\n          data: [2010, 2011, 2012, 2013, 2014],\n          scaleType: 'band',\n          valueFormatter: (value) => value.toString(),\n        },\n      ]}\n      yAxis={[\n        {\n          id: 'eco',\n          scaleType: 'linear',\n        },\n        {\n          id: 'pib',\n          scaleType: 'log',\n        },\n      ]}\n    >\n      <BarPlot />\n      <LinePlot />\n      <ChartsXAxis label=\"Years\" position=\"bottom\" axisId=\"years\" />\n      <ChartsYAxis label=\"Results\" position=\"left\" axisId=\"eco\" />\n      <ChartsYAxis label=\"PIB\" position=\"right\" axisId=\"pib\" />\n    </ChartContainer>\n          </Col>\n          \n          \n          <Col  style={{textAlign:'center',alignItems:'center'}}  xs={6} sm={6} md={6} lg={6} xl={6}>\n          <BarChart\n      xAxis={[{ scaleType: 'band', data: ['group A', 'group B', 'group C'] }]}\n      series={[{ data: [4, 3, 5] }, { data: [1, 6, 3] }, { data: [2, 5, 6] }]}\n      width={500}\n      height={300}\n    />\n        </Col>\n        </Row></Container>\n        );\n};\n\nexport default GaugeChart;","/Users/macbook/project/alpasoft/frontend/src/components/Message.js",[],"/Users/macbook/project/alpasoft/frontend/src/components/listItems.js",["534","535","536","537","538"],"import * as React from 'react';\nimport ListItemButton from '@mui/material/ListItemButton';\nimport ListItemIcon from '@mui/material/ListItemIcon';\nimport ListItemText from '@mui/material/ListItemText';\nimport ListSubheader from '@mui/material/ListSubheader';\nimport DashboardIcon from '@mui/icons-material/Dashboard';\nimport ShoppingCartIcon from '@mui/icons-material/ShoppingCart';\nimport PeopleIcon from '@mui/icons-material/People';\nimport BarChartIcon from '@mui/icons-material/BarChart';\nimport LayersIcon from '@mui/icons-material/Layers';\nimport AssignmentIcon from '@mui/icons-material/Assignment';\nimport { Button } from 'react-bootstrap';\nimport { Link } from 'react-router-dom'\nimport Box from '@mui/material/Box';\n\nexport const mainListItems = (\n  <Box sx={{boxShadow:4, backgroundColor:'#0C7075', borderRadius:5}} >\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <DashboardIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/\"> داشبورد</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <PeopleIcon /> \n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/upload\"> بارگذاری قبوض</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <PeopleIcon /> \n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/uploadwater\"> تولید آب </Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <BarChartIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/consumptionCoefficient\">ضریب مصرف</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/demandCoefficient\">ضریب دیماند</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <PeopleIcon /> \n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/barCoefficient\"> ضریب بار</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <BarChartIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/baraverageCoefficient\">  ضریب بار متوسط</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/barLimitCoefficient\"> ضریب بار حدی</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <PeopleIcon /> \n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/barCompensationCoefficient\"> ضریب جبران بار راکتیو</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <BarChartIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/barCompensationCoefficientActive\"> ضریب جبران بار راکتیو فعال</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> ساعت کارکرد دیماند ماکزیمم</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> درصد استفاده در پیک بار</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> درصد استفاده در میان باری </Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> درصد استفاده در کم باری </Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> سهم هزینه برق مصرفی</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> سهم هزینه انرژی مصرفی</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> میانگین هزینه برق</Link>\n    </ListItemButton>\n    <ListItemButton>\n      <ListItemIcon style={{color:'#fff'}}>\n        <LayersIcon />\n      </ListItemIcon>\n      <Link  className='linkwhite' to=\"/MaximunDemand\"> میانگین هزینه انرژی</Link>\n    </ListItemButton>\n  </Box>\n);\n\n","/Users/macbook/project/alpasoft/frontend/src/constants/BillConstatns.js",[],"/Users/macbook/project/alpasoft/frontend/src/constants/userConstants.js",[],"/Users/macbook/project/alpasoft/frontend/src/actions/billActions.js",[],"/Users/macbook/project/alpasoft/frontend/src/actions/userActions.js",[],"/Users/macbook/project/alpasoft/frontend/src/utils/axiosInstance.js",[],"/Users/macbook/project/alpasoft/frontend/src/components/Orders.js",["539","540","541","542","543"],"import React, { useState, useEffect } from 'react'\nimport { useDispatch, useSelector } from 'react-redux';\nimport { Link } from 'react-router-dom'\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport Title from './Title';\nimport { fetchbills } from '../actions/billActions'\n\n// Generate Order Data\nfunction createData(id, date, name, shipTo, paymentMethod, amount) {\n  return { id, date, name, shipTo, paymentMethod, amount };\n}\n\nconst rows = [\n  createData(\n    0,\n    '16 Mar, 2019',\n    'Elvis Presley',\n    'Tupelo, MS',\n    'VISA ⠀•••• 3719',\n    312.44,\n  ),\n  createData(\n    1,\n    '16 Mar, 2019',\n    'Paul McCartney',\n    'London, UK',\n    'VISA ⠀•••• 2574',\n    866.99,\n  ),\n  createData(2, '16 Mar, 2019', 'Tom Scholz', 'Boston, MA', 'MC ⠀•••• 1253', 100.81),\n  createData(\n    3,\n    '16 Mar, 2019',\n    'Michael Jackson',\n    'Gary, IN',\n    'AMEX ⠀•••• 2000',\n    654.39,\n  ),\n  createData(\n    4,\n    '15 Mar, 2019',\n    'Bruce Springsteen',\n    'Long Branch, NJ',\n    'VISA ⠀•••• 5919',\n    212.79,\n  ),\n];\n\nfunction preventDefault(event) {\n  event.preventDefault();\n}\n\nexport default function Orders({history}) {\n  const dispatch = useDispatch()\n\n  const listBills = useSelector(state => state.listBill)\n  const { error, loading, bills } = listBills\n\n  const userLogin = useSelector(state => state.userLogin)\n  const { userInfo } = userLogin\n  useEffect(() => {\n    dispatch(fetchbills())\n\n}, [ dispatch])\n  return (\n    <React.Fragment>\n      <Title><h4>آخرین قبوض</h4></Title>\n      <Table   size=\"small\">\n        <TableHead  style={{textAlign:'right'}}>\n          <TableRow className='titlegrid'>\n            <TableCell ><span className='titlegrid'>نام مشترک</span></TableCell>\n            <TableCell><span className='titlegrid'>تعداد روز</span></TableCell>\n            <TableCell><span className='titlegrid'>پرباری</span></TableCell>\n            <TableCell><span className='titlegrid'>میان باری</span></TableCell>\n            <TableCell><span className='titlegrid'>کم باری</span></TableCell>\n            <TableCell><span className='titlegrid'>دیماند مصرفی  </span></TableCell>\n            <TableCell><span className='titlegrid'>دیماند محاسباتی  </span></TableCell>\n            <TableCell><span className='titlegrid'>مبلغ کل     </span></TableCell>\n            <TableCell><span className='titlegrid'>رمز رایانه   </span></TableCell>\n\n\n          </TableRow>\n        </TableHead>\n        <TableBody>\n          {bills?.map((row) => (\n            <TableRow key={row._id}>\n              <TableCell><Link to={`/bill/${row._id}`}><span className='normaltxt'>{row.name}</span></Link></TableCell>\n              <TableCell><span className='normaltxt'>{row.dayNum}</span></TableCell>\n              <TableCell><span className='normaltxt'>{row.medium}</span></TableCell>\n              <TableCell><span className='normaltxt'>{row.low}</span></TableCell>             \n              <TableCell><span className='normaltxt'>{row.high}</span></TableCell>\n              <TableCell><span className='normaltxt'>{row.consumptionDemand}</span></TableCell>             \n              <TableCell><span className='normaltxt'>{row.calculationlDemand}</span></TableCell>\n              <TableCell><span className='normaltxt'>{row.totalAmount}</span></TableCell>\n              <TableCell><span className='normaltxt'>{row.passCom}</span></TableCell>\n            </TableRow>\n          ))}\n        </TableBody>\n      </Table>\n      <Link color=\"primary\" href=\"#\" onClick={preventDefault} sx={{ mt: 3 }}>\n       نمایش بیشتر\n      </Link>\n    </React.Fragment>\n  );\n}\n","/Users/macbook/project/alpasoft/frontend/src/components/Title.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/UploadWaterScreen.js",["544","545","546","547"],"import React, { useState } from \"react\";  \r\nimport { read, utils, writeFile } from 'xlsx';\r\nimport { useSelector, useDispatch } from 'react-redux'\r\n\r\nimport Grid from \"@mui/material/Grid\";\r\nimport Card from \"@mui/material/Card\";\r\nimport axios from 'axios';\r\nimport { Container, Link, TextField } from \"@mui/material\";\r\nimport Button from '@mui/material/Button'; \r\nimport template from '../templatewater.xlsx'\r\nimport InputLabel from '@mui/material/InputLabel';\r\nimport MenuItem from '@mui/material/MenuItem';\r\nimport FormControl from '@mui/material/FormControl';\r\nimport Select from '@mui/material/Select';\r\nconst HomeComponent = ({history}) => {\r\n    const [billInfo, setBillInfo] = useState([]);\r\n    const [month, setMonth] = useState('')\r\n    const [year, setYear] = useState('')\r\n    const userLogin = useSelector(state => state.userLogin)\r\n    const { userInfo } = userLogin\r\n    const handleImport = ($event) => {\r\n        const files = $event.target.files;\r\n        if (files.length) {\r\n            const file = files[0];\r\n            const reader = new FileReader();\r\n            reader.onload = (event) => {\r\n                const wb = read(event.target.result);\r\n                const sheets = wb.SheetNames;\r\n\r\n                if (sheets.length) {\r\n                    const rows = utils.sheet_to_json(wb.Sheets[sheets[0]]);\r\n                    setBillInfo(rows)\r\n\r\n                }\r\n            }\r\n            reader.readAsArrayBuffer(file);\r\n        }\r\n    }\r\n\r\n    const handleExport = () => {\r\n      sendJsonDataToBackend(billInfo);\r\n      history.push('/')\r\n\r\n    }\r\n    const sendJsonDataToBackend = async (billInfo) => {\r\n      try {\r\n        const config = {// request setting\r\n          header: {\r\n              'Content-type': 'application/json'\r\n          }\r\n      }\r\n      console.log(userInfo.id)\r\n        await axios.post('/api/v1/waterbill/upload/',  { data: billInfo, month:month,year:year,state:1},config);\r\n        console.log('JSON data sent to the backend successfully.');\r\n      } catch (error) {\r\n        console.error('Error sending JSON data to the backend:', error);\r\n      }\r\n    };\r\n    const handleChangemonth = (event) => {\r\n        setMonth(event.target.value);\r\n      };\r\n      const handleChangeyear = (event) => {\r\n        setYear(event.target.value);\r\n      };\r\n    return (\r\n        <Container>\r\n          <Grid container spacing={3} style={{direction:'rtl'}}>\r\n         \r\n                <Grid item xs={12}  md={12} xl={12}>\r\n                <span className=\"linkblack\">لطفا قبل از بارگذاری فایل، فایل نمونه را دانلود و اطلاعات را در آن کپی و سپس بارگذاری نمایید.</span>  \r\n\r\n                <a\r\n  href={template}\r\n  download=\"Example-PDF-document\"\r\n  target=\"_blank\"\r\n  rel=\"noopener noreferrer\"\r\n>\r\n  <Button variant=\"outlined\"><span className=\"linkblack\">دانلود اکسل نمونه</span></Button>\r\n</a>\r\n                <Card style={{alignItems:'right', textAlign:'right',marginTop:2, padding:4}}>\r\n                   \r\n                <span className=\"linkblack\">انتخاب فایل: </span>  \r\n                <input type=\"file\" name=\"file\" className=\"custom-file-input\" id=\"inputGroupFile\" required onChange={handleImport}\r\n                        accept=\".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel\" sx={{border:2}}/>\r\n               <br/>\r\n    \r\n     <FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\r\n     <InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب ماه</span></InputLabel>\r\n     <Select\r\n       labelId=\"demo-select-small-label\"\r\n       id=\"demo-select-small\"\r\n       value={month}\r\n       label=\"ماه\"\r\n       onChange={handleChangemonth}\r\n     >\r\n       <MenuItem value=\"\">\r\n         <em>None</em>\r\n       </MenuItem>\r\n       <MenuItem value={1}><span className='normaltxt'>فروردین</span></MenuItem>\r\n       <MenuItem value={2}><span className='normaltxt'>اردیبهشت</span></MenuItem>\r\n       <MenuItem value={3}><span className='normaltxt'>خرداد</span></MenuItem>\r\n       <MenuItem value={4}><span className='normaltxt'>تیر</span></MenuItem>\r\n       <MenuItem value={5}><span className='normaltxt'>مرداد</span></MenuItem>\r\n       <MenuItem value={6}><span className='normaltxt'>شهریور</span></MenuItem>\r\n       <MenuItem value={7}><span className='normaltxt'>مهر</span></MenuItem>\r\n       <MenuItem value={8}><span className='normaltxt'>آبان</span></MenuItem>\r\n       <MenuItem value={9}><span className='normaltxt'>آذر</span></MenuItem>\r\n       <MenuItem value={10}><span className='normaltxt'>دی</span></MenuItem>\r\n       <MenuItem value={11}><span className='normaltxt'>بهمن</span></MenuItem>\r\n       <MenuItem value={12}><span className='normaltxt'>اسفند</span></MenuItem>\r\n     </Select>\r\n   </FormControl>\r\n        \r\n      &nbsp;&nbsp;\r\n      <FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\r\n     <InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب سال</span> </InputLabel>\r\n     <Select\r\n       labelId=\"demo-select-small-label\"\r\n       id=\"demo-select-small\"\r\n       value={year}\r\n       label=\"<span className='titlegrid'>سال</span>\"\r\n       onChange={handleChangeyear}\r\n     >\r\n       <MenuItem value=\"\">\r\n         <em>None</em>\r\n       </MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1401</span></MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1402</span></MenuItem>\r\n       <MenuItem value={1401}><span className='normaltxt'>1403</span></MenuItem>\r\n\r\n     </Select>\r\n   </FormControl>\r\n\r\n                <hr/>\r\n                <span className=\"linkblack\">در صورت تایید اطلاعات، به پایگاه داده منتقل نمایید\r\n</span>\r\n                <Button onClick={handleExport} variant=\"contained\"><span className='linkwhite'>ارسال فایل <i className=\"fa fa-download\"></i></span> \r\n                            </Button>\r\n            </Card>\r\n                </Grid>\r\n                <Grid item xs={12}  md={12} xl={12}>\r\n                <Card style={{alignItems:'center', textAlign:'center',marginTop:2}}>\r\n            <div className=\"row\">\r\n                <div className=\"col-lg-12 offset-3\">\r\n                    <table className=\"table\">\r\n                        <thead>\r\n                            <tr>\r\n                            <th scope=\"col\"><span className='titlegrid'>ردیف </span></th>\r\n\r\n                           <th scope=\"col\"><span className='titlegrid'>نام مشترک</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>جمع تولید آب</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>جمع ساعت</span></th>\r\n                           <th scope=\"col\"><span className='titlegrid'>شماره اشتراک    </span></th>\r\n   \r\n\r\n\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody> \r\n                                {\r\n                                    billInfo.length\r\n                                    ?\r\n                                    billInfo.map((movie, index) => (\r\n                                        <tr key={index}>\r\n                                            <th scope=\"row\">{ index + 1 }</th>\r\n                                            <td><span className='normaltxt'>{movie.name}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.totalProduction}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.totalHours}</span></td>\r\n                                            <td><span className='normaltxt'>{movie.passCom}</span></td>\r\n                                        </tr> \r\n                                    ))\r\n                                    :\r\n                                    <tr>\r\n                                        <td colSpan=\"5\" className=\"text-center\"><span className=\"normaltxt\">در حال حاظر قبضی بارگذاری نشده است</span></td>\r\n                                    </tr> \r\n                                }\r\n                        </tbody>\r\n                    </table>\r\n                </div>\r\n                </div>\r\n                </Card>\r\n                </Grid>\r\n                </Grid>\r\n            </Container>\r\n\r\n    );\r\n};\r\n\r\nexport default HomeComponent;\r\n","/Users/macbook/project/alpasoft/frontend/src/components/NavigationBar.js",["548","549","550","551"],"import { useState, useEffect } from 'react'\nimport React from 'react'\nimport { Navbar, Nav, Container, Row, NavDropdown, Col } from 'react-bootstrap'\nimport { LinkContainer } from 'react-router-bootstrap'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { userLogoutAction } from '../actions/userActions'\nimport { NavLink, Button } from 'react-bootstrap';\nimport { useNavigate } from 'react-router-dom'\nimport UploadElectBill from './UploadElectBill'\n\nfunction NavigationBar(props) {\n    let navigate = useNavigate()\n\n    const userLogin = useSelector(state => state.userLogin)\n    const { userInfo } = userLogin\n    const dispatch = useDispatch()\n\n    const logoutHandler = () => {\n        dispatch(userLogoutAction())\n        navigate(\"/\")\n\n\n    }\n    const [showuploadelectbillmodal, setShowuploadelectbillmodal] = useState(false);\n    const uploadelectbillhandle =()=>{\n        setShowuploadelectbillmodal(true)\n    }\n\n    return (\n        <>\n            <Navbar bg=\"dark\" variant=\"light\" data-bs-theme=\"dark\" style={{ direction: 'rtl', height: \"60px\", }}>\n                <Container fluid>\n                    <Nav className=\"ml-auto\">\n                        <LinkContainer to=\"/\" style={{ marginLeft: '50px' }}>\n                            <Navbar.Brand className=\"nav-item\">\n                                <h1 className='py-2'>سیستم مدیریت کنترل قبوض آلپاسافت\n                                   ( {userInfo ? userInfo.name : null}) \n                                </h1>\n                            </Navbar.Brand>\n                        </LinkContainer>\n\n                        <LinkContainer to=\"/companies\" style={{borderLeft:'1px solid white'}}>\n                            <NavLink className='navlink'>مشترکین</NavLink>\n                        </LinkContainer>\n                        <LinkContainer to=\"/formulascreen\" style={{borderLeft:'1px solid white'}}>\n                            <NavLink className='navlink'>شاخص های عملکرد انرزی</NavLink>\n                        </LinkContainer>\n                        <NavDropdown style={{borderLeft:'1px solid white'}}\n                            title={<span className='navlink'>بارگذاری قبوض</span>}\n\n                        >\n                            <NavDropdown.Item >\n                                <NavLink className='navitem' onClick={uploadelectbillhandle}>قبض برق</NavLink>\n                            </NavDropdown.Item>\n                            <NavDropdown.Item>\n                                <NavLink className='navitem'>قبض آب</NavLink>\n                            </NavDropdown.Item>\n                        </NavDropdown>\n\n                    </Nav>\n\n                    <Nav >\n                        {userInfo &&\n                            <>\n                                <NavDropdown style={{ paddingLeft: '60px' }}\n                                    className='navlink'\n                                    title={<span className='navlink'>تنظیمات </span>}\n\n                                >\n                                    <NavDropdown.Item>\n                                        <NavLink onClick={logoutHandler} className='navitem'>خروج</NavLink>\n                                    </NavDropdown.Item>\n                                </NavDropdown>\n                            </>\n                        }\n\n                        {!userInfo &&\n                            <LinkContainer to=\"/login\">\n                                <NavLink>Login</NavLink>\n                            </LinkContainer>\n                        }\n                    </Nav>\n                </Container>\n            </Navbar>\n            {showuploadelectbillmodal &&\n                <UploadElectBill showuploadelectbillmodal={showuploadelectbillmodal} setShowuploadelectbillmodal={setShowuploadelectbillmodal} />\n            }\n        </>\n    )\n\n}\n\nexport default NavigationBar;\n","/Users/macbook/project/alpasoft/frontend/src/screens/FormulaScreen.js",["552","553","554","555","556"],"import Nav from 'react-bootstrap/Nav';\nimport Tab from 'react-bootstrap/Tab';\nimport { Row, Col, Image, ListGroup, Button, Container } from 'react-bootstrap'\nimport Form from 'react-bootstrap/Form';\nimport { useEffect, useState } from 'react';\nimport axios from 'axios'\nimport ConsumptionCoefficient from './ConsumptionCoefficient'\nimport DemandCoefficient from './DemandCoefficient'\n\nexport default function FormulaScreen(props) {\n  const [dataList, setDataList] = useState([]);\n  const [far, setFar] = useState(false);\n  const [ord, setOrd] = useState(true);\n  const [kho, setKho] = useState(false);\n  const [tir, setTir] = useState(false);\n  const [mor, setMor] = useState(false);\n  const [sha, setSha] = useState(false);\n  const [meh, setMeh] = useState(false);\n  const [aba, setAba] = useState(false);\n  const [aza, setAza] = useState(false);\n  const [dey, setDey] = useState(false);\n  const [bah, setBah] = useState(false);\n  const [esf, setEsf] = useState(false);\n\n  const [year01, setYear01] = useState(false);\n  const [year02, setYear02] = useState(false);\n  const [year03, setYear03] = useState(false);\n  useEffect(() => {\n    axios.get('/api/v1/electbill/').then(res => {\n      console.log(res)\n      setDataList(res['data'])\n      console.log(dataList[0])\n    })\n\n  }, [])\n  return (\n    <Container>\n      <div style={{ direction: 'rtl', marginTop: '50px' }}>\n\n\n\n        <Tab.Container id=\"left-tabs-example\" defaultActiveKey=\"consumptioncoefficient\">\n\n          <Row>\n            <Col sm={3}>\n              <Nav className=\"nav-links flex-column\" style={{ width: '300px' }}>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"consumptioncoefficient\" className=\"nav-links\">ضریب مصرف</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"demandcoefficient\" className=\"nav-links\">ضریب دیماند</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"barcoefficient\" className=\"nav-links\">ضریب بار</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"baraveragecoefficient\" className=\"nav-links\">ضریب بار متوسط</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"barlimitcoefficient\" className=\"nav-links\">ضریب بار حدی</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"barlimitcoefficient\" className=\"nav-links\">ضریب جبران بار اکتیو</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"barlimitcoefficient\" className=\"nav-links\">ضریب جبران باراکتیو فعال</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"barlimitcoefficient\" className=\"nav-links\"> کارکرد دیماند ماکزیمم </Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                  <Nav.Link eventKey=\"barlimitcoefficient\" className=\"nav-links\"> درصد استفاده در پیک بار</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                <Nav.Link eventKey=\"barlimitcoefficient\" className=\"nav-links\"> درصد استفاده در میان باری</Nav.Link>\n                </Nav.Item>\n                <Nav.Item style={{ border: '1px solid #0C7075', marginBottom: '8px', borderRadius: '5px' }}>\n                <Nav.Link eventKey=\"barlimitcoefficient\" className=\"nav-links\"> درصد استفاده در کم باری</Nav.Link>\n                </Nav.Item>\n              </Nav>\n              <div style={{ width: '110px', paddingRight: '30px',direction:'ltr' }} className=\"mb-3\">\n                <Form.Check reverse label={<span className='text'>فروردین</span>} inline type=\"checkbox\" onChange={() => setFar(!far)} />\n                <Form.Check label={<span className='text'>اردیبهشت</span>} inline type=\"checkbox\" onChange={() => setOrd(!ord)} />\n                <Form.Check label={<span className='text'>خرداد</span>} inline type=\"checkbox\" onChange={() => setKho(!kho)} />\n                  <Form.Check reverse label={<span className='text'>تیر</span>} inline type=\"checkbox\" onChange={() => setTir(!tir)} />\n                <Form.Check label={<span className='text'>مرداد</span>} inline type=\"checkbox\" onChange={() => setMor(!mor)} />\n              <Form.Check label={<span className='text'>شهریور</span>} inline type=\"checkbox\" onChange={() => setSha(!sha)} />\n              <Form.Check reverse label={<span className='text'>مهر</span>} inline type=\"checkbox\" onChange={() => setMeh(!meh)} />\n                <Form.Check label={<span className='text'>آبان</span>} inline type=\"checkbox\" onChange={() => setAba(!aba)} />\n                <Form.Check label={<span className='text'>آذر</span>} inline type=\"checkbox\" onChange={() => setAza(!aza)} />\n                  <Form.Check reverse label={<span className='text'>دی</span>} inline type=\"checkbox\" onChange={() => setDey(!dey)} />\n                <Form.Check label={<span className='text'>بهمن</span>} inline type=\"checkbox\" onChange={() => setBah(!bah)} />\n              <Form.Check label={<span className='text'>اسفند</span>} inline type=\"checkbox\" onChange={() => setEsf(!esf)} />\n              <hr/>\n              <Form.Check label={<span className='text'>1401</span>} inline type=\"checkbox\" onChange={() => setYear01(!year01)} />\n              <Form.Check label={<span className='text'>1402</span>} inline type=\"checkbox\" onChange={() => setYear03(!year02)} />\n              <Form.Check label={<span className='text'>1403</span>} inline type=\"checkbox\" onChange={() => setYear03(!year03)} />\n\n\n              </div>\n            </Col>\n            <Col sm={9}>\n              <Tab.Content>\n                <Tab.Pane eventKey=\"consumptioncoefficient\">\n                   <ConsumptionCoefficient BillList={dataList}/>\n                </Tab.Pane>\n                <Tab.Pane eventKey=\"demandcoefficient\">\n                  <DemandCoefficient BillList={dataList}/>\n                </Tab.Pane>\n                <Tab.Pane eventKey=\"barcoefficient\">\n                  <DemandCoefficient BillList={dataList}/>\n                </Tab.Pane>\n                <Tab.Pane eventKey=\"baraveragecoefficient\">\n                  <DemandCoefficient BillList={dataList}/>\n                </Tab.Pane>\n                <Tab.Pane eventKey=\"barlimitcoefficient\">\n                  <DemandCoefficient BillList={dataList}/>\n                </Tab.Pane>\n              </Tab.Content>\n            </Col>\n          </Row>\n        </Tab.Container>\n      </div></Container>\n  )\n}","/Users/macbook/project/alpasoft/frontend/src/screens/ConsumptionCoefficient.js",[],"/Users/macbook/project/alpasoft/frontend/src/screens/DemandCoefficient.js",[],"/Users/macbook/project/alpasoft/frontend/src/components/UploadElectBill.js",["557","558","559","560","561"],"import Modal from 'react-bootstrap/Modal';\nimport { Button } from 'react-bootstrap';\nimport { read, utils, writeFile } from 'xlsx';\nimport { useSelector, useDispatch } from 'react-redux'\nimport React, { useState } from \"react\";  \n\nimport Grid from \"@mui/material/Grid\";\nimport Card from \"@mui/material/Card\";\nimport axios from 'axios';\nimport { Container, Link, TextField } from \"@mui/material\";\nimport template from '../template.xlsx'\nimport InputLabel from '@mui/material/InputLabel';\nimport MenuItem from '@mui/material/MenuItem';\nimport FormControl from '@mui/material/FormControl';\nimport Select from '@mui/material/Select';\nexport default function UploadElectBill(props){\n    const showuploadelectbillmodal=props.showuploadelectbillmodal\n    const setShowuploadelectbillmodal=props.setShowuploadelectbillmodal\n    const handleClose=()=>{\n        setShowuploadelectbillmodal(false)\n    }\n    const [billInfo, setBillInfo] = useState([]);\n    const [month, setMonth] = useState('')\n    const [year, setYear] = useState('')\n    const userLogin = useSelector(state => state.userLogin)\n    const { userInfo } = userLogin\n    const handleImport = ($event) => {\n        const files = $event.target.files;\n        if (files.length) {\n            const file = files[0];\n            const reader = new FileReader();\n            reader.onload = (event) => {\n                const wb = read(event.target.result);\n                const sheets = wb.SheetNames;\n\n                if (sheets.length) {\n                    const rows = utils.sheet_to_json(wb.Sheets[sheets[0]]);\n                    setBillInfo(rows)\n\n                }\n            }\n            reader.readAsArrayBuffer(file);\n        }\n    }\n\n    const handleExport = () => {\n      sendJsonDataToBackend(billInfo);\n      setShowuploadelectbillmodal(false)\n\n    }\n    const sendJsonDataToBackend = async (billInfo) => {\n      try {\n        const config = {// request setting\n          header: {\n              'Content-type': 'application/json'\n          }\n      }\n      console.log(userInfo.id)\n        await axios.post('/api/v1/electbill/upload/',  { data: billInfo, month:month,year:year,state:1},config);\n        console.log('JSON data sent to the backend successfully.');\n      } catch (error) {\n        console.error('Error sending JSON data to the backend:', error);\n      }\n    };\n    const handleChangemonth = (event) => {\n        setMonth(event.target.value);\n      };\n      const handleChangeyear = (event) => {\n        setYear(event.target.value);\n      };\n    return(\n\n    <Modal size=\"lg\" show={showuploadelectbillmodal} onHide={e => setShowuploadelectbillmodal(false)}>\n    <Modal.Header closeButton>\n      <Modal.Title><span className='text'>آپلود قبض برق</span></Modal.Title>\n    </Modal.Header>\n    <Modal.Body>\n    <Grid container spacing={3} style={{direction:'rtl'}}>\n         \n         <Grid item xs={12}  md={12} xl={12}>\n         <span className=\"linkblack\">لطفا قبل از بارگذاری فایل، فایل نمونه را دانلود و اطلاعات را در آن کپی و سپس بارگذاری نمایید.</span>  \n\n\n         <a\n         href={template}\n         download=\"Example-PDF-document\"\n         target=\"_blank\"\n         rel=\"noopener noreferrer\"\n       > <Button variant=\"outlined\"><span className=\"linkblack\">دانلود اکسل نمونه</span></Button>\n       </a>\n\n\n\n         <Card style={{alignItems:'right', textAlign:'right',marginTop:2, padding:4}}>\n            \n         <span className=\"linkblack\">انتخاب فایل: </span>  \n         <input type=\"file\" name=\"file\" className=\"custom-file-input\" id=\"inputGroupFile\" required onChange={handleImport}\n                 accept=\".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel\" sx={{border:2}}/>\n        <br/>\n\n<FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\n<InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب ماه</span></InputLabel>\n<Select\nlabelId=\"demo-select-small-label\"\nid=\"demo-select-small\"\nvalue={month}\nlabel=\"ماه\"\nonChange={handleChangemonth}\n>\n<MenuItem value=\"\">\n  <em>None</em>\n</MenuItem>\n<MenuItem value={1}><span className='normaltxt'>فروردین</span></MenuItem>\n<MenuItem value={2}><span className='normaltxt'>اردیبهشت</span></MenuItem>\n<MenuItem value={3}><span className='normaltxt'>خرداد</span></MenuItem>\n<MenuItem value={4}><span className='normaltxt'>تیر</span></MenuItem>\n<MenuItem value={5}><span className='normaltxt'>مرداد</span></MenuItem>\n<MenuItem value={6}><span className='normaltxt'>شهریور</span></MenuItem>\n<MenuItem value={7}><span className='normaltxt'>مهر</span></MenuItem>\n<MenuItem value={8}><span className='normaltxt'>آبان</span></MenuItem>\n<MenuItem value={9}><span className='normaltxt'>آذر</span></MenuItem>\n<MenuItem value={10}><span className='normaltxt'>دی</span></MenuItem>\n<MenuItem value={11}><span className='normaltxt'>بهمن</span></MenuItem>\n<MenuItem value={12}><span className='normaltxt'>اسفند</span></MenuItem>\n</Select>\n</FormControl>\n \n&nbsp;&nbsp;\n<FormControl sx={{ m: 1, minWidth: 120 }} size=\"small\">\n<InputLabel id=\"demo-select-small-label\"><span className='normaltxt'>انتخاب سال</span> </InputLabel>\n<Select\nlabelId=\"demo-select-small-label\"\nid=\"demo-select-small\"\nvalue={year}\nlabel=\"<span className='titlegrid'>سال</span>\"\nonChange={handleChangeyear}\n>\n<MenuItem value=\"\">\n  <em>None</em>\n</MenuItem>\n<MenuItem value={1401}><span className='normaltxt'>1401</span></MenuItem>\n<MenuItem value={1401}><span className='normaltxt'>1402</span></MenuItem>\n<MenuItem value={1401}><span className='normaltxt'>1403</span></MenuItem>\n\n</Select>\n</FormControl>\n\n         <hr/>\n         <span className=\"linkblack\">در صورت تایید اطلاعات، به پایگاه داده منتقل نمایید\n</span>\n         <Button onClick={handleExport} variant=\"contained\"><span className='linkwhite'>ارسال فایل <i className=\"fa fa-download\"></i></span> \n                     </Button>\n     </Card>\n         </Grid>\n\n         </Grid>\n    </Modal.Body>\n    <Modal.Footer>\n      <Button variant=\"secondary\" onClick={handleClose}>\n        <span className='text'>بستن</span>\n      </Button>\n      <Button variant=\"primary\"  onClick={handleExport}>\n       <span className='text'>آپلود</span>\n      </Button>\n    </Modal.Footer>\n  </Modal>\n    )\n}",{"ruleId":"562","replacedBy":"563"},{"ruleId":"564","replacedBy":"565"},{"ruleId":"566","severity":1,"message":"567","line":1,"column":8,"nodeType":"568","messageId":"569","endLine":1,"endColumn":14},{"ruleId":"566","severity":1,"message":"570","line":2,"column":8,"nodeType":"568","messageId":"569","endLine":2,"endColumn":14},{"ruleId":"566","severity":1,"message":"571","line":3,"column":10,"nodeType":"568","messageId":"569","endLine":3,"endColumn":19},{"ruleId":"566","severity":1,"message":"572","line":8,"column":8,"nodeType":"568","messageId":"569","endLine":8,"endColumn":22},{"ruleId":"566","severity":1,"message":"573","line":9,"column":8,"nodeType":"568","messageId":"569","endLine":9,"endColumn":21},{"ruleId":"566","severity":1,"message":"574","line":10,"column":8,"nodeType":"568","messageId":"569","endLine":10,"endColumn":20},{"ruleId":"566","severity":1,"message":"575","line":12,"column":8,"nodeType":"568","messageId":"569","endLine":12,"endColumn":18},{"ruleId":"566","severity":1,"message":"576","line":13,"column":8,"nodeType":"568","messageId":"569","endLine":13,"endColumn":20},{"ruleId":"566","severity":1,"message":"577","line":14,"column":8,"nodeType":"568","messageId":"569","endLine":14,"endColumn":36},{"ruleId":"566","severity":1,"message":"578","line":15,"column":8,"nodeType":"568","messageId":"569","endLine":15,"endColumn":31},{"ruleId":"566","severity":1,"message":"579","line":16,"column":8,"nodeType":"568","messageId":"569","endLine":16,"endC