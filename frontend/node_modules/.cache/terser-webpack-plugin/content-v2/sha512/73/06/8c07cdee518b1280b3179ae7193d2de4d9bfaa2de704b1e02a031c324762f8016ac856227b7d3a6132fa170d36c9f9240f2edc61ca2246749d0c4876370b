 } else {\n            dispatch(updateUserProfileAction({\n                'id': user._id,\n                'name': name,\n                'email': email,\n                'password': password\n            }))\n            setMessage('')\n            setPassword('')\n            setConfirmPassword('')\n            setSuccessUpdate('Profile successfully updated !')\n        }\n    }\n    return (\n        <Row>\n            <Col md={3}>\n                <h2>my profile</h2>\n                {\n                    loading ? <Loader />\n                        : error ? <Message variant='danger' text={error} />\n                            : message ? <Message variant='danger' text={message} />\n                                : successUpdate ? <Message variant='success' text={successUpdate} />\n                                    : <></>\n                }\n                <Form onSubmit={submitHandler}>\n                    <Form.Group controlId='name'>\n                        <Form.Label>FullName</Form.Label>\n                        <Form.Control\n                            type='text'\n                            placeholder='Enter FullName'\n                            value={name}\n                            onChange={(e) => setName(e.target.value)}\n                        ></Form.Control>\n                    </Form.Group>\n\n                    <Form.Group className='mt-4' controlId='email'>\n                        <Form.Label>Email Address</Form.Label>\n                        <Form.Control\n                            type='email'\n                            placeholder='Enter Email'\n                            value={email}\n                            onChange={(e) => setEmail(e.target.value)}\n                        ></Form.Control>\n                    </Form.Group>\n\n                    <Form.Group className='mt-4' controlId='password'>\n                        <Form.Label>Password</Form.Label>\n                        <Form.Control\n           